# syntax=docker/dockerfile:1-labs
# Production Dockerfile for Web App - BUILD-TIME COMPILATION
# This version builds the Next.js app during Docker build phase
# Recommended for: Render, Vercel, and platforms that scan for open ports during build
# Multi-stage build optimized for caching:
# base -> pruner-json -> pruner-full -> installer -> builder -> runner
#
# The pruner is split in two stages: pruner-json handles only manifests
# (super-stable cache) and pruner-full bind-mounts sources to produce out/full/.

# ===================================
# Stage 1: Base - Install global dependencies and set environment
# ===================================
FROM oven/bun:1.4.3-alpine AS base
ENV NODE_ENV=production

# ── BUILDKIT CACHE MOUNTS BREAK `install.globalStore` — TURN IT OFF ──────────
# `bunfig.toml` sets `globalStore = true`, which points every
# `node_modules/.bun/<pkg>` at an absolute path UNDER the bun cache mount used
# below. A BuildKit cache mount is not committed to the image layer, so those
# links would ship without their targets and every runtime import would fail
# with ENOENT. Measured in a built image: with the store on, `test -d
# node_modules/.bun/zod@4.6.7` is false. The env var overrides bunfig.toml.
# Full reasoning: AGENTS.md → "One bun download cache".
ENV BUN_INSTALL_GLOBAL_STORE=0

# Set build-time environment variables for Next.js
ARG API_URL=http://localhost:3001
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG API_PORT=3001
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_PORT=3000
ARG NEXT_PUBLIC_DOC_URL=http://localhost:3020
ARG NEXT_PUBLIC_DOC_PORT=3020
ARG AUTH_SECRET=QgafJQw3O/k1gambz7YGKjtj5ZZe0dnL/WlSw4PtMDc=

ENV API_URL=$API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_PORT=$API_PORT
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_PORT=$NEXT_PUBLIC_APP_PORT
ENV NEXT_PUBLIC_DOC_URL=$NEXT_PUBLIC_DOC_URL
ENV NEXT_PUBLIC_DOC_PORT=$NEXT_PUBLIC_DOC_PORT
ENV AUTH_SECRET=$AUTH_SECRET

# Install system dependencies
# jq is needed to parse package.json exports in runner stage
RUN apk add --no-cache libc6-compat dumb-init tar jq

# Install global tools with cache mount
# The explicit `id` matters because the cache id DEFAULTS TO THE MOUNT TARGET:
# a different target would be a second download cache instead of the one shared
# with every other Dockerfile here. See AGENTS.md → "One bun download cache".
RUN --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    bun install -g turbo@^2 node-gyp
WORKDIR /app

# ===================================
# Stage 2a: pruner-json — manifests only (very stable cache)
# ===================================
FROM base AS pruner-json
WORKDIR /app

# Root manifests (rarely change)
COPY turbo.json package.json ./
COPY bun.lock* ./
# All package.json files across the monorepo (preserves directory structure)
COPY --parents **/package.json ./

# `@deployer/web`, NOT `web`: the scope is a WORKSPACE PACKAGE NAME, and every
# application here is scoped. `turbo prune web` fails with
# "Invalid scope. Package with name web in `package.json` not found."
RUN --mount=type=cache,target=/root/.cache/turbo \
  turbo prune @deployer/web --docker

# ===================================
# Stage 2b: pruner-full — sources via bind mount
# ===================================
FROM base AS pruner-full
WORKDIR /app

COPY --from=pruner-json /app/out/json/ ./

RUN --mount=type=bind,target=/src \
  --mount=type=cache,target=/root/.cache/turbo \
  cp /src/turbo.json . && \
  cp /src/bun.lock* . 2>/dev/null || true ; \
  tar -C /src -cf - apps packages tooling 2>/dev/null | tar -xf - 2>/dev/null || true ; \
  turbo prune @deployer/web --docker && \
  # THE PRUNING TURBO IS NOT THE BUILDING TURBO — see AGENTS.md, "The pruning
  # turbo writes the turbo.json the build parses". `turbo prune` re-serialises
  # turbo.json from ITS OWN version, and this stage runs the `turbo@^2` global
  # install while the build runs the LOCKFILE-PINNED turbo from node_modules.
  # A newer prune writes futureFlags an older build rejects outright, and drops
  # `remoteCache` that the `--remote-only` build below requires.
  cp /app/turbo.json /app/out/full/turbo.json

# ===================================
# Stage 3: Installer - Install dependencies for pruned workspaces only
# ===================================
FROM base AS installer
WORKDIR /app

# Install build tools (python3/make/g++/musl-dev) required by bun ci to
# extract optional native dependencies like ssh2 -> cpu-features.
# Without these, optional deps are installed as empty stub directories
# (Bun does not run native postinstall scripts on Alpine without them).
# BuildKit cache mount keeps the apk package cache across builds.
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache python3 make g++ gcc musl-dev

# Install build tools needed for native dependencies
RUN apk add --no-cache python3 make g++ gcc musl-dev

# Copy ONLY the pruned package.json structure (not all workspaces)
# out/json/ contains a consistent pruned bun.lock — use that one.
COPY --from=pruner-json /app/out/json/ .

# ── ORIGINAL LOCKFILE, NOT THE PRUNED ONE ─────────────────────────────────
# `turbo prune` rewrites bun.lock and HOISTS packages that were nested, losing
# their resolutions. Measured on `api`: it hoists `log-symbols@4.1.0` to a bare
# entry but drops the `is-unicode-supported@^0.1.0` it needs, so that resolves
# to the ESM-only 2.1.0 while `log-symbols` is CJS. The build then dies with:
#
#   TypeError: isUnicodeSupported is not a function.
#   (In 'isUnicodeSupported()', 'isUnicodeSupported' is an instance of Module)
#
# The ORIGINAL lockfile keeps the correct tree and `bun ci` accepts it against
# the pruned manifests (verified). turborepo#10783 / #11074 class of corruption.
# NOT a `|| bun install` fallback: `bun ci` SUCCEEDS on the corrupt file, so the
# fallback never fires and the wrong tree installs silently.
COPY --from=pruner-full /app/bun.lock ./bun.lock

# ── WHY THE ROOT `scripts/` DIRECTORY ───────────────────────────────────────
# `bun ci` runs the root `postinstall`,
# `scripts/link-workspace-self-references.ts`, which creates the
# `node_modules/<own-name> -> ../..` self-link that `bun install` never makes.
# `turbo prune` keeps only what the pruned TARGET needs and a root script is not
# one of its dependencies, so without this COPY the install dies with
# `Module not found "scripts/link-workspace-self-references.ts"`.
COPY scripts ./scripts

RUN --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
  bun ci

# ===================================
# Stage 4: Builder - Build the application (generate + build)
# ===================================
FROM base AS builder
WORKDIR /app

# Install build tools needed for native dependencies
RUN apk add --no-cache python3 make g++ gcc musl-dev

# Pruned source from pruner-full (out/full/) — local image-to-image COPY
# out/full/ contains the pruned bun.lock at the root (consistent).
COPY --from=pruner-full /app/out/full/ .
# Copy the pruned bun.lock (from out/json/) so turbo can parse workspace
# info. out/full/ doesn't include a bun.lock at the root.
COPY --from=pruner-full /app/bun.lock ./bun.lock

# Ensure routes directory exists and is writable for generate command
RUN mkdir -p /app/apps/web/routes && chmod -R 755 /app/apps/web/routes

# Copy node_modules from installer — single-tar pattern
# (one tar -cf + one tar -xf, no find/subshell loops, excludes *.map/.cache/.turbo)
#
# IMPORTANT: `cd /mnt/installer` MUST happen BEFORE the globs are expanded.
# The globs `apps/*/node_modules` etc. are expanded by the shell relative to
# the current working directory. If they run from /app (the runner's dir), they
# only match node_modules dirs that already exist in the pruned source — and
# apps/<app>/node_modules is NOT part of the source, so it would be silently
# skipped and never copied, breaking module resolution at runtime.
RUN --mount=type=bind,from=installer,source=/app,target=/mnt/installer \
    cd /mnt/installer && \
    # Depth-agnostic discovery — see AGENTS.md, "Discover node_modules with
    # find, never a glob list".
    PATHS="node_modules $(find apps packages tooling -type d -name node_modules -prune -print | tr '\n' ' ')"; \
    # cp -a merges into existing dirs (nested workspaces may appear in several
    # PATHS entries); tar -xf would abort on such overlaps.
    for d in $PATHS; do \
        mkdir -p "/app/$d"; \
        # Fast path: merge. On conflict (pre-created dirs from other copy
        # passes), wipe this workspace's node_modules and clean-copy — the
        # builder tree is always the authoritative dependency set.
        cp -a "/mnt/installer/$d/." "/app/$d/" 2>/dev/null || { \
            rm -rf "/app/$d"; \
            mkdir -p "/app/$d"; \
            cp -a "/mnt/installer/$d/." "/app/$d/"; \
        }; \
    done

# Copy turbo cache directories (workspace-level only; root /.turbo doesn't exist)
COPY --parents --chmod=a+w **/.turbo/ ./

# Build declarative-routing CLI first (required by web's generate task)
RUN --mount=type=cache,id=deployer-turbo-cache,target=/turbo-cache,sharing=shared \
    --mount=type=secret,id=turbo_token,env=TURBO_TOKEN,required=false \
    --mount=type=secret,id=turbo_team,env=TURBO_TEAM,required=false \
    --mount=type=secret,id=turbo_api,env=TURBO_API,required=false \
    --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/tmp/turbo-restore,id=turbo-web-prod-cli,sharing=locked \
    set -eux; \
    if [ -d /tmp/turbo-restore/wt ]; then \
      cp -an /tmp/turbo-restore/wt/. /app/ 2>/dev/null || true; \
    fi; \
    bunx turbo run build --cache-dir=/turbo-cache --filter=@deployer/cli-declarative-routing; \
    rm -rf /tmp/turbo-restore/wt; \
    mkdir -p /tmp/turbo-restore/wt; \
    cd /app; \
    find . -path ./node_modules -prune -o -name .turbo -type d -print0 | \
      while IFS= read -r -d '' d; do \
        parent=$(dirname "$d"); \
        mkdir -p "/tmp/turbo-restore/wt/$parent"; \
        cp -r "$d" "/tmp/turbo-restore/wt/$parent/"; \
      done

# Generate routes
RUN --mount=type=cache,id=deployer-turbo-cache,target=/turbo-cache,sharing=shared \
    --mount=type=secret,id=turbo_token,env=TURBO_TOKEN,required=false \
    --mount=type=secret,id=turbo_team,env=TURBO_TEAM,required=false \
    --mount=type=secret,id=turbo_api,env=TURBO_API,required=false \
    --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/tmp/turbo-restore,id=turbo-web-prod-generate,sharing=locked \
    set -eux; \
    if [ -d /tmp/turbo-restore/wt ]; then \
      cp -an /tmp/turbo-restore/wt/. /app/ 2>/dev/null || true; \
    fi; \
    bunx turbo run generate --cache-dir=/turbo-cache --filter=@deployer/web...; \
    rm -rf /tmp/turbo-restore/wt; \
    mkdir -p /tmp/turbo-restore/wt; \
    cd /app; \
    find . -path ./node_modules -prune -o -name .turbo -type d -print0 | \
      while IFS= read -r -d '' d; do \
        parent=$(dirname "$d"); \
        mkdir -p "/tmp/turbo-restore/wt/$parent"; \
        cp -r "$d" "/tmp/turbo-restore/wt/$parent/"; \
      done

# Build the web app
# The `.next/cache` mount is what makes `turbopackFileSystemCacheForBuild` pay
# off here: without it, each `docker build` starts from a clean layer and the
# build cache is written into a layer that is discarded. With it, Turbopack's
# cache survives between builds. `sharing=locked` keeps concurrent builds from
# corrupting the same cache.
RUN --mount=type=cache,id=deployer-turbo-cache,target=/turbo-cache,sharing=shared \
    --mount=type=secret,id=turbo_token,env=TURBO_TOKEN,required=false \
    --mount=type=secret,id=turbo_team,env=TURBO_TEAM,required=false \
    --mount=type=secret,id=turbo_api,env=TURBO_API,required=false \
    --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/app/apps/web/.next/cache,sharing=locked,id=turbopack-web-prod-build \
    --mount=type=cache,target=/tmp/turbo-restore,id=turbo-web-prod-build,sharing=locked \
    set -eux; \
    if [ -d /tmp/turbo-restore/wt ]; then \
      cp -an /tmp/turbo-restore/wt/. /app/ 2>/dev/null || true; \
    fi; \
    bunx turbo run build --cache-dir=/turbo-cache --filter=@deployer/web...; \
    rm -rf /tmp/turbo-restore/wt; \
    mkdir -p /tmp/turbo-restore/wt; \
    cd /app; \
    find . -path ./node_modules -prune -o -name .turbo -type d -print0 | \
      while IFS= read -r -d '' d; do \
        parent=$(dirname "$d"); \
        mkdir -p "/tmp/turbo-restore/wt/$parent"; \
        cp -r "$d" "/tmp/turbo-restore/wt/$parent/"; \
      done

# ── PRUNE devDependencies HERE, WHERE THE TREE IS COMPLETE ──────────────────
# MUST run in the builder: the runtime receives each workspace's `node_modules`
# by having it COPIED out of this stage, so pruning here is what makes the
# runtime image smaller. The same work in the runner is impossible — it never
# receives `bun.lock`, the `tooling/*` manifests, or `scripts/`, and the
# install that used to sit there died with
# `error: Workspace not found "tooling/eslint"` (x7, measured).
#
# `bun prune` and NOT `rm -rf node_modules && bun install --production`: same
# final tree (1462 MB, verified), but 0.9s against 18s, and purely local
# (verified with `--network=none`). `bun pm prune` is a different, non-existent
# command — `bun prune` is top-level.
#
# ── WHY `scripts/` IS STILL NEEDED, AND WHY THE RE-LINK IS NOT OPTIONAL ────
# The root `postinstall` is `scripts/link-workspace-self-references.ts`, and
# `turbo prune` does not bring it: a root script is not a dependency of any
# workspace, so the pruner drops it.
#
# The installer already needs it for the install-time postinstall. Here the
# reason is narrower: **`bun prune` DELETES the self-links it created**, because
# `node_modules/<own-name> -> ../..` is not an entry in `bun.lock`. Measured:
# present before the prune, ABSENT after. So the prune must be followed by an
# explicit re-link, or node fails to load any dist barrel that re-imports its
# own package by name.
COPY scripts ./scripts
RUN bun prune --production && \
    bun --bun run scripts/link-workspace-self-references.ts

# ===================================
# Stage 6: Runner - Production runtime
# ===================================
FROM base AS runner
WORKDIR /app

# Install Node.js and create user in single layer (no build tools in production)
RUN apk add --no-cache nodejs coreutils && \
    ln -sf $(which bun) /usr/local/bin/npm && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
ENV PATH="/usr/bin:${PATH}"

# Copy only what's needed to run Next.js using bind mount + tar approach
# Uses jq to parse package.json exports and copy only required directories
RUN --mount=type=bind,from=builder,source=/app,target=/mnt/builder \
    # Copy root workspace files
    cp /mnt/builder/package.json /mnt/builder/turbo.json /app/ && \
    # Copy built web app (.next + public + package.json + next.config.ts)
    mkdir -p /app/apps/web && \
    cp -r /mnt/builder/apps/web/.next /app/apps/web/ && \
    cp -r /mnt/builder/apps/web/public /app/apps/web/ && \
    cp /mnt/builder/apps/web/package.json /app/apps/web/ && \
    cp /mnt/builder/apps/web/next.config.ts /app/apps/web/ && \
    # Copy packages based on their package.json exports field
    # This parses exports to find which directories (src, dist, etc.) are actually needed
    for pkgJson in /mnt/builder/packages/*/package.json /mnt/builder/packages/*/*/package.json /mnt/builder/packages/*/*/*/package.json /mnt/builder/packages/*/*/*/*/package.json; do \
        if [ -f "$pkgJson" ]; then \
            pkgDir=$(dirname "$pkgJson"); \
            relPkgDir=$(echo "$pkgDir" | sed 's|/mnt/builder/||'); \
            mkdir -p "/app/$relPkgDir"; \
            cp "$pkgJson" "/app/$relPkgDir/"; \
            exportDirs=$(jq -r '.exports // {} | if type == "string" then . elif type == "object" then [.. | strings] | .[] else empty end' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            mainDirs=$(jq -r '[.main, .module, .types] | .[] // empty' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            allDirs=$(printf '%s\n%s' "$exportDirs" "$mainDirs" | grep -v '^$' | sort -u); \
            for dir in $allDirs; do \
                # Wildcard exports (./*) must never drag node_modules into
                # the runtime tree — deps arrive via the PATHS copy below.
                [ "$dir" = "node_modules" ] && continue; \
                if [ -d "$pkgDir/$dir" ]; then \
                    cp -r "$pkgDir/$dir" "/app/$relPkgDir/"; \
                elif [ -f "$pkgDir/$dir" ]; then \
                    cp "$pkgDir/$dir" "/app/$relPkgDir/"; \
                fi; \
            done; \
            [ -f "$pkgDir/tsconfig.json" ] && cp "$pkgDir/tsconfig.json" "/app/$relPkgDir/" || true; \
        fi; \
    done && \
    # Single-tar pattern for all node_modules (root + apps + packages)
    # Preserves symlinks via tar; excludes *.map/.cache/.turbo noise
    # Build the path list first so we use ONE tar -cf (concatenated multi-tar
    # streams lose per-package symlinks during extraction)
    # IMPORTANT: `cd /mnt/builder` MUST happen BEFORE the globs are expanded.
    # The globs `apps/*/node_modules` etc. are expanded by the shell relative to
    # the current working directory. If they run from /app (the runner's dir),
    # they only match node_modules dirs that already exist in the pruned source
    # — and apps/<app>/node_modules is NOT part of the source, so it would be
    # silently skipped and never copied, breaking module resolution at runtime.
    cd /mnt/builder && \
    PATHS="node_modules $(find apps packages tooling -type d -name node_modules -prune -print | tr '\n' ' ')"; \
    # cp -a merges into existing dirs (nested workspaces may appear in several
    # PATHS entries); tar -xf would abort on such overlaps.
    for d in $PATHS; do \
        mkdir -p "/app/$d"; \
        cp -a "/mnt/builder/$d/." "/app/$d/" 2>/dev/null || { \
            rm -rf "/app/$d"; \
            mkdir -p "/app/$d"; \
            cp -a "/mnt/builder/$d/." "/app/$d/"; \
        }; \
    done && \
    # Set ownership for all copied files
    chown -R nextjs:nodejs /app && \
    # The build above writes `.next/cache` through a BuildKit cache mount, which
    # is deliberately NOT committed to the image layer. The runtime still needs
    # a writable `.next/cache` for the incremental (ISR/fetch) cache, so recreate
    # it empty and owned by the runtime user.
    mkdir -p /app/apps/web/.next/cache && \
    chown -R nextjs:nodejs /app/apps/web/.next

# devDependencies were already dropped in the BUILDER stage (see the prune
# there). Nothing to re-install here: the runner does not even have `bun.lock`
# or the `tooling/*` manifests this install would need, which is why the
# install that used to sit here failed with `Workspace not found`.

# Switch to nextjs user
USER nextjs

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${NEXT_PUBLIC_APP_PORT}

# Health check for deployment platforms
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider ${NEXT_PUBLIC_APP_URL} || exit 1

WORKDIR /app
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "bun run --cwd=apps/web start"]
