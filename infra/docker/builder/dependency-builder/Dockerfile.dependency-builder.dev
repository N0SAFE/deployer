# syntax=docker/dockerfile:1-labs
#
# dependency-builder — the only process that builds internal workspace packages
# in the `dev-dependency-builder` profile.
#
# ── Why this image carries the FULL workspace, not a pruned one ──────────────
#
# Every other dev image prunes to one application: `turbo prune api` gives the API
# exactly what the API needs, and nothing else belongs in that container.
#
# This image is the operator, not a consumer. It computes the union of the
# enabled applications' dependencies AT RUNTIME, from the manifests on disk, then
# builds that union through a single Turbo graph. It therefore needs every
# workspace present — pruning to any one application would remove exactly the
# manifests the union is computed from.
#
# The applications' own prune volumes are NOT mounted here: which applications
# are enabled is passed on the command line by compose, which is the one place
# that knows.
#
# Sources are synced in by `develop.watch` rather than bind-mounted; see the
# compose service for why a bind mount cannot work.

ARG BUN_VERSION=1.4.4

FROM oven/bun:${BUN_VERSION}-alpine AS base

# ── BUILDKIT CACHE MOUNTS BREAK `install.globalStore` — TURN IT OFF ──────────
# `bunfig.toml` sets `globalStore = true`, which points every
# `node_modules/.bun/<pkg>` at an absolute path UNDER the bun cache mount used
# below. A BuildKit cache mount is not committed to the image layer, so those
# links would ship without their targets and every import in the container would
# fail with ENOENT. Measured in a built image: with the store on, `test -d
# node_modules/.bun/zod@4.6.7` is false. The env var overrides bunfig.toml.
# Full reasoning: AGENTS.md → "One bun download cache".
ENV BUN_INSTALL_GLOBAL_STORE=0

RUN apk add --no-cache curl wget bash git python3 make g++ gcc musl-dev tar libc6-compat jq

# Node is kept available: Turbo's CLI wrapper is a Node script, and the tool
# spawns it through Bun because the native `@turbo/<platform>` binary is not
# hoisted under Bun's isolated linker.
COPY --from=node:22-alpine /usr/local /usr/local

RUN ln -sf /usr/local/bin/node /usr/bin/node && \
    ln -sf /usr/local/bin/npm /usr/bin/npm && \
    ln -sf /usr/local/bin/npx /usr/bin/npx

# No global `turbo`: the tool runs the repository's OWN Turbo from node_modules,
# so the version it uses is the version the repository pins. A global install
# would silently drift from it.
# ── `sharing=shared`, NOT `locked` ──────────────────────────────────────────
# `locked` holds an exclusive lock on the bun cache for the WHOLE RUN, so this
# image serialized against every other image build sharing the cache — the
# dependency-builder could not install while an application was installing.
# Bun's cache is content-addressed and written atomically, so several installs
# share one safely.
#
# Contrast with the turbo cache mount below, which stays `locked`: that one is
# a private per-build cache whose contents are mutated in place.
#
# ── WHY THE TARGET IS THE CACHE SUBDIR AND THE `id` IS EXPLICIT ─────────────
# Mounting the WHOLE `/root/.bun` hides what the install just wrote: bun's global
# bin dir is `/root/.bun/install/global` and `/usr/local/bin/<tool>` is a symlink
# into it, so with the mount on the parent the symlink dangles (measured).
# The `id` is explicit because the cache id DEFAULTS TO THE MOUNT TARGET, and a
# different target is a different cache: one explicit id is what lets this image
# and the application images share a single download cache.
RUN --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    bun install -g node-gyp

WORKDIR /app

# ── The env the build is hashed WITH, so the runtime can reuse the cache ────
#
# `turbo.json` lists `NODE_ENV` and `LOG_LEVEL` in `globalEnv`, so BOTH feed every
# task's cache key. The compose service sets `NODE_ENV=development` and
# `LOG_LEVEL=debug`; building here WITHOUT them produced a different hash for the
# same package, and every runtime lookup missed:
#
#   @deployer/type-guards:build: cache miss, executing 8e8ad2152680e352   <- image
#   @deployer/type-guards:build: cache miss, executing 03d9cabe0b8c28c4   <- runtime
#
# Measured on the running stack: 38 of 38 tasks missed, so the cache this image
# bakes was never read. These values MUST match the compose service's
# `environment:` block — that is the whole reason they are set here rather than
# left to the build's ambient environment.
#
# `NODE_ENV=development` is also the CORRECT build mode for a dev stack, and
# `pkg-build` reads it to choose the JSX variant, so this is not merely a
# cache-key coincidence.
ENV NODE_ENV=development \
    LOG_LEVEL=debug

# ── The workspace, in TWO layers: manifests, then sources ────────────────────
#
# ── WHY THE SPLIT ───────────────────────────────────────────────────────────
# `bun install` reads manifests and the lockfile and nothing else. With the
# sources copied first, ANY edit under `packages/` invalidated the COPY that
# preceded the install, so every source edit paid a full reinstall — measured
# `bun install --frozen-lockfile` at 41 s in this image.
#
# Manifests first means the install layer survives every source edit; only the
# small source COPYs and the bake below re-run. `COPY --parents` is what keeps
# the directory structure that `bun install` needs (a workspace is a path).
#
# `bunfig.toml` is part of the install layer because it IS install policy:
# `linker`, `globalStore` and `prefere = "offline"`. Leaving it out installed the
# image with bun's defaults while the host used the repository's.
COPY package.json bun.lock* turbo.json bunfig.toml .gitignore ./
COPY --parents apps/**/package.json packages/**/package.json tooling/**/package.json ./
# The root `postinstall` (`scripts/link-workspace-self-references.ts`) runs during
# `bun install` below. It is not a dependency of anything, so nothing else brings it
# in, and without it the install dies with
# `Module not found "scripts/link-workspace-self-references.ts"`.
COPY scripts ./scripts
# `apps/doc`'s OWN postinstall is `fumadocs-mdx`, which reads this file. It is the
# one workspace whose install needs a source file; `bun install` runs workspace
# postinstalls, so it must be here and not in the source COPY below.
COPY apps/doc/source.config.ts ./apps/doc/source.config.ts
# ── `pkg-build`'s LAUNCHER, BECAUSE BUN ONLY LINKS BINS THAT EXIST ──────────
# Every `@deployer/config-*` package's `build` script is `bun --bun pkg-build`.
# Bun creates `node_modules/.bin/<bin>` only when the target file is on disk, and
# in a manifest-only tree `tooling/bin-pkg-build/bin/pkg-build.mjs` is absent —
# so the link was never created and the bake died with:
#
#   @deployer/config-vitest:build: error: Script not found "pkg-build"
#
# This copies the COMMITTED launcher (not `dist/`) and nothing else; the package
# is still built by the bake, in dependency order, from the source COPY below.
COPY tooling/bin-pkg-build/bin ./tooling/bin-pkg-build/bin

# `patchedDependencies` in the root package.json: bun refuses to install when
# the patch file it names is not in the build context.
COPY patches ./patches
RUN --mount=type=cache,id=deployer-bun-downloads,target=/root/.bun/install/cache,sharing=shared \
    --mount=type=cache,target=/root/.cache,sharing=shared \
    bun install --frozen-lockfile

# ── Scope the workspace graph BEFORE anything else, exactly as the runtime does ─
# `TurboRunner.excludeApplicationsFromGraph` strips `apps/**` at container start;
# this runs the same function, so the cache baked below is keyed to the graph the
# runtime resolves. Without it the bake is unreachable and every boot recompiles.
#
# It reads the root manifest ONLY, so it sits above the source COPYs: below them
# it would re-run on every source edit for no reason. The install above still
# sees the full workspace list, which is what it needs.
#
# Its own two files are copied here because the tool itself arrives with
# `COPY tooling` further down; the copy below replaces them with the same bytes.
COPY --parents tooling/dependency-builder/src/strip-applications.ts tooling/dependency-builder/src/services/graph-scope.ts ./

RUN bun --bun tooling/dependency-builder/src/strip-applications.ts /app

# ── Sources ────────────────────────────────────────────────────────────────
# `turbo run build` reads them, and the runtime needs a real tree for a plain
# `up -d` (no `--watch`, so no sync). `dist/` is excluded by .dockerignore, so
# this never drags in stale build output from the host.
#
# `apps/` IS needed here for TWO reasons: the image-wide build below would
# otherwise have nothing to filter OUT (its `--filter=!./apps/**` names them),
# and the runtime's union planner walks each application's `package.json` to
# compute its dependency closure — so without the app trees it cannot answer
# "what does `web` need".
#
# The applications are kept OUT of this image's build by BOTH the manifest strip
# above and the filter below. The strip is the structural lever (Turbo hashes the
# resolved graph); the filter is what keeps an unfiltered `turbo run build` from
# building `build` in the four applications, which fails here:

#   web:build: error: Unexpected while resolving package 'handlebars'
#   web#build:  ERROR  command (/app/apps/web) ... exited (1)

COPY apps ./apps
COPY packages ./packages
# `tooling/` holds this tool AND the shared config packages (`@deployer/pkg-build`,
# `@deployer/eslint`, ...) its build depends on. Copying it wholesale is what makes
# the tool's own imports resolvable.
COPY tooling ./tooling

# ── A GIT BASELINE, SO TURBO HASHES WHAT GIT TRACKS AND NOTHING ELSE ─────────
# Without a repository Turbo falls back to walking the filesystem, so
# `$TURBO_DEFAULT$` hashes every file in a package, including the ones
# `.gitignore` excludes. Measured on `@deployer/errors`: `.eslintcache` and
# `.pkg-build-types.<pid>.tsconfig.json` were hash inputs, and the second is a
# per-process temp file, so the hash changed on every build and the cache never
# hit (317 misses for 52 packages across one run, 0 of 52 cached at start).
#
# With this repository the same dry run lists only the sources, and the hash does
# not move when an ignored file appears. `.gitignore` (root and nested) is the only
# policy: no `inputs` deny rules in `turbo.json`. Commit AFTER the manifest strip
# above, so `package.json` is not a perceived modification.
RUN git init -q && git add -A && \
    git -c user.name=dependency-builder -c user.email=dependency-builder@localhost commit -q -m baseline

# ── Build EVERY internal package, and keep the cache ─────────────────────────
#
# Every internal package is built HERE, into the image, and Turbo's cache is
# written to `/opt/turbo-cache` — the path `cacheDirFor()` prefers at runtime.
#
# ── THE MANIFEST IS STRIPPED FIRST, SO THE BAKE AND THE WATCH AGREE ─────────
# At runtime `TurboRunner.excludeApplicationsFromGraph` removes `apps/**` from
# `workspaces.packages` before the first Turbo process. Turbo hashes the
# resolved task graph, so a bake taken with a DIFFERENT workspace list is a
# cache the runtime can never hit — the stack pays for a full build at every
# boot and the cache in this image is dead weight.
#
# `strip-applications.ts` runs the SAME function here, before the bake:
#
#     image bake : packages + tooling   (no applications)
#     watch      : packages + tooling   (no applications)
#
# Discovery is unaffected: `WorkspaceScanner` treats the conventional trees as
# always-scanned, so the applications stay discoverable from `COMPOSE_PROFILES`
# even though this manifest no longer lists them.
#
# The applications are ALSO kept out of the task selection below, because an
# unfiltered `turbo run build` builds `build` in every workspace, including the
# four applications, whose builds fail here:
#
#   web:build: error: Unexpected while resolving package 'handlebars'
#   web#build:  ERROR  command (/app/apps/web) ... exited (1)
#
# `--filter='!./apps/**'` scopes the tasks; the manifest strip is the structural
# lever, and the two now cannot drift apart.
#
# ── WHY THE ARTIFACTS MATTER MORE THAN THE CACHE ────────────────────────────
# The runtime container does not need to rebuild anything: it ADOPTS these
# `dist/` trees into the shared volume and opens the gate, so the operator's
# first `compose up` publishes work the image already finished.
#
# The cache is the safety net for when that is not enough — a partial volume, a
# package added after the image was built, a host run. In those cases the runtime
# build hits these entries instead of recompiling from scratch.
#
# ── THE SYNCED TREE MAY NOT BE THE BAKED ONE ────────────────────────────────
# `develop.watch` replaces `/app` with the HOST tree on `up --watch`, so the
# inputs a runtime build sees are whatever the host holds. They match this image
# unless a source file changed since it was built, and only the packages holding
# such a file recompile. The one input that would miss EVERY entry at once is
# `.env`, because `turbo.json` hashes it globally — which is why the sync rules
# ignore `**/.env*` and this image stays `.env`-free.
#
# ── WHY THERE IS NO POSITIVE PACKAGE FILTER ─────────────────────────────────
# The union of enabled applications is not known at image-build time (compose
# decides it at runtime), so the image builds the SUPERSET of internal packages.
# A runtime build then hits the cache for whatever the union actually needs.
#
# ── `PKG_BUILD_KEEP_DIST` MUST MATCH THE RUNTIME ────────────────────────────
# The runtime builder spawns Turbo with `PKG_BUILD_KEEP_DIST=1`
# (`TurboRunner.run`), because at that point each package's `dist/` is a SYMLINK
# into the shared output root and a build that dereferenced it would write into
# the package directory instead of the volume every app reads.
#
# Turbo hashes the environment, so a bake WITHOUT this variable produces entries
# the runtime run can never hit. Measured on a real boot: the runtime logged 38
# `cache miss, executing` lines and rebuilt every package — and that rebuild is
# what DETACHED each `dist/` symlink mid-flight, so an application compiling at
# the same time resolved a path that had just been emptied:
#
#   Module not found: Can't resolve '@deployer/type-guards'
#   Path packages/utils/type-guards/dist/esm/index.mjs could not be resolved
#
# Setting it here is safe: nothing has been published yet, so "keep `dist`"
# simply means the packages' own `clean` still governs (`PKG_BUILD_KEEP_DIST`
# only stops pkg-build REMOVING a symlinked `dist`, and at this point `dist/` is
# a real directory the image owns).
#
# `--cache-dir` is explicit rather than the default `.turbo/cache`, because the
# default is not the path `cacheDirFor()` reads. It points OUTSIDE `/app` on
# purpose: `develop.watch` syncs the host tree into `/app`, so a cache under
# there is a cache that sync may remove.
#
# ── WHY THIS BAKE IS REACHABLE AT RUNTIME ───────────────────────────────────
# Turbo will not cache a task whose `outputs` resolve outside the workspace root.
# The runtime repoints each package's `dist/` at the shared output root, so while
# that root was `/dep-output` — a SIBLING of `/app` — every task warned
#
#   WARNING  tar attempts to write outside of directory:
#            /dep-output/packages/@deployer/pkg-build/dist
#
# and NO entry was written (measured: 2 for 38 packages). This cache was then
# unreachable by construction and every boot rebuilt everything.
#
# With the root at `/app/dep-output` the outputs stay inside the tree Turbo is
# allowed to read, so the entries below are writable AND reusable — verified by
# a second run reporting `FULL TURBO`.
#
# ── `--cache-dir` IS NOT PART OF THE TASK HASH, SO THE MOUNT CAN MOVE ───────
# Measured: the same filter with `--cache-dir=/tmp/cacheA` and `/tmp/cacheB`
# produces identical `tasks[].hash` for all 46 tasks, and `globalCacheInputs`
# lists files and env but no cache directory. That is what lets the bake WRITE
# into a BuildKit cache mount (warm across image builds) and then COPY the same
# entries into the layer at the path the runtime reads.
#
# Without this, the bake is cold on every source edit: the source COPY below is
# invalidated, which invalidates every layer after it, and the previous bake's
# `/opt/turbo-cache` lives in the layer being replaced. Measured: 71 s to
# recompile 42 packages instead of replaying them.
RUN --mount=type=cache,id=deployer-turbo-bake,target=/root/.turbo-bake,sharing=locked \
    PKG_BUILD_KEEP_DIST=1 bun x turbo run build --cache-dir=/root/.turbo-bake --filter='!./apps/**' && \
    mkdir -p /opt/turbo-cache && \
    cp -a /root/.turbo-bake/. /opt/turbo-cache/

# The runtime reads `/opt/turbo-cache` (`cacheDirFor()`), so the artifacts the
# bake just replayed and the cache that describes them sit at the same path a
# container start looks at.


# ── Start the builder ────────────────────────────────────────────────────────
#
# Run from the tool's own package directory: Bun resolves `tsconfig.json` from
# `$cwd`, and the decorator flags nest-commander needs are read from there. From
# anywhere else the command decorators throw
# `undefined is not an object (evaluating 'descriptor.value')`.
#
# `--root /app` is where the tool finds the workspace. The enabled applications
# are auto-detected from `COMPOSE_PROFILES` (see `ApplicationDetector`), so
# enabling or disabling an application is a compose edit and never an image
# rebuild.
WORKDIR /app/tooling/dependency-builder

CMD ["bun", "--bun", "src/main.ts", "build", "--root", "/app"]
