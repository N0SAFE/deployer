{
  "name": "@deployer/doc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build --turbopack",
    "compile": "next build --experimental-build-mode=compile --turbopack --debug-prerender",
    "dev": "next dev -p 3020",
    "start": "bun --bun serve.ts",
    "serve": "bun --bun serve.ts",
    "postinstall": "fumadocs-mdx",
    "prettify": "bun fmt .",
    "format": "bun run prettify",
    "format:check": "bun fmt --check .",
    "lint": "bun lint --no-script --type-aware",
    "lint:fix": "bun lint --no-script --fix --type-aware",
    "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
    "type-check": "bun check --no-script"
  },
  "dependencies": {
    "@deployer/type-guards": "*",
    "@tanstack/charts": "catalog:doc",
    "fumadocs-core": "catalog:doc",
    "fumadocs-mdx": "catalog:doc",
    "fumadocs-ui": "catalog:doc",
    "lucide-react": "catalog:ui",
    "mermaid": "^11.12.0",
    "next": "catalog:next",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tw-animate-css": "catalog:ui"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:linting",
    "@deployer/config-eslint": "*",
    "@deployer/config-prettier": "*",
    "@tailwindcss/postcss": "catalog:styling",
    "@types/mdx": "catalog:doc",
    "@types/node": "catalog:build",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "eslint": "catalog:linting",
    "eslint-config-next": "catalog:next",
    "postcss": "catalog:styling",
    "tailwindcss": "catalog:styling",
    "typescript": "catalog:build"
  }
}
