####################################################################################################
# NestJS API Configuration
####################################################################################################

# API Server Configuration
NODE_ENV=development
API_PORT=3001

# ─── Platform ingress / direct-port proxy ───────────────────────────────
# Traefik is the SINGLE entry point (api.deployer.localhost / web.*).
# Services never publish host ports — compose has NO port forwarding.
# DEPLOYER_TRAEFIK_HTTP_PORT=80
# If Traefik FAILS (entry port unavailable), the supervised nginx proxy takes
# over API_PORT + DIRECT_PROXY_WEB_HOST_PORT on the host and forwards to the
# container names over the platform network — close itself on recovery.
# DEPLOYER_DIRECT_PROXY_ENABLED=true
# DIRECT_PROXY_API_TARGET=api-dev
# DIRECT_PROXY_WEB_TARGET=web-dev
# DIRECT_PROXY_WEB_HOST_PORT=3000
# DIRECT_PROXY_CONFIG_VOLUME=deployer-port-proxy-config

# Dev-mode auto-setup — when true:
#   - With SETUP_AUTO_DATABASE_URL env var (SETUP_DATABASE_URL kept as legacy
#     alias): URL is PROBED; unreachable → boot FAILS (no backoff, no
#     local-only fallback — the global DB is mandatory even in dev)
#   - Without SETUP_AUTO_DATABASE_URL: auto-provisions Postgres on demand via
#     dockerode (PostgresContainerService) — no Docker Compose DB needed
# Set to "false" (or unset) to force the normal setup-first flow.
# Default: false (not set)
# SETUP_AUTO=false

# Database Configuration
# DATABASE_URL is NEVER read at runtime. The URL flows through SQLite:
#   SETUP_AUTO_DATABASE_URL env → Phase 0 (SetupDevService) → SQLite node_config
#                                                              → GlobalDatabaseModule
# Set SETUP_AUTO_DATABASE_URL to use an existing Postgres instance with
# auto-setup. The app NEVER boots without a global Postgres database.
# SETUP_AUTO_DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# OAuth config is stored in the app_config database table at runtime.
# Use the admin UI to configure GitHub OAuth client credentials.

# Next.js Frontend Configuration
# Traefik-first: the browser always reaches the API/web through the platform
# ingress (api.deployer.localhost / web.deployer.localhost, entry port 80).
NEXT_PUBLIC_APP_URL=http://web.deployer.localhost
NEXT_PUBLIC_API_URL=http://api.deployer.localhost
