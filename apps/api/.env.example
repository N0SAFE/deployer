####################################################################################################
# NestJS API Configuration
####################################################################################################

# API Server Configuration
NODE_ENV=development
API_PORT=3001

# Dev-mode auto-setup — set to "true" to skip the setup wizard on fresh installs.
# When enabled, a development placeholder config is auto-seeded so the app
# starts without requiring interactive setup. Set to "false" (or unset) to
# re-enforce the normal setup-first flow.
DEV_AUTO_SETUP=true

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id  
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
