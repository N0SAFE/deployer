####################################################################################################
# NestJS API Configuration
####################################################################################################

# API Server Configuration
NODE_ENV=development
API_PORT=3001

# Dev-mode auto-setup — when true:
#   - With SETUP_DATABASE_URL env var: persists URL to SQLite, skip wizard
#   - Without SETUP_DATABASE_URL: auto-provisions Postgres on demand via
#     dockerode (PostgresContainerService) — no Docker Compose DB needed
# Set to "false" (or unset) to force the normal setup-first flow.
# Default: false (not set)
# SETUP_AUTO=false

# Database Configuration
# DATABASE_URL is NEVER read at runtime. The URL flows through SQLite:
#   SETUP_DATABASE_URL env → Phase 0 (SetupDevService) → SQLite node_config
#                                                         → GlobalDatabaseModule
# Set SETUP_DATABASE_URL to use an existing Postgres instance with auto-setup.
# SETUP_DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id  
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
