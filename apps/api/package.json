{
  "name": "api",
  "version": "1.0.0",
  "description": "NestJS API with tRPC, Drizzle ORM, and Better Auth",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun --bun scripts/build.ts",
    "compile": "bun x cross-env COMPILE_MODE=true bun run build",
    "local:build": "bun x @repo/env mock api --command 'bun run build'",
    "local:compile": "bun x @repo/env mock api --command 'bun run compile'",
    "prettify": "prettier . --write --no-error-on-unmatched-pattern",
    "format": "bun run prettify",
    "format:check": "prettier . --check --no-error-on-unmatched-pattern",
    "dev": "dotenv -e .env -- bun --bun scripts/entrypoint.dev.ts",
    "prod": "bun --bun scripts/entrypoint.prod.ts",
    "start": "bun --bun --watch src/main",
    "start:dev": "concurrently --raw --names vite,nest -c cyan,green \"bun run dev:vite\" \"bun --bun --watch src/main\"",
    "start:debug": "bun --bun --inspect-wait --watch src/main",
    "start:prod": "bun --bun dist/main",
    "clean": "rimraf dist",
    "lint": "eslint . --fix --cache --concurrency=auto",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "bun src/cli.ts migrate",
    "db:migrate:prod": "bun dist/cli.js migrate",
    "db:seed": "bun src/cli.ts seed",
    "db:seed:prod": "bun dist/cli.js seed",
    "db:reset": "bun src/cli.ts reset",
    "db:reset:prod": "bun dist/cli.js reset",
    "db:push": "bun run db:global:push && bun run db:local:push",
    "cli": "bun src/cli.ts",
    "tunnel:bootstrap": "bun scripts/cloudflare-tunnel-bootstrap.ts",
    "db:generate": "bun run db:global:generate && bun run db:local:generate",
    "db:studio": "bun run db:global:studio",
    "db:global:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:global:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:global:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:local:generate": "drizzle-kit generate --config=drizzle.config.local.ts",
    "db:local:push": "drizzle-kit push --config=drizzle.config.local.ts",
    "db:local:studio": "drizzle-kit studio --config=drizzle.config.local.ts",
    "auth:generate": "bun x auth@latest generate --config src/auth.ts --output src/config/drizzle/global/schema/auth.ts --yes && bun run db:generate",
    "build:client": "vite build --ssrManifest && cp src/views/index.html dist/api/client/index.html",
    "build:server": "vite build --ssr src/views/entry-server.tsx",
    "dev:vite": "vite",
    "dev:nest": "bun --bun --watch src/main"
  },
  "overrides": {
    "cli-cursor": "^5",
    "inquirer": {
      "chalk": "^4.1.2"
    },
    "ora": {
      "chalk": "^4.1.2"
    },
    "log-symbols": {
      "chalk": "^4.1.2"
    }
  },
  "dependencies": {
    "@nestjs-ssr/react": "^0.3.28",
    "@nestjs/common": "catalog:api:nest",
    "@nestjs/config": "catalog:api:nest",
    "@nestjs/core": "catalog:api:nest",
    "@nestjs/platform-express": "catalog:api:nest",
    "@nestjs/swagger": "catalog:api:nest",
    "@nestjs/websockets": "catalog:api:nest",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@octokit/webhooks-types": "catalog:utils",
    "@orpc/client": "catalog:orpc",
    "@orpc/contract": "catalog:orpc",
    "@orpc/json-schema": "catalog:orpc",
    "@orpc/nest": "catalog:orpc",
    "@orpc/openapi": "catalog:orpc",
    "@orpc/openapi-client": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/shared": "catalog:orpc",
    "@orpc/tanstack-query": "catalog:orpc",
    "@orpc/zod": "catalog:orpc",
    "@repo/api-contracts": "*",
    "@repo/auth": "*",
    "@repo/config-tailwind": "*",
    "@repo/contracts-common": "*",
    "@repo/contracts-entities": "*",
    "@repo/env": "*",
    "@repo/errors": "*",
    "@repo/logger": "*",
    "@repo/nest-events": "*",
    "@repo/nest-lifecycle": "*",
    "@repo/orpc-utils": "*",
    "@repo/provider-schema": "*",
    "@repo/type-guards": "*",
    "@repo/ui": "*",
    "@scalar/nestjs-api-reference": "catalog:api:nest",
    "@tanstack/react-form": "catalog:tanstack",
    "@tanstack/react-query": "catalog:tanstack",
    "@thallesp/nestjs-better-auth": "catalog:auth",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "catalog:testing",
    "bcrypt": "catalog:database",
    "better-auth": "catalog:auth",
    "better-sqlite3": "catalog:database",
    "chalk": "^4.1.2",
    "cloudflare": "^7",
    "dockerode": "^5.0.0",
    "drizzle-kit": "catalog:database",
    "drizzle-orm": "catalog:database",
    "drizzle-zod": "^0.8.3",
    "eslint": "catalog:linting",
    "express": "catalog:api:nest",
    "express-list-routes": "catalog:api:nest",
    "figlet": "^1.11.4",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "catalog:ui",
    "mime-types": "^3.0.2",
    "nanoid": "catalog:database",
    "nest-commander": "catalog:api:nest",
    "nestjs-flub": "catalog:api:nest",
    "openapi-merge": "catalog:api:nest",
    "pg": "catalog:api:nest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "catalog:api:nest",
    "rxjs": "catalog:api:nest",
    "simple-git": "^3.31.1",
    "sonner": "catalog:ui",
    "tailwindcss": "catalog:styling",
    "tar-stream": "^3.1.7",
    "tw-animate-css": "catalog:ui",
