    "@types/bcrypt": "catalog:database",
    "@types/better-sqlite3": "catalog:database",
    "@types/dockerode": "^4.0.1",
    "@types/express": "catalog:api:nest",
    "@types/mime-types": "^3.0.1",
    "@types/node": "catalog:build",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/tar-stream": "^3.1.4",
    "@types/web-push": "^3.6.4",
    "@tailwindcss/postcss": "catalog:styling",
    "bun-types": "^1.3.10",
    "concurrently": "^10.0.5",
    "postcss": "catalog:styling",
    "source-map-support": "catalog:api:nest",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.3",
    "ts-loader": "catalog:api:nest",
    "ts-node": "catalog:api:nest",
    "tsconfig-paths": "catalog:api:nest",
