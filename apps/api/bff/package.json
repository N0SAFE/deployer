{
    "name": "@deployer/bff",
    "version": "1.0.0",
    "description": "The Deployer API's Backend-For-Frontend: the ONLY public HTTP surface. Owns auth/session and SSR views, composes the app contract, and forwards each procedure to the service that owns it.",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "admin:create": "bun --bun src/cli.ts create-default-admin",
        "cli": "bun --bun src/cli.ts",
        "db:migrate": "bun --bun src/cli.ts migrate",
        "db:reset": "bun --bun src/cli.ts reset",
        "db:seed": "bun --bun src/cli.ts seed",
        "dev": "bun --bun --watch src/main.ts",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "openapi:generate": "bun --bun scripts/generate-openapi.ts",
        "prettify": "bun fmt .",
        "start": "bun --bun src/main.ts",
        "startup-check": "bun --bun src/cli.ts node-startup-check",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "bun check --no-script",
        "build": "bun build src/main.ts --target=bun --outdir=dist --packages=external",
        "prod": "bun --bun dist/main.js"
    },
    "dependencies": {
        "@nestjs-ssr/react": "^0.3.28",
        "@nestjs/common": "catalog:api:nest",
        "@nestjs/config": "catalog:api:nest",
        "@nestjs/core": "catalog:api:nest",
        "@nestjs/platform-express": "catalog:api:nest",
        "@nestjs/swagger": "catalog:api:nest",
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc",
        "@orpc/nest": "catalog:orpc",
        "@orpc/openapi": "catalog:orpc",
        "@orpc/server": "catalog:orpc",
        "@orpc/tanstack-query": "catalog:orpc",
        "@orpc/zod": "catalog:orpc",
        "@deployer/shared": "*",
        "@deployer/auth": "*",
        "@deployer/bff-contracts": "*",
        "@deployer/contracts-entities": "*",
        "@deployer/env": "*",
        "@deployer/fleet-contracts": "*",
        "@deployer/health-contracts": "*",
        "@deployer/identity-contracts": "*",
        "@deployer/logger": "*",
        "@deployer/nest-database-core": "*",
        "@deployer/nest-database-local": "*",
        "@deployer/nest-env": "*",
        "@deployer/nest-lifecycle": "*",
        "@deployer/nest-nodes": "*",
        "@deployer/nest-schema": "*",
        "@deployer/nest-service-client": "*",
        "@deployer/nest-supervisor-core": "*",
        "@deployer/orpc-utils": "*",
        "@deployer/project-contracts": "*",
        "@deployer/runtime-contracts": "*",
        "@deployer/ui": "*",
        "@tanstack/react-form": "catalog:tanstack",
        "@tanstack/react-query": "catalog:tanstack",
        "better-auth": "catalog:auth",
        "drizzle-orm": "catalog:database",
        "express": "catalog:api:nest",
        "lucide-react": "catalog:ui",
        "nanoid": "catalog:database",
        "nest-commander": "catalog:api:nest",
        "pg": "catalog:api:nest",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "reflect-metadata": "catalog:api:nest",
        "rxjs": "catalog:api:nest",
        "sonner": "catalog:ui",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@nestjs/testing": "catalog:api:nest",
        "@types/bun": "catalog:build",
        "@types/express": "catalog:api:nest",
        "@types/node": "catalog:build",
        "eslint": "catalog:linting",
        "typescript": "catalog:build",
        "unplugin-swc": "^1.5.9",
        "vitest": "catalog:testing"
    }
}
