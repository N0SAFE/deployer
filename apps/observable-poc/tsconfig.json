{
  "extends": "@repo/config-typescript/config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./*"]
    },
    "target": "ES2017",
    "customConditions": ["react-server"]
  },
  "include": [
    "eslint.config.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules"]
}
