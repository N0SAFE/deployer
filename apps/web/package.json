        "@repo/orpc-utils": "*",
        "@repo/type-guards": "*",
        "@repo/ui": "*",
        "@repo/use-safe-query-param-states-from-zod": "*",
        "@serwist/turbopack": "^10.0.0-preview.14",
        "@tanstack/react-devtools": "catalog:tanstack",
        "@tanstack/react-form": "catalog:tanstack",
        "@tanstack/react-query": "catalog:tanstack",
        "@tanstack/react-query-devtools": "catalog:tanstack",
        "@tanstack/react-table": "catalog:tanstack",
        "@tanstack/react-virtual": "catalog:tanstack",
        "@types/circular-json": "catalog:utils",
        "@xyflow/react": "^12.10.0",
        "better-auth": "catalog:auth",
        "circular-json": "catalog:utils",
        "class-variance-authority": "catalog:ui",
