        "cross-env": "catalog:dev",
        "date-fns": "catalog:utils",
        "date-fns-tz": "catalog:utils",
        "emblor": "^1.4.8",
        "esbuild-wasm": "^0.28.1",
        "exceljs": "catalog:utils",
        "leaflet": "^1.9.4",
        "leaflet-draw": "^1.0.4",
        "leaflet.fullscreen": "^5.3.1",
        "leaflet.markercluster": "^1.5.3",
        "lodash.snakecase": "catalog:utils",
