{
    "extends": "@repo/config-typescript/config/nextjs.json",
    "compilerOptions": {
        "useDefineForClassFields": true,
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "#/*": ["./*"],
            "@api/*": ["../api/src/*"]
        },
        "target": "ES2017",
        // Enable react-server condition for TypeScript to understand conditional exports
        // This matches how Next.js bundler resolves imports in RSC context
        "customConditions": ["react-server"]
    },
    "include": [
        "next-env.d.ts",
        "env.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        "*.config.ts",
        "*.config.mts",
        "*.config.js",
        "*.config.mjs",
        "vitest.setup.ts"
    ],
    "exclude": ["node_modules", ".next", "out", "dist", ".turbo", "coverage", "build", ".swc"]
}
