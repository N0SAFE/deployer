{
    "extends": "@repo/config-typescript/config/nextjs.json",
    "compilerOptions": {
        "useDefineForClassFields": true,
        "incremental": true,
        // Bun globals (Bun.file / Bun.write) are used in server-only modules
        // loaded from instrumentation.ts. @types/bun is installed at the repo
        // root; base.json pins "types": ["node"], so re-declare with bun added.
        "types": ["node", "bun"],
        // The ORPC router types are enormous. With `declaration: true` (inherited
        // from the shared base config), tsgo must serialize them and hits
        // TS7056 ("inferred type exceeds maximum serialization length").
        // The web app is a Next.js app with `noEmit: true` — it never emits
        // declarations, so disable them here (ORPC docs: "Exceeds the maximum
        // length problem" → fix #1: disable `declaration`).
        "declaration": false,
        "declarationMap": false,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "#/*": ["./*"],
            "@api/*": ["../api/src/*"]
        },
        "target": "ES2017",
        // Enable react-server condition for TypeScript to understand conditional exports
        // This matches how Next.js bundler resolves imports in RSC context
        "customConditions": ["react-server"]
    },
    "include": [
        "next-env.d.ts",
        "env.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        "*.config.ts",
        "*.config.mts",
        "*.config.js",
        "*.config.mjs",
        "vitest.setup.unit.ts",
        "vitest.setup.e2e.ts",
        // This app consumes @repo/ui *source* (no build step), so ambient
        // declarations that live beside that source are only visible to a
        // program whose `include` reaches them. `include` above is scoped to
        // this app's own `src/`, so the module declarations must be listed —
        // otherwise `exceljs/dist/exceljs.min.js` has no declaration in this
        // program and type-check fails with TS7016.
        "../../packages/ui/base/src/types/*.d.ts"
    ]
}
