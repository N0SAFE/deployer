{
    "name": "@deployer/shared",
    "version": "1.0.0",
    "description": "Platform core shared by the Deployer API surface and internal to apps/api: auth, database access, supervisors, swarm, mesh, traefik, edge, lifecycle wiring, config. Consumed only by apps/api/**.",
    "private": true,
    "exports": {
        "./core/*": {
            "types": "./src/core/*.ts",
            "import": "./src/core/*.ts",
            "default": "./src/core/*.ts"
        },
        "./config/*": {
            "types": "./src/config/*.ts",
            "import": "./src/config/*.ts",
            "default": "./src/config/*.ts"
        },
        "./server": {
            "types": "./src/server/index.ts",
            "import": "./src/server/index.ts",
            "default": "./src/server/index.ts"
        },
        "./auth": {
            "types": "./src/auth.ts",
            "import": "./src/auth.ts",
            "default": "./src/auth.ts"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache",
        "type-check": "bun --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@nestjs/config": "catalog:api:nest",
        "@nestjs/core": "catalog:api:nest",
        "@nestjs/platform-express": "catalog:api:nest",
        "@nestjs/swagger": "catalog:api:nest",
        "@nestjs/terminus": "catalog:api:nest",
        "@octokit/app": "^16.1.2",
        "@octokit/rest": "^22.0.1",
        "@octokit/webhooks": "^14.2.0",
        "@octokit/webhooks-types": "catalog:utils",
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc",
        "@orpc/json-schema": "catalog:orpc",
        "@orpc/nest": "catalog:orpc",
        "@orpc/openapi": "catalog:orpc",
        "@orpc/server": "catalog:orpc",
        "@orpc/shared": "catalog:orpc",
        "@orpc/zod": "catalog:orpc",
        "@deployer/auth": "*",
        "@deployer/bff-contracts": "*",
        "@deployer/contracts-common": "*",
        "@deployer/contracts-entities": "*",
        "@deployer/env": "*",
        "@deployer/errors": "*",
        "@deployer/fleet-contracts": "*",
        "@deployer/health-contracts": "*",
        "@deployer/identity-contracts": "*",
        "@deployer/logger": "*",
        "@deployer/mesh-network": "*",
        "@deployer/nest-database-core": "*",
        "@deployer/nest-database-local": "*",
        "@deployer/nest-docker": "*",
        "@deployer/nest-env": "*",
        "@deployer/nest-events": "*",
        "@deployer/nest-lifecycle": "*",
        "@deployer/nest-nodes": "*",
        "@deployer/nest-reachability": "*",
        "@deployer/nest-schema": "*",
        "@deployer/nest-supervisor-core": "*",
        "@deployer/nest-swarm": "*",
        "@deployer/orpc-utils": "*",
        "@deployer/project-contracts": "*",
        "@deployer/runtime-contracts": "*",
        "@deployer/type-guards": "*",
        "better-auth": "catalog:auth",
        "dockerode": "catalog:utils",
        "drizzle-orm": "catalog:database",
        "express": "catalog:api:nest",
        "mime-types": "^3.0.2",
        "nanoid": "catalog:database",
        "pg": "catalog:api:nest",
        "reflect-metadata": "catalog:api:nest",
        "rxjs": "catalog:api:nest",
        "simple-git": "^3.31.1",
        "systeminformation": "^5.33.15",
        "tar-stream": "^3.1.7",
        "yaml": "catalog:utils",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@nestjs/testing": "catalog:api:nest",
        "@testcontainers/postgresql": "^12.0.3",
        "@types/bun": "catalog:build",
        "@types/express": "catalog:api:nest",
        "@types/mime-types": "^3.0.1",
        "@types/node": "catalog:build",
        "@types/pg": "^8.23.1",
        "@types/tar-stream": "^3.1.4",
        "eslint": "catalog:linting",
        "supertest": "^7.1.4",
        "testcontainers": "^12.0.3",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
