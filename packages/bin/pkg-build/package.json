{
    "name": "@repo/pkg-build",
    "version": "1.0.0",
    "private": true,
    "description": "Shared configurable workspace package builder. Bundles package sources to ESM/CJS with bun (resolving tsconfig path aliases and emitting NestJS decorator metadata), driven by a `pkgBuild` block in each package.json.",
    "type": "module",
    "bin": {
        "pkg-build": "./index.ts"
    },
    "exports": {
        ".": "./index.ts"
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "type-check": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "chokidar": "catalog:build",
        "picocolors": "catalog:utils"
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
