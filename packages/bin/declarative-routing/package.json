{
    "name": "@repo/cli-declarative-routing",
    "version": "0.1.20",
    "description": "Declarative routes for React (monorepo fork)",
    "bin": {
        "declarative-routing": "dist/index.js"
    },
    "private": true,
    "files": [
        "dist",
        "assets"
    ],
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "prepublish": "bun run build",
        "dev": "bun --bun ../pkg-build/index.ts --watch",
        "build": "bun --bun ../pkg-build/index.ts",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "type-check": "tsc --noEmit",
        "migrate:unified-info-files": "bun --bun migrations/2026-01-01-unified-info-files.migration.ts"
    },
    "keywords": [],
    "author": {
        "name": "Jack Herrington",
        "email": "jherr@pobox.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ProNextJS/declarative-routing"
    },
    "license": "MIT",
    "devDependencies": {
        "@repo/config-prettier": "*",
        "@repo/config-vitest": "*",
        "@types/diff": "catalog:utils",
        "@types/fs-extra": "catalog:utils",
        "@types/prompts": "catalog:utils",
        "@vitest/coverage-v8": "catalog:testing",
        "@vitest/ui": "catalog:testing",
        "type-fest": "catalog:utils",
        "vitest": "catalog:testing",
        "typescript": "catalog:build"
    },
    "dependencies": {
        "@antfu/ni": "catalog:utils",
        "@parcel/watcher": "catalog:build",
        "@repo/type-guards": "*",
        "boxen": "catalog:ui",
        "commander": "catalog:utils",
        "diff": "catalog:utils",
        "execa": "catalog:utils",
        "fs-extra": "catalog:utils",
        "glob": "catalog:utils",
        "handlebars": "catalog:utils",
        "kleur": "catalog:utils",
        "log-symbols": "catalog:utils",
        "magicast": "catalog:utils",
        "ora": "catalog:ui",
        "prompts": "catalog:utils",
        "zod": "catalog:utils"
    },
    "pkgBuild": {
        "root": "src",
        "entries": [
            "index.ts"
        ],
        "formats": [
            "cjs"
        ],
        "flat": true,
        "target": "node",
        "splitting": false,
        "external": [
            "@parcel/watcher"
        ],
        "sourcemap": "external"
    },
    "types": "./src/index.ts",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs"
}
