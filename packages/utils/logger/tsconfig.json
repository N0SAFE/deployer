{
  "extends": "@repo/config-typescript/base",
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "target": "ES2020",
    "paths": {
      "@repo/logger/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "eslint.config.ts"
  ]
}
