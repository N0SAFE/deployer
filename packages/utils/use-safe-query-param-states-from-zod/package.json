{
    "name": "@deployer/use-safe-query-param-states-from-zod",
    "version": "0.1.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./parsers": {
            "types": "./dist/types/parsers.d.ts",
            "import": "./dist/esm/parsers.mjs",
            "require": "./dist/cjs/parsers.js"
        },
        "./defaults": {
            "types": "./dist/types/defaults.d.ts",
            "import": "./dist/esm/defaults.mjs",
            "require": "./dist/cjs/defaults.js"
        },
        "./types": {
            "types": "./dist/types/types.d.ts",
            "import": "./dist/esm/types.mjs",
            "require": "./dist/cjs/types.js"
        }
    },
    "scripts": {
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "test:coverage": "bun --bun vitest run --coverage",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@deployer/type-guards": "*",
        "nuqs": "catalog:web",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@types/node": "catalog:build",
        "@types/react": "catalog:react",
        "@vitest/coverage-v8": "catalog:testing",
        "eslint": "catalog:linting",
        "next": "catalog:next",
        "react": "catalog:react",
        "vitest": "catalog:testing",
        "typescript": "catalog:build",
        "@deployer/pkg-build": "*"
    },
    "peerDependencies": {
        "next": ">=15.0.0",
        "react": ">=19.2.8"
    },
    "module": "./dist/esm/index.mjs"
}
