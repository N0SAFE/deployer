{
    "name": "@repo/use-safe-query-param-states-from-zod",
    "version": "0.1.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./parsers": {
            "types": "./src/parsers.ts",
            "import": "./dist/esm/parsers.mjs",
            "require": "./dist/cjs/parsers.js"
        },
        "./defaults": {
            "types": "./src/defaults.ts",
            "import": "./dist/esm/defaults.mjs",
            "require": "./dist/cjs/defaults.js"
        },
        "./types": {
            "types": "./src/types.ts",
            "import": "./dist/esm/types.mjs",
            "require": "./dist/cjs/types.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@repo/type-guards": "*",
        "nuqs": "catalog:web",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@types/node": "catalog:build",
        "@types/react": "catalog:react",
        "@vitest/coverage-v8": "catalog:testing",
        "eslint": "catalog:linting",
        "next": "catalog:next",
        "react": "catalog:react",
        "vitest": "catalog:testing",
        "typescript": "catalog:build"
    },
    "peerDependencies": {
        "next": ">=15.0.0",
        "react": ">=19.2.8"
    },
    "module": "./dist/esm/index.mjs"
}
