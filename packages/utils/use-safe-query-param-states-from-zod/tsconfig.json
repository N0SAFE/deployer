{
    "extends": "../../../tooling/typescript/config/react-library.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "target": "ES2020",
        "lib": [
            "ES2022",
            "dom",
            "dom.iterable"
        ],
        "paths": {
            "@deployer/use-safe-query-param-states-from-zod/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "pkg-build.config.ts", "src/**/*"
    ]
}
