{
  "name": "@repo/type-guards",
  "version": "1.0.0",
  "description": "Shared TypeScript type guard utilities. Consolidates isRecord, isObjectLike, and other runtime type narrowing predicates used across the monorepo.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prettify": "prettier . --write --no-error-on-unmatched-pattern",
    "format": "bun run prettify",
    "format:check": "prettier . --check --no-error-on-unmatched-pattern",
    "lint": "eslint . --fix",
    "type-check": "tsgo --noEmit"
  },
  "devDependencies": {
    "@repo/config-eslint": "*",
    "@repo/config-prettier": "*",
    "@repo/config-typescript": "*",
    "@types/node": "catalog:build",
    "eslint": "catalog:linting",
    "@typescript/native-preview": "catalog:build"
  }
}
