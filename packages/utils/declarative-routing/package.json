{
    "name": "@repo/declarative-routing",
    "version": "0.1.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./hooks": "./src/hooks.ts",
        "./utils": "./src/utils.ts",
        "./page-wrappers": {
            "react-server": "./src/page-wrappers/server.tsx",
            "default": "./src/page-wrappers/client.tsx"
        },
        "./page-wrappers/server": "./src/page-wrappers/server.tsx",
        "./page-wrappers/client": "./src/page-wrappers/client.tsx",
        "./layout-wrappers": "./src/layout-wrappers/index.ts",
        "./layout-wrappers/server": "./src/layout-wrappers/server.tsx"
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@repo/type-guards": "*",
        "nuqs": "catalog:web",
        "query-string": "catalog:utils",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@repo/auth": "*",
        "@tanstack/react-query": ">=5.0.0",
        "next": ">=16.1.2",
        "nprogress": ">=0.2.0",
        "react": ">=19.2.8"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": true
        },
        "nprogress": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "@repo/auth": "*",
        "@repo/use-safe-query-param-states-from-zod": "*",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@types/nprogress": "catalog:web",
        "@types/react": "catalog:react",
        "eslint": "catalog:linting",
        "server-only": "catalog:utils",
        "typescript": "catalog:build"
    }
}
