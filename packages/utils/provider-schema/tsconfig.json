{
    "extends": "../../../tooling/typescript/config/react-library.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "types": [
            "vitest/globals"
        ],
        "paths": {
            "@deployer/provider-schema/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "pkg-build.config.ts", "src/**/*"
    ]
}
