{
    "name": "@repo/provider-schema",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./domain": {
            "types": "./src/domain/index.ts",
            "import": "./dist/esm/domain/index.mjs",
            "require": "./dist/cjs/domain/index.js"
        },
        "./catalog": {
            "types": "./src/catalog/index.ts",
            "import": "./dist/esm/catalog/index.mjs",
            "require": "./dist/cjs/catalog/index.js"
        },
        "./validation": {
            "types": "./src/validation/index.ts",
            "import": "./dist/esm/validation/index.mjs",
            "require": "./dist/cjs/validation/index.js"
        }
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@repo/type-guards": "*",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@repo/config-typescript": "*",
        "vitest": "catalog:testing",
        "@vitest/coverage-v8": "catalog:testing",
        "typescript": "catalog:build"
    },
    "module": "./dist/esm/index.mjs"
}
