{
    "name": "@deployer/provider-schema",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./domain": {
            "types": "./dist/types/domain/index.d.ts",
            "import": "./dist/esm/domain/index.mjs",
            "require": "./dist/cjs/domain/index.js"
        },
        "./catalog": {
            "types": "./dist/types/catalog/index.d.ts",
            "import": "./dist/esm/catalog/index.mjs",
            "require": "./dist/cjs/catalog/index.js"
        },
        "./validation": {
            "types": "./dist/types/validation/index.d.ts",
            "import": "./dist/esm/validation/index.mjs",
            "require": "./dist/cjs/validation/index.js"
        }
    },
    "scripts": {
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@deployer/type-guards": "*",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-typescript": "*",
        "vitest": "catalog:testing",
        "@vitest/coverage-v8": "catalog:testing",
        "typescript": "catalog:build",
        "@deployer/pkg-build": "*"
    },
    "module": "./dist/esm/index.mjs"
}
