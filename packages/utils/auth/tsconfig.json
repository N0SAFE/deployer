{
  "extends": "@repo/config-typescript/react-library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "paths": {
      "@repo/auth/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
