{
    "name": "@repo/vite-assets",
    "version": "1.0.0",
    "description": "Express middleware that proxies the SSR client bundle from a Vite dev server. Dev-only, fail-closed, one whitelisted prefix.",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@repo/logger": "*"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@types/express": "catalog:api:nest",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "express": "catalog:api:nest",
        "rimraf": "catalog:build",
        "typescript": "catalog:build"
    }
}
