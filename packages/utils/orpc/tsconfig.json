{
  "extends": "../../configs/typescript/config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@repo/orpc-utils/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
