{
    "name": "@repo/orpc-utils",
    "version": "1.0.0",
    "description": "ORPC builder utilities for standardized contract creation",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./builder": {
            "types": "./src/builder/index.ts",
            "import": "./dist/esm/builder/index.mjs",
            "require": "./dist/cjs/builder/index.js"
        },
        "./standard": {
            "types": "./src/operations/index.ts",
            "import": "./dist/esm/operations/index.mjs",
            "require": "./dist/cjs/operations/index.js"
        },
        "./query": {
            "types": "./src/query/index.ts",
            "import": "./dist/esm/query/index.mjs",
            "require": "./dist/cjs/query/index.js"
        },
        "./hooks": {
            "types": "./src/hooks/index.ts",
            "import": "./dist/esm/hooks/index.mjs",
            "require": "./dist/cjs/hooks/index.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc",
        "@orpc/shared": "catalog:orpc",
        "@orpc/tanstack-query": "catalog:orpc",
        "@repo/type-guards": "*",
        "@standard-schema/spec": "^1.1.0",
        "@tanstack/react-query": "catalog:tanstack",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@types/react": "catalog:react",
        "react": "catalog:react",
        "eslint": "catalog:linting",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "vitest": "catalog:testing",
        "@vitest/coverage-v8": "catalog:testing",
        "typescript": "catalog:build"
    },
    "module": "./dist/esm/index.mjs"
}
