,"endColumn":59},{"ruleId":"794","severity":2,"message":"795","line":237,"column":31,"messageId":"796","endLine":237,"endColumn":63},{"ruleId":"758","severity":2,"message":"1123","line":302,"column":26,"messageId":"760","endLine":302,"endColumn":60},{"ruleId":"811","severity":2,"message":"869","line":352,"column":22,"messageId":"870","endLine":352,"endColumn":68,"fix":"1124"},{"ruleId":"811","severity":2,"message":"869","line":358,"column":22,"messageId":"870","endLine":360,"endColumn":16,"fix":"1125"},{"ruleId":"1116","severity":2,"message":"1117","line":35,"column":6,"messageId":"1118","endLine":35,"endColumn":25,"fix":"1126"},{"ruleId":"758","severity":2,"message":"1127","line":86,"column":51,"messageId":"760","endLine":86,"endColumn":60},{"ruleId":"758","severity":2,"message":"759","line":86,"column":81,"messageId":"760","endLine":86,"endColumn":103},{"ruleId":"763","severity":2,"message":"1128","line":93,"column":23,"messageId":"1129","endLine":93,"endColumn":53,"fix":"1130"},{"ruleId":"763","severity":2,"message":"1128","line":93,"column":56,"messageId":"1129","endLine":93,"endColumn":80,"fix":"1131"},{"ruleId":"763","severity":2,"message":"764","line":109,"column":18,"messageId":"765","endLine":109,"endColumn":70,"fix":"1132"},{"ruleId":"758","severity":2,"message":"759","line":601,"column":15,"messageId":"760","endLine":601,"endColumn":50},{"ruleId":"758","severity":2,"message":"759","line":25,"column":44,"messageId":"760","endLine":25,"endColumn":62},{"ruleId":"799","severity":2,"message":"800","line":25,"column":57,"messageId":"801","endLine":25,"endColumn":59,"suggestions":"1133"},{"ruleId":"815","severity":2,"message":"929","line":52,"column":9,"messageId":"930","endLine":52,"endColumn":22,"suppressions":"1134"},"@typescript-eslint/restrict-template-expressions","Invalid type \"number\" of template literal expression.","invalidType","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/hooks/use-mobile.ts:14:5\n  12 |     }\n  13 |     mql.addEventListener(\"change\", onChange)\n> 14 |     setIsMobile(window.innerWidth < MOBILE_BREAKPOINT)\n     |     ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  15 |     return () => mql.removeEventListener(\"change\", onChange)\n  16 |   }, [])\n  17 |","@typescript-eslint/no-confusing-void-expression","Returning a void expression from an arrow function shorthand is forbidden. Please add braces to the arrow function.","invalidVoidExprArrow",{"range":"1135","text":"1136"},"@typescript-eslint/no-floating-promises","Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","floatingVoid",["1137","1138"],["1139","1140"],["1141","1142"],["1143","1144"],["1145","1146"],["1147","1148"],["1149","1150"],["1151","1152"],["1153","1154"],"@typescript-eslint/no-unused-vars","'isRecord' is defined but never used.","unusedVar",["1155"],"'isObjectLike' is defined but never used.",["1156"],"@typescript-eslint/no-unnecessary-type-arguments","This is the default value for this type parameter, so it can be omitted.","unnecessaryTypeParameter",{"range":"1157","text":"1158"},{"range":"1159","text":"1158"},{"range":"1160","text":"1158"},{"range":"1161","text":"1158"},{"range":"1162","text":"1158"},{"range":"1163","text":"1158"},"@typescript-eslint/no-unsafe-assignment","Unsafe assignment of an `any` value.","anyAssignment","react-hooks/exhaustive-deps","The 'serialize' logical expression could make the dependencies of useCallback Hook (at line 446) change on every render. Move it inside the useCallback callback. Alternatively, wrap the initialization of 'serialize' in its own useMemo() Hook.","@typescript-eslint/prefer-nullish-coalescing","Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","preferNullishOverOr",["1164"],"The 'deserialize' logical expression could make the dependencies of useCallback Hook (at line 190) change on every render. Move it inside the useCallback callback. Alternatively, wrap the initialization of 'deserialize' in its own useMemo() Hook.",["1165"],"Invalid type \"unknown\" of template literal expression.","@typescript-eslint/prefer-optional-chain","Prefer using an optional chain expression instead, as it's more concise and easier to read.","preferOptionalChain",["1166"],["1167"],"@typescript-eslint/no-unnecessary-type-assertion","This assertion is unnecessary since it does not change the type of the expression.","unnecessaryAssertion",{"range":"1168","text":"1158"},"@typescript-eslint/no-unnecessary-condition","Unnecessary conditional, value is always truthy.","alwaysTruthy",{"range":"1169","text":"1158"},"'_' is assigned a value but never used.",["1170"],["1171","1172"],["1173"],"Unnecessary conditional, comparison is always true, since `\"Enter\" === \"Enter\"` is true.","comparisonBetweenLiteralTypes",["1174"],"Unnecessary conditional, the types have no overlap.","noOverlapBooleanExpression","Unsafe spread of an `any` value in an array.","unsafeArraySpread","'key' is assigned a value but never used.","Prefer using nullish coalescing operator (`??`) instead of a ternary expression, as it is simpler to read.","preferNullishOverTernary",["1175"],"@typescript-eslint/no-inferrable-types","Type string trivially inferred from a string literal, remove type annotation.","noInferrableType",{"range":"1176","text":"1158"},"Type boolean trivially inferred from a boolean literal, remove type annotation.",{"range":"1177","text":"1158"},"Type number trivially inferred from a number literal, remove type annotation.",{"range":"1178","text":"1158"},"@typescript-eslint/no-unsafe-argument","Unsafe argument of type `any[]` assigned to a parameter of type `T[]`.","unsafeArgument",{"range":"1179","text":"1158"},"no-useless-assignment","The value assigned to 'csvContent' is not used in subsequent statements.","unnecessaryAssignment",["1180"],"@typescript-eslint/no-base-to-string","'value' will use Object's default stringification format ('[object Object]') when stringified.","baseToString",["1181"],"@typescript-eslint/array-type","Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","errorStringArray",{"range":"1182","text":"1183"},"@typescript-eslint/no-explicit-any","Unexpected any. Specify a different type.","unexpectedAny",["1184","1185"],"@typescript-eslint/ban-ts-comment","Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free.","tsIgnoreInsteadOfExpectError",["1186"],"@typescript-eslint/no-unsafe-member-access","Unsafe member access .default on an `any` value.","unsafeMemberExpression","This assertion is unnecessary since the receiver accepts the original type of the expression.","contextuallyUnnecessary",{"range":"1187","text":"1158"},"Unnecessary conditional, expected left-hand side of `??` operator to be possibly null or undefined.","neverNullish",["1188"],["1189"],"@typescript-eslint/prefer-reduce-type-parameter","Unnecessary assertion: Array#reduce accepts a type parameter for the default value.","preferTypeParameter",{"range":"1190","text":"1191"},["1192"],"Unsafe member access .columns on an `any` value.",["1193"],["1194"],["1195","1196"],"@typescript-eslint/no-unsafe-call","Unsafe call of an `any` typed value.","unsafeCall","Unsafe member access .addRow on an `any` value.","Unsafe member access .getRow on an `any` value.","Unsafe member access .font on an `any` value.","Unsafe member access .fill on an `any` value.",{"range":"1197","text":"1183"},["1198"],"React Hook useMemo has an unnecessary dependency: 'enableUrlState'. Either exclude it or remove the dependency array. Outer scope values like 'enableUrlState' aren't valid dependencies because mutating them doesn't re-render the component.",["1199"],"@typescript-eslint/no-unsafe-return","Unsafe return of a value of type `any`.","unsafeReturn","Unsafe member access .toUpperCase on an `any` value.",{"range":"1200","text":"1201"},{"range":"1202","text":"1203"},{"range":"1204","text":"1205"},"'createSortingHandler' is defined but never used.",["1206"],"'createPaginationHandler' is defined but never used.",["1207"],"'createColumnSizingHandler' is defined but never used.",["1208"],"'TData' is defined but never used.",["1209","1210"],{"range":"1211","text":"1158"},"@typescript-eslint/no-redundant-type-constituents","true is overridden by boolean in this union type.","literalOverridden",["1212","1213"],{"range":"1214","text":"1158"},{"range":"1215","text":"1183"},{"range":"1216","text":"1183"},"@typescript-eslint/no-useless-default-assignment","Default value is useless because the property is not optional.","uselessDefaultAssignment",{"range":"1217","text":"1158"},{"range":"1218","text":"1158"},["1219"],["1220"],["1221"],{"range":"1222","text":"1223"},["1224","1225"],"Unnecessary conditional, value is always falsy.","alwaysFalsy","Unsafe return of a value of type `any[]`.","Unsafe member access [sortConfig.columnId] on an `any` value.","The value assigned to 'comparison' is not used in subsequent statements.",["1226"],["1227"],["1228"],"@typescript-eslint/no-dynamic-delete","Do not delete dynamically computed property keys.","dynamicDelete",["1229"],["1230","1231"],"Unsafe member access [idField] on an `any` value.",{"range":"1232","text":"1158"},{"range":"1233","text":"1234"},{"range":"1235","text":"1236"},{"range":"1237","text":"1236"},["1238"],["1239","1240"],{"range":"1241","text":"1158"},["1242","1243"],"Unsafe member access .item_id on an `any` value.","Unsafe member access .total_amount on an `any` value.","Unsafe member access .status on an `any` value.",["1244"],["1245","1246"],{"range":"1247","text":"1158"},["1248","1249"],["1250"],["1251","1252"],["1253","1254"],"React Hook useEffect has a missing dependency: 'queryResult'. Either include it or remove the dependency array.",["1255"],"@typescript-eslint/use-unknown-in-catch-callback-variable","Prefer the safe `: unknown` for a `catch` callback variable.","useUnknown",["1256"],"React Hook useCallback received a function whose dependencies are unknown. Pass an inline function instead.",["1257","1258"],["1259","1260"],["1261"],{"range":"1262","text":"1158"},["1263"],["1264"],"react-hooks/incompatible-library","Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/data-table.tsx:1020:17\n  1018 |\n  1019 |   // Set up the table with memoized configuration\n> 1020 |   const table = useReactTable<TData>(tableOptions);\n       |                 ^^^^^^^^^^^^^ TanStack Table's `useReactTable()` API returns functions that cannot be memoized safely\n  1021 |\n  1022 |   // Row click handler with conflict prevention\n  1023 |   const handleRowClick = useCallback((event: React.MouseEvent, rowData: TData, rowIndex: number) => {",["1265"],["1266","1267"],"Unnecessary optional chain on a non-nullish value.","neverOptionalChain",["1268"],["1269","1270"],{"range":"1271","text":"1158"},"@typescript-eslint/no-misused-promises","Promise-returning function provided to attribute where a void return was expected.","voidReturnAttribute","'_' is defined but never used.","'i' is defined but never used.","'j' is defined but never used.","'array' is defined but never used.",["1272"],["1273"],"@typescript-eslint/no-non-null-assertion","Forbidden non-null assertion.","noNonNull",["1274"],["1275"],["1276"],["1277"],["1278"],{"range":"1279","text":"1280"},["1281","1282"],"Unsafe member access .accessorKey on an `any` value.",["1283","1284"],"Unsafe member access [accessorKey] on an `any` value.","Computed name [accessorKey] resolves to an `any` value.","unsafeComputedMemberAccess",["1285"],"Unsafe argument of type `any` assigned to a parameter of type `CellContext<any, unknown>`.",["1286","1287"],["1288","1289"],["1290","1291"],["1292","1293"],["1294"],["1295","1296"],["1297","1298"],["1299"],["1300"],{"range":"1301","text":"1158"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/hooks/use-table-column-resize.ts:73:11\n  71 |         if (savedSizing) {\n  72 |           const parsed = JSON.parse(savedSizing);\n> 73 |           setColumnSizing(parsed);\n     |           ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  74 |           prevSizingRef.current = parsed;\n  75 |         }\n  76 |       } catch (error) {","Unsafe argument of type `any` assigned to a parameter of type `SetStateAction<ColumnSizingState>`.",{"range":"1302","text":"1183"},{"range":"1303","text":"1183"},["1304"],["1305"],{"range":"1306","text":"1307"},{"range":"1308","text":"1309"},["1310"],["1311"],["1312"],"Unsafe argument of type `any` assigned to a parameter of type `Updater<ColumnOrderState>`.",{"range":"1313","text":"1158"},["1314"],{"range":"1315","text":"1316"},{"range":"1317","text":"1318"},{"range":"1319","text":"1320"},["1321"],"'_table' is defined but never used.","'TrashIcon' is defined but never used.",["1322"],{"range":"1323","text":"1183"},["1324","1325"],["1326","1327"],["1328","1329"],["1330","1331"],{"range":"1332","text":"1183"},"Unsafe member access .enabled on an `any` value.",["1333"],["1334"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/toolbar.tsx:149:7\n  147 |     }\n  148 |     if (search !== localSearch) {\n> 149 |       setLocalSearch(search);\n      |       ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  150 |     }\n  151 |   }, [search, localSearch]);\n  152 |","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/toolbar.tsx:162:7\n  160 |\n  161 |     if (tableSearch !== localSearch && tableSearch !== \"\") {\n> 162 |       setLocalSearch(tableSearch);\n      |       ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  163 |     }\n  164 |   }, [tableSearch, localSearch]);\n  165 |","react-hooks/preserve-manual-memoization","Compilation Skipped: Existing memoization could not be preserved\n\nReact Compiler has skipped optimizing this component because the existing manual memoization could not be preserved. The inferred dependencies did not match the manually specified dependencies, which could cause the value to change more or less frequently than expected. The inferred dependency was `dateRange`, but the source dependencies were [dateRange?.from_date, dateRange?.to_date]. Inferred less specific property than source.\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/toolbar.tsx:176:39\n  174 |\n  175 |   // Memoize the getInitialDates function to prevent unnecessary recreations\n> 176 |   const getInitialDates = useCallback((): {\n      |                                       ^^^^^\n> 177 |     from: Date | undefined;\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 178 |     to: Date | undefined;\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 190 |     return { from: fromDate, to: toDate };\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 191 |   }, [dateRange?.from_date, dateRange?.to_date]);\n      | ^^^^ Could not preserve existing manual memoization\n  192 |\n  193 |   // Initial state with date values from URL\n  194 |   const [dates, setDates] = useState<{",["1335"],["1336"],["1337"],["1338"],"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/toolbar.tsx:197:6\n  195 |     from: Date | undefined;\n  196 |     to: Date | undefined;\n> 197 |   }>(getInitialDates());\n      |      ^^^^^^^^^^^^^^^ This function accesses a ref value\n  198 |\n  199 |   // Track if user has explicitly changed dates\n  200 |   const [datesModified, setDatesModified] = useState(",["1339"],["1340"],["1341"],["1342"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/sebille/Bureau/projects/tests/deployer/v3/packages/ui/base/src/components/data-table/toolbar.tsx:269:7\n  267 |     \n  268 |     if (hasFromChanged || hasToChanged) {\n> 269 |       setDates(newDates);\n      |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  270 |       setDatesModified(!!(newDates.from || newDates.to));\n  271 |     }\n  272 |   }, [dates, getInitialDates]);",["1343"],{"range":"1344","text":"1158"},["1345"],{"range":"1346","text":"1347"},{"range":"1348","text":"1349"},{"range":"1350","text":"1351"},{"range":"1352","text":"1353"},{"range":"1354","text":"1355"},"@typescript-eslint/no-require-imports","A `require()` style import is forbidden.","noRequireImports",["1356"],["1357"],["1358"],["1359"],["1360"],["1361"],["1362"],["1363"],{"range":"1364","text":"1365"},{"range":"1366","text":"1367"},"@typescript-eslint/no-unused-expressions","Expected an assignment or function call and instead saw an expression.","unusedExpression","@typescript-eslint/non-nullable-type-assertion-style","Use a ! assertion to more succinctly remove null and undefined from the type.","preferNonNullAssertion",{"range":"1368","text":"1369"},{"range":"1370","text":"1371"},["1372"],"'part' is defined but never used.",{"range":"1373","text":"1374"},{"range":"1375","text":"1376"},{"range":"1377","text":"1376"},{"range":"1378","text":"1376"},{"range":"1379","text":"1376"},{"range":"1380","text":"1374"},{"range":"1381","text":"1374"},"React Hook React.useEffect has missing dependencies: 'handleWheel' and 'id'. Either include them or remove the dependency array.",["1382"],["1383"],{"range":"1384","text":"1385"},{"range":"1386","text":"1387"},{"range":"1388","text":"1389"},{"range":"1390","text":"1391"},{"range":"1392","text":"1393"},{"range":"1394","text":"1395"},{"range":"1396","text":"1397"},{"range":"1398","text":"1399"},{"range":"1400","text":"1401"},{"range":"1402","text":"1403"},["1404"],"@typescript-eslint/consistent-type-definitions","Use an `interface` instead of a `type`.","interfaceOverType",{"range":"1405","text":"1406"},"Invalid type \"TooltipNameType | ((obj: any) => any)\" of template literal expression.",["1407"],"Unsafe argument of type `any` assigned to a parameter of type `readonly Payload<ValueType, NameType>[]`.","Invalid type \"string | number | ((obj: any) => any)\" of template literal expression.",{"range":"1408","text":"1158"},{"range":"1409","text":"1158"},{"range":"1410","text":"1411"},"Invalid type \"boolean\" of template literal expression.","Returning a void expression from a function is forbidden. Please remove the `return` statement.","invalidVoidExprReturnLast",{"range":"1412","text":"1413"},{"range":"1414","text":"1413"},{"range":"1415","text":"1416"},["1417"],["1418"],[489,532],"{ mql.removeEventListener(\"change\", onChange); }",{"messageId":"1419","fix":"1420","desc":"1421"},{"messageId":"1422","fix":"1423","desc":"1424"},{"messageId":"1419","fix":"1425","desc":"1421"},{"messageId":"1422","fix":"1426","desc":"1424"},{"messageId":"1419","fix":"1427","desc":"1421"},{"messageId":"1422","fix":"1428","desc":"1424"},{"messageId":"1419","fix":"1429","desc":"1421"},{"messageId":"1422","fix":"1430","desc":"1424"},{"messageId":"1419","fix":"1431","desc":"1421"},{"messageId":"1422","fix":"1432","desc":"1424"},{"messageId":"1419","fix":"1433","desc":"1421"},{"messageId":"1422","fix":"1434","desc":"1424"},{"messageId":"1419","fix":"1435","desc":"1421"},{"messageId":"1422","fix":"1436","desc":"1424"},{"messageId":"1419","fix":"1437","desc":"1421"},{"messageId":"1422","fix":"1438","desc":"1424"},{"messageId":"1419","fix":"1439","desc":"1421"},{"messageId":"1422","fix":"1440","desc":"1424"},{"messageId":"1441","data":"1442","fix":"1443","desc":"1444"},{"messageId":"1445","data":"1446","fix":"1447","desc":"1448"},[413,422],"",[452,461],[764,773],[803,812],[1152,1161],[1984,1993],{"messageId":"1449","data":"1450","fix":"1451","desc":"1452"},{"messageId":"1449","data":"1453","fix":"1454","desc":"1452"