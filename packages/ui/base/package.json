{
    "name": "@repo/ui",
    "version": "1.0.0",
    "main": "./dist/production/cjs/index.js",
    "module": "./dist/production/esm/index.mjs",
    "types": "./dist/types/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "pkgBuild": {
        "root": "src",
        "include": [
            "components",
            "hooks",
            "lib"
        ],
        "entries": [
            "index.ts"
        ],
        "copy": [
            {
                "from": "src/styles",
                "to": "dist/styles"
            }
        ],
        "variants": [
            "development",
            "production"
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "development": {
                "import": "./dist/development/esm/index.mjs",
                "require": "./dist/development/cjs/index.js"
            },
            "production": {
                "import": "./dist/production/esm/index.mjs",
                "require": "./dist/production/cjs/index.js"
            },
            "default": {
                "import": "./dist/production/esm/index.mjs",
                "require": "./dist/production/cjs/index.js"
            }
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "development": {
                "import": "./dist/development/esm/*.mjs",
                "require": "./dist/development/cjs/*.js"
            },
            "production": {
                "import": "./dist/production/esm/*.mjs",
                "require": "./dist/production/cjs/*.js"
            },
            "default": {
                "import": "./dist/production/esm/*.mjs",
                "require": "./dist/production/cjs/*.js"
            }
        },
        "./styles/globals.css": "./src/styles/globals.css"
    },
    "license": "MIT",
    "scripts": {
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "compile": "bun x cross-env COMPILE_MODE=true bun run build",
        "clean": "rimraf dist",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint \"**/*.ts*\" --cache",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "ui:add": "bun x --bun shadcn@latest add --",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "peerDependencies": {
        "react": "catalog:react",
        "@hookform/resolvers": "catalog:utils",
        "class-variance-authority": "catalog:ui",
        "clsx": "catalog:styling",
        "cmdk": "catalog:ui",
        "framer-motion": "catalog:ui",
        "lucide-react": "catalog:ui",
        "next-themes": "catalog:next",
        "react-hook-form": "catalog:react",
        "sonner": "catalog:ui",
        "tailwind-merge": "catalog:styling",
        "tailwindcss-animate": "catalog:styling",
        "tw-animate-css": "catalog:ui",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@eslint/eslintrc": "catalog:linting",
        "@eslint/js": "catalog:linting",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-tailwind": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@tailwindcss/postcss": "catalog:styling",
        "@testing-library/jest-dom": "catalog:testing",
        "@testing-library/react": "catalog:testing",
        "@testing-library/user-event": "catalog:testing",
        "@types/node": "catalog:build",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitejs/plugin-react": "catalog:testing",
        "@parcel/watcher": "catalog:build",
        "delete-cli": "^0.1.3",
        "eslint": "catalog:linting",
        "jsdom": "catalog:testing",
        "next": "catalog:next",
        "postcss": "catalog:styling",
        "prettier-plugin-tailwindcss": "catalog:linting",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "tailwind-variants": "catalog:styling",
        "tailwindcss": "catalog:styling",
        "tsup": "^8.5.0",
        "vitest": "catalog:testing",
        "typescript": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "dependencies": {
        "@hookform/resolvers": "catalog:utils",
        "@radix-ui/react-collapsible": "^1.1.14",
        "@radix-ui/react-context-menu": "^2.3.1",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-select": "^2.3.1",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-tabs": "^1.1.15",
        "@radix-ui/react-toggle": "^1.1.12",
        "@repo/contracts-entities": "*",
        "@repo/logger": "*",
        "@repo/type-guards": "*",
        "@tanstack/react-form": "catalog:tanstack",
        "@tanstack/react-query": "catalog:tanstack",
        "@tanstack/react-table": "catalog:tanstack",
        "class-variance-authority": "catalog:ui",
        "clsx": "catalog:styling",
        "cmdk": "catalog:ui",
        "concurrently": "catalog:dev",
        "date-fns": "catalog:utils",
        "date-fns-tz": "catalog:utils",
        "exceljs": "catalog:utils",
        "framer-motion": "catalog:ui",
        "lucide-react": "catalog:ui",
        "next-themes": "catalog:next",
        "radix-ui": "catalog:ui",
        "react-day-picker": "catalog:react",
        "react-hook-form": "catalog:react",
        "react-use": "catalog:react",
        "recharts": "catalog:ui",
        "rimraf": "catalog:build",
        "shadcn": "catalog:ui",
        "sonner": "catalog:ui",
        "tailwind-merge": "catalog:styling",
        "tailwindcss-animate": "catalog:styling",
        "tw-animate-css": "catalog:ui",
        "zod": "catalog:utils"
    },
    "overrides": {
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react"
    }
}
