{
    "name": "@deployer/env",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./cli": {
            "types": "./dist/types/cli.d.ts",
            "import": "./dist/esm/cli.mjs",
            "require": "./dist/cjs/cli.js"
        },
        "./utils": {
            "types": "./dist/types/utils.d.ts",
            "import": "./dist/esm/utils.mjs",
            "require": "./dist/cjs/utils.js"
        },
        "./constants": {
            "types": "./dist/types/constants.d.ts",
            "import": "./dist/esm/constants.mjs",
            "require": "./dist/cjs/constants.js"
        },
        "./validate": {
            "types": "./dist/types/validate.d.ts",
            "import": "./dist/esm/validate.mjs",
            "require": "./dist/cjs/validate.js"
        },
        "./mock": {
            "types": "./dist/types/mock.d.ts",
            "import": "./dist/esm/mock.mjs",
            "require": "./dist/cjs/mock.js"
        }
    },
    "bin": {
        "check": "./src/cli.ts",
        "load": "./src/cli.ts",
        "mock": "./src/cli.ts"
    },
    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "type-check": "bun check --no-script",
        "check": "bun src/cli.ts check",
        "load": "bun src/cli.ts load",
        "mock": "bun src/cli.ts mock",
        "test": "vitest run",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@deployer/type-guards": "*",
        "dotenv": "catalog:dev",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/pkg-build": "*",
        "@types/bun": "catalog:build",
        "@types/node": "catalog:build",
        "@vitest/coverage-v8": "catalog:testing",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.ts"
}
