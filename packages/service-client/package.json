{
    "name": "@deployer/service-client",
    "version": "0.0.0",
    "private": true,
    "description": "Typed service clients over oRPC contracts: one cached client per service and contract, flattened procedures, per-request credentials, and an Effect transport that fails with a typed ServiceUnreachable.",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "test:coverage": "bun --bun vitest run --coverage"
    },
    "dependencies": {
        "@deployer/effect-core": "*",
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc",
        "@orpc/openapi": "catalog:orpc",
        "@orpc/openapi-client": "catalog:orpc",
        "effect": "catalog:effect"
    },
    "peerDependencies": {
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "zod": "catalog:utils",
        "typescript": "catalog:build"
    }
}
