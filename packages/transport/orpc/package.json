{
    "name": "@deployer/orpc-utils",
    "version": "1.0.0",
    "description": "ORPC builder utilities for standardized contract creation",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./builder": {
            "types": "./dist/types/builder/index.d.ts",
            "import": "./dist/esm/builder/index.mjs",
            "require": "./dist/cjs/builder/index.js"
        },
        "./standard": {
            "types": "./dist/types/operations/index.d.ts",
            "import": "./dist/esm/operations/index.mjs",
            "require": "./dist/cjs/operations/index.js"
        },
        "./query": {
            "types": "./dist/types/query/index.d.ts",
            "import": "./dist/esm/query/index.mjs",
            "require": "./dist/cjs/query/index.js"
        },
        "./hooks": {
            "types": "./dist/types/hooks/index.d.ts",
            "import": "./dist/esm/hooks/index.mjs",
            "require": "./dist/cjs/hooks/index.js"
        },
        "./testing": {
            "types": "./dist/types/testing/index.d.ts",
            "import": "./dist/esm/testing/index.mjs",
            "require": "./dist/cjs/testing/index.js"
        }
    },
    "scripts": {
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "test:coverage": "bun --bun vitest run --coverage",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@orpc/client": "catalog:orpc",
        "@orpc/contract": "catalog:orpc",
        "@orpc/openapi": "catalog:orpc",
        "@orpc/shared": "catalog:orpc",
        "@orpc/tanstack-query": "catalog:orpc",
        "@deployer/type-guards": "*",
        "@standard-schema/spec": "^1.1.0",
        "@tanstack/react-query": "catalog:tanstack",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils",
        "@orpc/server": "catalog:orpc"
    },
    "devDependencies": {
        "@deployer/auth": "*",
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/pkg-build": "*",
        "@types/react": "catalog:react",
        "@vitest/coverage-v8": "catalog:testing",
        "eslint": "catalog:linting",
        "react": "catalog:react",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
