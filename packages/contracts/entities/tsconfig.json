{
    "extends": "../../../tooling/typescript/config/base.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "pkg-build.config.ts", "./src/**/*"
    ]
}
