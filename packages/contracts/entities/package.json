{
    "name": "@repo/contracts-entities",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@repo/auth": "*",
        "@repo/contracts-common": "*",
        "@repo/orpc-utils": "*",
        "@repo/provider-schema": "*",
        "@repo/type-guards": "*",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "@repo/config-vitest": "*",
        "@repo/config-typescript": "*",
        "@vitest/coverage-v8": "catalog:testing",
        "vitest": "catalog:testing",
        "typescript": "catalog:build",
        "chokidar": "catalog:build",
        "rimraf": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "module": "./dist/esm/index.mjs"
}
