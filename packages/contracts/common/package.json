{
    "name": "@repo/contracts-common",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@repo/type-guards": "*",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "@repo/config-typescript": "*",
        "typescript": "catalog:build",
        "chokidar": "catalog:build",
        "rimraf": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "module": "./dist/esm/index.mjs"
}
