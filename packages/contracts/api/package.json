{
    "name": "@repo/api-contracts",
    "version": "0.0.0",
    "private": true,
    "main": "./index.ts",
    "types": "./index.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./index.ts",
            "default": "./index.ts"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./*.ts",
            "default": "./*.ts"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "compile": "bun x cross-env COMPILE_MODE=true bun run build",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "lint": "bunx eslint . --cache",
        "type-check": "tsc --noEmit",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "dependencies": {
        "@octokit/webhooks-types": "catalog:utils",
        "@orpc/contract": "catalog:orpc",
        "@orpc/openapi": "catalog:orpc",
        "@orpc/shared": "catalog:orpc",
        "@repo/auth": "*",
        "@repo/contracts-common": "*",
        "@repo/contracts-entities": "*",
        "@repo/orpc-utils": "*",
        "@repo/provider-schema": "*",
        "@repo/type-guards": "*",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@orpc/contract": "catalog:orpc",
        "@orpc/shared": "catalog:orpc",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "eslint": "catalog:linting",
        "@repo/config-typescript": "*",
        "typescript": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "pkgBuild": {
        "root": ".",
        "entries": [
            "index.ts"
        ],
        "formats": [
            "esm"
        ],
        "flat": true,
        "target": "bun",
        "minify": true,
        "external": [
            "@orpc/contract",
            "@orpc/shared",
            "zod"
        ]
    }
}
