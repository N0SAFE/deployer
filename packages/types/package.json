{
    "name": "@repo/types",
    "version": "1.0.0",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint \"**/*.ts*\" --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "bun --bun ../bin/pkg-build/index.ts",
        "dev": "bun --bun ../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "eslint": "catalog:linting",
        "@eslint/eslintrc": "catalog:linting",
        "@eslint/js": "catalog:linting",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "vitest": "catalog:testing",
        "zod": "catalog:utils",
        "drizzle-orm": "catalog:database",
        "typescript": "catalog:build",
        "chokidar": "catalog:build",
        "rimraf": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@repo/type-guards": "*",
        "concurrently": "catalog:dev",
        "rimraf": "catalog:build"
    },
    "peerDependencies": {
        "concurrently": "catalog:dev",
        "rimraf": "catalog:build"
    },
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "module": "./dist/esm/index.mjs"
}
