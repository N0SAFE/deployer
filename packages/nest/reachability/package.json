{
    "name": "@repo/nest-reachability",
    "version": "1.0.0",
    "description": "Generic network probing: address normalization, address/peer reachability probes. No platform policy, no node model.",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./services/network-probe": {
            "types": "./dist/types/services/network-probe.d.ts",
            "import": "./dist/esm/services/network-probe.mjs",
            "require": "./dist/cjs/services/network-probe.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@repo/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
