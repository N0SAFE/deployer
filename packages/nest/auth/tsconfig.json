{
  "extends": "@repo/config-typescript/nestjs",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "types": ["node", "bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "node_modules",
    "dist",
    "../../packages/**",
    "../../apps/web/**"
  ]
}
