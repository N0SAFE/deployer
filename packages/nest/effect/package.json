{
	"dependencies": {
		"@deployer/contracts-entities": "*",
		"@deployer/docker": "*",
		"@deployer/database": "*",
		"@deployer/effect-core": "*",
		"@deployer/events": "*",
		"@deployer/system-metrics": "*",
		"@deployer/environment": "*",
		"@deployer/lifecycle": "*",
        "@deployer/mesh-network": "*",
		"@deployer/errors": "*",
		"@deployer/node-state": "*",
		"@deployer/supervision": "*",
		"@deployer/swarm": "*",
		"@deployer/type-guards": "*",
		"@nestjs/common": "catalog:api:nest",
		"@nestjs/core": "catalog:api:nest",
		"@orpc/server": "catalog:orpc",
		"dockerode": "catalog:utils",
		"effect": "catalog:effect",
		"rxjs": "catalog:api:nest",
		"zod": "catalog:utils"
	},
	"description": "Effect runtime bridge for NestJS: auto-discovers Effect service providers and exposes one ManagedRuntime.",
	"devDependencies": {
		"@deployer/config-eslint": "*",
		"@deployer/config-prettier": "*",
		"@deployer/config-typescript": "*",
		"@deployer/config-vitest": "*",
		"@deployer/pkg-build": "*",
		"@nestjs/testing": "catalog:api:nest",
		"@types/node": "catalog:build",
		"chokidar": "catalog:build",
		"eslint": "catalog:linting",
		"reflect-metadata": "catalog:api:nest",
		"rimraf": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:testing",
		"@types/dockerode": "*"
	},
	"exports": {
		".": {
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./*": {
			"import": "./dist/esm/*.mjs",
			"require": "./dist/cjs/*.js",
			"types": "./dist/types/*.d.ts"
		},
		"./testing": {
			"import": "./dist/esm/testing.mjs",
			"require": "./dist/cjs/testing.js",
			"types": "./dist/types/testing.d.ts"
		},
		"./supervision": {
			"import": "./dist/esm/supervision/index.mjs",
			"require": "./dist/cjs/supervision/index.js",
			"types": "./dist/types/supervision/index.d.ts"
		},
		"./node-state": {
			"import": "./dist/esm/node-state/index.mjs",
			"require": "./dist/cjs/node-state/index.js",
			"types": "./dist/types/node-state/index.d.ts"
		},
		"./swarm": {
			"import": "./dist/esm/swarm/index.mjs",
			"require": "./dist/cjs/swarm/index.js",
			"types": "./dist/types/swarm/index.d.ts"
		},
		"./docker": {
			"import": "./dist/esm/docker/index.mjs",
			"require": "./dist/cjs/docker/index.js",
			"types": "./dist/types/docker/index.d.ts"
		},
		"./system-metrics": {
			"import": "./dist/esm/system-metrics/index.mjs",
			"require": "./dist/cjs/system-metrics/index.js",
			"types": "./dist/types/system-metrics/index.d.ts"
		},
		"./events": {
			"import": "./dist/esm/events/index.mjs",
			"require": "./dist/cjs/events/index.js",
			"types": "./dist/types/events/index.d.ts"
		},
		"./database": {
			"import": "./dist/esm/database/index.mjs",
			"require": "./dist/cjs/database/index.js",
			"types": "./dist/types/database/index.d.ts"
		},
		"./env": {
			"import": "./dist/esm/env/index.mjs",
			"require": "./dist/cjs/env/index.js",
			"types": "./dist/types/env/index.d.ts"
		},
		"./lifecycle": {
			"import": "./dist/esm/lifecycle/index.mjs",
			"require": "./dist/cjs/lifecycle/index.js",
			"types": "./dist/types/lifecycle/index.d.ts"
		}
	},
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.mjs",
	"name": "@deployer/nest-effect",
	"peerDependencies": {
		"@nestjs/common": "catalog:api:nest",
		"@nestjs/config": "catalog:api:nest",
		"@nestjs/core": "catalog:api:nest"
	},
	"scripts": {
		"build": "bun --bun pkg-build",
		"build:types": "bun --bun pkg-build --types",
		"clean": "rimraf dist",
		"dev": "bun --bun pkg-build --watch",
		"format": "bun run prettify",
		"format:check": "bun fmt --check .",
		"lint": "bun lint --no-script --type-aware",
		"lint:fix": "bun lint --no-script --fix --type-aware",
		"lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
		"prettify": "bun fmt .",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "bun check --no-script"
	},
	"types": "./dist/types/index.d.ts",
	"version": "1.0.0"
}
