{
    "name": "@repo/nest-database-local",
    "version": "1.0.0",
    "description": "The local SQLite database: Drizzle connection, lifecycle and the @Global module providing its tokens.",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./local-database.service": {
            "types": [
                "./src/local-database.service.ts"
            ],
            "import": "./dist/esm/local-database.service.mjs",
            "require": "./dist/cjs/local-database.service.js"
        },
        "./local-database-lifecycle.service": {
            "types": [
                "./src/local-database-lifecycle.service.ts"
            ],
            "import": "./dist/esm/local-database-lifecycle.service.mjs",
            "require": "./dist/cjs/local-database-lifecycle.service.js"
        },
        "./local-database.module": {
            "types": [
                "./src/local-database.module.ts"
            ],
            "import": "./dist/esm/local-database.module.mjs",
            "require": "./dist/cjs/local-database.module.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@repo/nest-database-core": "*",
        "@repo/nest-schema": "*",
        "drizzle-orm": "catalog:database"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@nestjs/testing": "catalog:api:nest",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@repo/pkg-build": "*",
        "@types/bun": "catalog:build",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
