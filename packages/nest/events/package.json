{
    "name": "@repo/nest-events",
    "version": "1.0.0",
    "description": "NestJS + RxJS typed event system with Zod validation. Provides BaseEventService, EventContractBuilder, BasePooledEventService, and stream pool utilities.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@repo/type-guards": "*",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@types/node": "catalog:build",
        "eslint": "catalog:linting",
        "typescript": "catalog:build",
        "vitest": "catalog:testing",
        "chokidar": "catalog:build",
        "rimraf": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "module": "./dist/esm/index.mjs"
}
