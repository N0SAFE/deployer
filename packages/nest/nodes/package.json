{
    "name": "@deployer/nest-nodes",
    "version": "1.0.0",
    "description": "Local node-state (SQLite) repositories and the swarm node-label vocabulary. The pre-setup source of truth for the cluster decision.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./node-config.repository": {
            "types": "./dist/types/node-config.repository.d.ts",
            "import": "./dist/esm/node-config.repository.mjs",
            "require": "./dist/cjs/node-config.repository.js"
        },
        "./cluster-node.repository": {
            "types": "./dist/types/cluster-node.repository.d.ts",
            "import": "./dist/esm/cluster-node.repository.mjs",
            "require": "./dist/cjs/cluster-node.repository.js"
        },
        "./cluster-node-inventory.repository": {
            "types": "./dist/types/cluster-node-inventory.repository.d.ts",
            "import": "./dist/esm/cluster-node-inventory.repository.mjs",
            "require": "./dist/cjs/cluster-node-inventory.repository.js"
        },
        "./swarm-node-labels": {
            "types": "./dist/types/swarm-node-labels.d.ts",
            "import": "./dist/esm/swarm-node-labels.mjs",
            "require": "./dist/cjs/swarm-node-labels.js"
        },
        "./nodes.module": {
            "types": "./dist/types/nodes.module.d.ts",
            "import": "./dist/esm/nodes.module.mjs",
            "require": "./dist/cjs/nodes.module.js"
        }
    },
    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@deployer/contracts-entities": "*",
        "@deployer/errors": "*",
        "@deployer/nest-database-local": "*",
        "@deployer/nest-schema": "*",
        "@deployer/type-guards": "*",
        "drizzle-orm": "catalog:database"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
