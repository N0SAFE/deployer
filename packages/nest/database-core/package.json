{
    "name": "@deployer/nest-database-core",
    "version": "1.0.0",
    "description": "Framework primitives for Drizzle-backed services: the abstract base database service and the connection DI tokens.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./base-database.service": {
            "types": "./dist/types/base-database.service.d.ts",
            "import": "./dist/esm/base-database.service.mjs",
            "require": "./dist/cjs/base-database.service.js"
        },
        "./database-connection": {
            "types": "./dist/types/database-connection.d.ts",
            "import": "./dist/esm/database-connection.mjs",
            "require": "./dist/cjs/database-connection.js"
        }
    },
    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@deployer/errors": "*",
        "@deployer/nest-schema": "*",
        "drizzle-orm": "catalog:database"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
