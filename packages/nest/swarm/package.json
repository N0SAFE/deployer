{
    "name": "@repo/nest-swarm",
    "version": "1.0.0",
    "description": "Swarm cluster primitives: init/join, participation policy, master election, fleet read-models. Drives the Docker engine API; reads no environment and ships no platform defaults.",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": [
                "./src/index.ts"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./swarm-config": {
            "types": [
                "./src/swarm-config.ts"
            ],
            "import": "./dist/esm/swarm-config.mjs",
            "require": "./dist/cjs/swarm-config.js"
        },
        "./services/swarm-cluster.service": {
            "types": [
                "./src/services/swarm-cluster.service.ts"
            ],
            "import": "./dist/esm/services/swarm-cluster.service.mjs",
            "require": "./dist/cjs/services/swarm-cluster.service.js"
        },
        "./services/swarm-participation.service": {
            "types": [
                "./src/services/swarm-participation.service.ts"
            ],
            "import": "./dist/esm/services/swarm-participation.service.mjs",
            "require": "./dist/cjs/services/swarm-participation.service.js"
        },
        "./services/swarm-bootstrap.service": {
            "types": [
                "./src/services/swarm-bootstrap.service.ts"
            ],
            "import": "./dist/esm/services/swarm-bootstrap.service.mjs",
            "require": "./dist/cjs/services/swarm-bootstrap.service.js"
        },
        "./services/swarm-join-grant.service": {
            "types": [
                "./src/services/swarm-join-grant.service.ts"
            ],
            "import": "./dist/esm/services/swarm-join-grant.service.mjs",
            "require": "./dist/cjs/services/swarm-join-grant.service.js"
        },
        "./services/swarm-fleet.service": {
            "types": [
                "./src/services/swarm-fleet.service.ts"
            ],
            "import": "./dist/esm/services/swarm-fleet.service.mjs",
            "require": "./dist/cjs/services/swarm-fleet.service.js"
        },
        "./services/node-placement.service": {
            "types": [
                "./src/services/node-placement.service.ts"
            ],
            "import": "./dist/esm/services/node-placement.service.mjs",
            "require": "./dist/cjs/services/node-placement.service.js"
        },
        "./election/swarm-leadership.service": {
            "types": [
                "./src/election/swarm-leadership.service.ts"
            ],
            "import": "./dist/esm/election/swarm-leadership.service.mjs",
            "require": "./dist/cjs/election/swarm-leadership.service.js"
        },
        "./election/master-scorer": {
            "types": [
                "./src/election/master-scorer.ts"
            ],
            "import": "./dist/esm/election/master-scorer.mjs",
            "require": "./dist/cjs/election/master-scorer.js"
        },
        "./election/quorum-planner": {
            "types": [
                "./src/election/quorum-planner.ts"
            ],
            "import": "./dist/esm/election/quorum-planner.mjs",
            "require": "./dist/cjs/election/quorum-planner.js"
        },
        "./swarm.module": {
            "types": [
                "./src/swarm.module.ts"
            ],
            "import": "./dist/esm/swarm.module.mjs",
            "require": "./dist/cjs/swarm.module.js"
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@repo/contracts-entities": "*",
        "@repo/errors": "*",
        "@repo/nest-docker": "*",
        "@repo/nest-nodes": "*",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@nestjs/testing": "catalog:api:nest",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@repo/nest-schema": "*",
        "@repo/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
