{
    "name": "@deployer/nest-docker",
    "version": "1.0.0",
    "description": "Docker engine primitives: containers, swarm services, networks, volumes, and the swarm-spec translation. Knows how to drive Docker, never what to run.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./docker-config": {
            "types": "./dist/types/docker-config.d.ts",
            "import": "./dist/esm/docker-config.mjs",
            "require": "./dist/cjs/docker-config.js"
        },
        "./services/docker.service": {
            "types": "./dist/types/services/docker.service.d.ts",
            "import": "./dist/esm/services/docker.service.mjs",
            "require": "./dist/cjs/services/docker.service.js"
        },
        "./services/abstract-docker-container.service": {
            "types": "./dist/types/services/abstract-docker-container.service.d.ts",
            "import": "./dist/esm/services/abstract-docker-container.service.mjs",
            "require": "./dist/cjs/services/abstract-docker-container.service.js"
        },
        "./services/base-docker-supervisor.service": {
            "types": "./dist/types/services/base-docker-supervisor.service.d.ts",
            "import": "./dist/esm/services/base-docker-supervisor.service.mjs",
            "require": "./dist/cjs/services/base-docker-supervisor.service.js"
        },
        "./services/container-link-resolver.interface": {
            "types": "./dist/types/services/container-link-resolver.interface.d.ts",
            "import": "./dist/esm/services/container-link-resolver.interface.mjs",
            "require": "./dist/cjs/services/container-link-resolver.interface.js"
        },
        "./services/docker-host-address": {
            "types": "./dist/types/services/docker-host-address.d.ts",
            "import": "./dist/esm/services/docker-host-address.mjs",
            "require": "./dist/cjs/services/docker-host-address.js"
        },
        "./services/docker-supervisor-runtime": {
            "types": "./dist/types/services/docker-supervisor-runtime.d.ts",
            "import": "./dist/esm/services/docker-supervisor-runtime.mjs",
            "require": "./dist/cjs/services/docker-supervisor-runtime.js"
        },
        "./services/swarm-spec.mapper": {
            "types": "./dist/types/services/swarm-spec.mapper.d.ts",
            "import": "./dist/esm/services/swarm-spec.mapper.mjs",
            "require": "./dist/cjs/services/swarm-spec.mapper.js"
        },
        "./services/scanner-container-manager.service": {
            "types": "./dist/types/services/scanner-container-manager.service.d.ts",
            "import": "./dist/esm/services/scanner-container-manager.service.mjs",
            "require": "./dist/cjs/services/scanner-container-manager.service.js"
        },
        "./containers/postgres/postgres-service.provisioner": {
            "types": "./dist/types/containers/postgres/postgres-service.provisioner.d.ts",
            "import": "./dist/esm/containers/postgres/postgres-service.provisioner.mjs",
            "require": "./dist/cjs/containers/postgres/postgres-service.provisioner.js"
        },
        "./docker.module": {
            "types": "./dist/types/docker.module.d.ts",
            "import": "./dist/esm/docker.module.mjs",
            "require": "./dist/cjs/docker.module.js"
        }
    },
    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@deployer/contracts-entities": "*",
        "@deployer/errors": "*",
        "@deployer/nest-supervisor-core": "*",
        "@deployer/type-guards": "*",
        "dockerode": "catalog:utils",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "@types/bun": "catalog:build",
        "@types/dockerode": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "class-transformer": "^0.5.1",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
