{
    "name": "@repo/nest-docker",
    "version": "1.0.0",
    "description": "Docker engine primitives: containers, swarm services, networks, volumes, and the swarm-spec translation. Knows how to drive Docker, never what to run.",
    "main": "./dist/cjs/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": { "types": ["./src/index.ts"], "import": "./dist/esm/index.mjs", "require": "./dist/cjs/index.js" },
        "./docker-config": { "types": ["./src/docker-config.ts"], "import": "./dist/esm/docker-config.mjs", "require": "./dist/cjs/docker-config.js" },
        "./services/docker.service": { "types": ["./src/services/docker.service.ts"], "import": "./dist/esm/services/docker.service.mjs", "require": "./dist/cjs/services/docker.service.js" },
        "./services/abstract-docker-container.service": { "types": ["./src/services/abstract-docker-container.service.ts"], "import": "./dist/esm/services/abstract-docker-container.service.mjs", "require": "./dist/cjs/services/abstract-docker-container.service.js" },
        "./services/base-docker-supervisor.service": { "types": ["./src/services/base-docker-supervisor.service.ts"], "import": "./dist/esm/services/base-docker-supervisor.service.mjs", "require": "./dist/cjs/services/base-docker-supervisor.service.js" },
        "./services/container-link-resolver.interface": { "types": ["./src/services/container-link-resolver.interface.ts"], "import": "./dist/esm/services/container-link-resolver.interface.mjs", "require": "./dist/cjs/services/container-link-resolver.interface.js" },
        "./services/docker-supervisor-runtime": { "types": ["./src/services/docker-supervisor-runtime.ts"], "import": "./dist/esm/services/docker-supervisor-runtime.mjs", "require": "./dist/cjs/services/docker-supervisor-runtime.js" },
        "./services/swarm-spec.mapper": { "types": ["./src/services/swarm-spec.mapper.ts"], "import": "./dist/esm/services/swarm-spec.mapper.mjs", "require": "./dist/cjs/services/swarm-spec.mapper.js" },
        "./services/scanner-container-manager.service": { "types": ["./src/services/scanner-container-manager.service.ts"], "import": "./dist/esm/services/scanner-container-manager.service.mjs", "require": "./dist/cjs/services/scanner-container-manager.service.js" },
        "./containers/postgres/postgres-service.provisioner": { "types": ["./src/containers/postgres/postgres-service.provisioner.ts"], "import": "./dist/esm/containers/postgres/postgres-service.provisioner.mjs", "require": "./dist/cjs/containers/postgres/postgres-service.provisioner.js" }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache --concurrency=auto",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@repo/contracts-entities": "*",
        "@repo/errors": "*",
        "@repo/nest-supervisor-core": "*",
        "@repo/type-guards": "*",
        "dockerode": "catalog:utils",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@repo/pkg-build": "*",
        "@types/dockerode": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
