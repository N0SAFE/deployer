    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types",
        "db:generate": "bun run db:global:generate && bun run db:local:generate",
        "db:push": "bun run db:global:push && bun run db:local:push",
        "db:studio": "bun run db:global:studio",
        "db:global:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:global:push": "drizzle-kit push --config=drizzle.config.ts",
        "db:global:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "db:local:generate": "drizzle-kit generate --config=drizzle.config.local.ts",
        "db:local:push": "drizzle-kit push --config=drizzle.config.local.ts",
        "db:local:studio": "drizzle-kit studio --config=drizzle.config.local.ts"
    },
