{
    "name": "@repo/nest-schema",
    "version": "1.0.0",
    "description": "Drizzle table definitions for the local (SQLite) and global (Postgres) databases, plus the custom column codecs the app configures at boot.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./codecs/codec-registry": {
            "types": "./dist/types/codecs/codec-registry.d.ts",
            "import": "./dist/esm/codecs/codec-registry.mjs",
            "require": "./dist/cjs/codecs/codec-registry.js"
        },
        "./local": {
            "types": "./dist/types/local/index.d.ts",
            "import": "./dist/esm/local/index.mjs",
            "require": "./dist/cjs/local/index.js"
        },
        "./local/cluster-master-history": {
            "types": "./dist/types/local/cluster-master-history.d.ts",
            "import": "./dist/esm/local/cluster-master-history.mjs",
            "require": "./dist/cjs/local/cluster-master-history.js"
        },
        "./local/cluster-node": {
            "types": "./dist/types/local/cluster-node.d.ts",
            "import": "./dist/esm/local/cluster-node.mjs",
            "require": "./dist/cjs/local/cluster-node.js"
        },
        "./local/cluster-nodes": {
            "types": "./dist/types/local/cluster-nodes.d.ts",
            "import": "./dist/esm/local/cluster-nodes.mjs",
            "require": "./dist/cjs/local/cluster-nodes.js"
        },
        "./local/node-config": {
            "types": "./dist/types/local/node-config.d.ts",
            "import": "./dist/esm/local/node-config.mjs",
            "require": "./dist/cjs/local/node-config.js"
        },
        "./local/node-mesh-config": {
            "types": "./dist/types/local/node-mesh-config.d.ts",
            "import": "./dist/esm/local/node-mesh-config.mjs",
            "require": "./dist/cjs/local/node-mesh-config.js"
        },
        "./local/platform-settings": {
            "types": "./dist/types/local/platform-settings.d.ts",
            "import": "./dist/esm/local/platform-settings.mjs",
            "require": "./dist/cjs/local/platform-settings.js"
        },
        "./global": {
            "types": "./dist/types/global/index.d.ts",
            "import": "./dist/esm/global/index.mjs",
            "require": "./dist/cjs/global/index.js"
        },
        "./global/analytics": {
            "types": "./dist/types/global/analytics.d.ts",
            "import": "./dist/esm/global/analytics.mjs",
            "require": "./dist/cjs/global/analytics.js"
        },
        "./global/app-config": {
            "types": "./dist/types/global/app-config.d.ts",
            "import": "./dist/esm/global/app-config.mjs",
            "require": "./dist/cjs/global/app-config.js"
        },
        "./global/auth": {
            "types": "./dist/types/global/auth.d.ts",
            "import": "./dist/esm/global/auth.mjs",
            "require": "./dist/cjs/global/auth.js"
        },
        "./global/cluster-migration-state": {
            "types": "./dist/types/global/cluster-migration-state.d.ts",
            "import": "./dist/esm/global/cluster-migration-state.mjs",
            "require": "./dist/cjs/global/cluster-migration-state.js"
        },
        "./global/cluster": {
            "types": "./dist/types/global/cluster.d.ts",
            "import": "./dist/esm/global/cluster.mjs",
            "require": "./dist/cjs/global/cluster.js"
        },
        "./global/deployment.schemas": {
            "types": "./dist/types/global/deployment.schemas.d.ts",
            "import": "./dist/esm/global/deployment.schemas.mjs",
            "require": "./dist/cjs/global/deployment.schemas.js"
        },
        "./global/deployment": {
            "types": "./dist/types/global/deployment.d.ts",
            "import": "./dist/esm/global/deployment.mjs",
            "require": "./dist/cjs/global/deployment.js"
        },
        "./global/dns-providers": {
            "types": "./dist/types/global/dns-providers.d.ts",
            "import": "./dist/esm/global/dns-providers.mjs",
            "require": "./dist/cjs/global/dns-providers.js"
        },
        "./global/docker-runtime-activity": {
            "types": "./dist/types/global/docker-runtime-activity.d.ts",
            "import": "./dist/esm/global/docker-runtime-activity.mjs",
            "require": "./dist/cjs/global/docker-runtime-activity.js"
        },
        "./global/docker-security-scan": {
            "types": "./dist/types/global/docker-security-scan.d.ts",
            "import": "./dist/esm/global/docker-security-scan.mjs",
            "require": "./dist/cjs/global/docker-security-scan.js"
        },
        "./global/domain": {
            "types": "./dist/types/global/domain.d.ts",
            "import": "./dist/esm/global/domain.mjs",
            "require": "./dist/cjs/global/domain.js"
        },
        "./global/environment": {
            "types": "./dist/types/global/environment.d.ts",
            "import": "./dist/esm/global/environment.mjs",
            "require": "./dist/cjs/global/environment.js"
        },
        "./global/events": {
            "types": "./dist/types/global/events.d.ts",
            "import": "./dist/esm/global/events.mjs",
            "require": "./dist/cjs/global/events.js"
        },
        "./global/github-provider": {
            "types": "./dist/types/global/github-provider.d.ts",
            "import": "./dist/esm/global/github-provider.mjs",
            "require": "./dist/cjs/global/github-provider.js"
        },
        "./global/gitlab-provider": {
            "types": "./dist/types/global/gitlab-provider.d.ts",
            "import": "./dist/esm/global/gitlab-provider.mjs",
            "require": "./dist/cjs/global/gitlab-provider.js"
        },
        "./global/health": {
            "types": "./dist/types/global/health.d.ts",
            "import": "./dist/esm/global/health.mjs",
            "require": "./dist/cjs/global/health.js"
        },
        "./global/image-project-membership": {
            "types": "./dist/types/global/image-project-membership.d.ts",
            "import": "./dist/esm/global/image-project-membership.mjs",
            "require": "./dist/cjs/global/image-project-membership.js"
        },
        "./global/node-network-config": {
            "types": "./dist/types/global/node-network-config.d.ts",
            "import": "./dist/esm/global/node-network-config.mjs",
            "require": "./dist/cjs/global/node-network-config.js"
        },
        "./global/permissions": {
            "types": "./dist/types/global/permissions.d.ts",
            "import": "./dist/esm/global/permissions.mjs",
            "require": "./dist/cjs/global/permissions.js"
        },
        "./global/project-scan-config": {
            "types": "./dist/types/global/project-scan-config.d.ts",
            "import": "./dist/esm/global/project-scan-config.mjs",
