        },
        "./global/runtime": {
            "types": "./dist/types/global/runtime.d.ts",
            "import": "./dist/esm/global/runtime.mjs",
            "require": "./dist/cjs/global/runtime.js"
        },
        "./global/schema-version": {
            "types": "./dist/types/global/schema-version.d.ts",
            "import": "./dist/esm/global/schema-version.mjs",
            "require": "./dist/cjs/global/schema-version.js"
        },
        "./global/seed-version": {
            "types": "./dist/types/global/seed-version.d.ts",
            "import": "./dist/esm/global/seed-version.mjs",
            "require": "./dist/cjs/global/seed-version.js"
        },
        "./global/utils/zod-enum": {
            "types": "./dist/types/global/utils/zod-enum.d.ts",
            "import": "./dist/esm/global/utils/zod-enum.mjs",
            "require": "./dist/cjs/global/utils/zod-enum.js"
        },
        "./global/platform/app-instance": {
            "types": "./dist/types/global/platform/app-instance.d.ts",
            "import": "./dist/esm/global/platform/app-instance.mjs",
            "require": "./dist/cjs/global/platform/app-instance.js"
        },
        "./global/traefik": {
            "types": "./dist/types/global/traefik/index.d.ts",
            "import": "./dist/esm/global/traefik/index.mjs",
            "require": "./dist/cjs/global/traefik/index.js"
        },
        "./migrations": {
            "types": "./dist/types/migrations.d.ts",
            "import": "./dist/esm/migrations.mjs",
            "require": "./dist/cjs/migrations.js"
        }
    },
    "pkgBuild": {
        "root": "src",
        "copy": [
            {
                "from": "migrations",
                "to": "dist/migrations"
            }
        ]
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@repo/auth": "*",
        "@repo/contracts-common": "*",
        "@repo/contracts-entities": "*",
        "@repo/errors": "*",
        "drizzle-orm": "catalog:database",
        "drizzle-zod": "catalog:database",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@repo/config-vitest": "*",
        "@repo/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
