{
    "name": "@deployer/nest-supervisor-core",
    "version": "1.0.0",
    "description": "Supervisor framework: converge/probe lifecycle, registry, orchestrator and RxJS event bus. Knows how to supervise, never what.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        },
        "./base-supervisor.service": {
            "types": "./dist/types/base-supervisor.service.d.ts",
            "import": "./dist/esm/base-supervisor.service.mjs",
            "require": "./dist/cjs/base-supervisor.service.js"
        },
        "./base-multi-supervisor.service": {
            "types": "./dist/types/base-multi-supervisor.service.d.ts",
            "import": "./dist/esm/base-multi-supervisor.service.mjs",
            "require": "./dist/cjs/base-multi-supervisor.service.js"
        },
        "./supervisor-event.bus": {
            "types": "./dist/types/supervisor-event.bus.d.ts",
            "import": "./dist/esm/supervisor-event.bus.mjs",
            "require": "./dist/cjs/supervisor-event.bus.js"
        },
        "./supervisor-orchestrator.service": {
            "types": "./dist/types/supervisor-orchestrator.service.d.ts",
            "import": "./dist/esm/supervisor-orchestrator.service.mjs",
            "require": "./dist/cjs/supervisor-orchestrator.service.js"
        },
        "./supervisor-process-info": {
            "types": "./dist/types/supervisor-process-info.d.ts",
            "import": "./dist/esm/supervisor-process-info.mjs",
            "require": "./dist/cjs/supervisor-process-info.js"
        },
        "./supervisors.module": {
            "types": "./dist/types/supervisors.module.d.ts",
            "import": "./dist/esm/supervisors.module.mjs",
            "require": "./dist/cjs/supervisors.module.js"
        }
    },
    "scripts": {
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "lint": "bun lint --no-script --type-aware",
        "lint:fix": "bun lint --no-script --fix --type-aware",
        "lint:fix+": "bun lint --no-script --fix-suggestions --type-aware",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "bun --bun pkg-build",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun pkg-build --types"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "rxjs": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:api:nest"
    },
    "devDependencies": {
        "@deployer/config-eslint": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-typescript": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "@types/node": "catalog:build",
        "chokidar": "catalog:build",
        "eslint": "catalog:linting",
        "rimraf": "catalog:build",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "module": "./dist/esm/index.mjs"
}
