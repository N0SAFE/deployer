{
    "extends": "../../../tooling/typescript/config/react-library.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "target": "ES2020",
        "lib": [
            "ES2022",
            "dom",
            "dom.iterable"
        ],
        "noEmit": true,
        "paths": {
            "@deployer/declarative-routing/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "pkg-build.config.ts", "src/**/*",
        "eslint.config.ts"
    ]
}
