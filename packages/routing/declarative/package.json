{
    "name": "@repo/declarative-routing",
    "version": "0.1.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "main": "./dist/production/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "development": {
                "import": "./dist/development/esm/index.mjs",
                "require": "./dist/development/cjs/index.js"
            },
            "production": {
                "import": "./dist/production/esm/index.mjs",
                "require": "./dist/production/cjs/index.js"
            },
            "default": {
                "import": "./dist/production/esm/index.mjs",
                "require": "./dist/production/cjs/index.js"
            }
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "development": {
                "import": "./dist/development/esm/*.mjs",
                "require": "./dist/development/cjs/*.js"
            },
            "production": {
                "import": "./dist/production/esm/*.mjs",
                "require": "./dist/production/cjs/*.js"
            },
            "default": {
                "import": "./dist/production/esm/*.mjs",
                "require": "./dist/production/cjs/*.js"
            }
        },
        "./hooks": {
            "types": "./dist/types/hooks.d.ts",
            "development": {
                "import": "./dist/development/esm/hooks.mjs",
                "require": "./dist/development/cjs/hooks.js"
            },
            "production": {
                "import": "./dist/production/esm/hooks.mjs",
                "require": "./dist/production/cjs/hooks.js"
            },
            "default": {
                "import": "./dist/production/esm/hooks.mjs",
                "require": "./dist/production/cjs/hooks.js"
            }
        },
        "./utils": {
            "types": "./dist/types/utils.d.ts",
            "development": {
                "import": "./dist/development/esm/utils.mjs",
                "require": "./dist/development/cjs/utils.js"
            },
            "production": {
                "import": "./dist/production/esm/utils.mjs",
                "require": "./dist/production/cjs/utils.js"
            },
            "default": {
                "import": "./dist/production/esm/utils.mjs",
                "require": "./dist/production/cjs/utils.js"
            }
        },
        "./page-wrappers": {
            "react-server": {
                "types": "./dist/types/page-wrappers/server.d.ts",
                "development": {
                    "import": "./dist/development/esm/page-wrappers/server.mjs",
                    "require": "./dist/development/cjs/page-wrappers/server.js"
                },
                "production": {
                    "import": "./dist/production/esm/page-wrappers/server.mjs",
                    "require": "./dist/production/cjs/page-wrappers/server.js"
                },
                "default": {
                    "import": "./dist/production/esm/page-wrappers/server.mjs",
                    "require": "./dist/production/cjs/page-wrappers/server.js"
                }
            },
            "default": {
                "types": "./dist/types/page-wrappers/client.d.ts",
                "development": {
                    "import": "./dist/development/esm/page-wrappers/client.mjs",
                    "require": "./dist/development/cjs/page-wrappers/client.js"
                },
                "production": {
                    "import": "./dist/production/esm/page-wrappers/client.mjs",
                    "require": "./dist/production/cjs/page-wrappers/client.js"
                },
                "default": {
                    "import": "./dist/production/esm/page-wrappers/client.mjs",
                    "require": "./dist/production/cjs/page-wrappers/client.js"
                }
            }
        },
        "./page-wrappers/server": {
            "types": "./dist/types/page-wrappers/server.d.ts",
            "development": {
                "import": "./dist/development/esm/page-wrappers/server.mjs",
                "require": "./dist/development/cjs/page-wrappers/server.js"
            },
            "production": {
                "import": "./dist/production/esm/page-wrappers/server.mjs",
                "require": "./dist/production/cjs/page-wrappers/server.js"
            },
            "default": {
                "import": "./dist/production/esm/page-wrappers/server.mjs",
                "require": "./dist/production/cjs/page-wrappers/server.js"
            }
        },
        "./page-wrappers/client": {
            "types": "./dist/types/page-wrappers/client.d.ts",
            "development": {
                "import": "./dist/development/esm/page-wrappers/client.mjs",
                "require": "./dist/development/cjs/page-wrappers/client.js"
            },
            "production": {
                "import": "./dist/production/esm/page-wrappers/client.mjs",
                "require": "./dist/production/cjs/page-wrappers/client.js"
            },
            "default": {
                "import": "./dist/production/esm/page-wrappers/client.mjs",
                "require": "./dist/production/cjs/page-wrappers/client.js"
            }
        },
        "./layout-wrappers": {
            "types": "./dist/types/layout-wrappers/index.d.ts",
            "development": {
                "import": "./dist/development/esm/layout-wrappers/index.mjs",
                "require": "./dist/development/cjs/layout-wrappers/index.js"
            },
            "production": {
                "import": "./dist/production/esm/layout-wrappers/index.mjs",
                "require": "./dist/production/cjs/layout-wrappers/index.js"
            },
            "default": {
                "import": "./dist/production/esm/layout-wrappers/index.mjs",
                "require": "./dist/production/cjs/layout-wrappers/index.js"
            }
        },
        "./layout-wrappers/server": {
            "types": "./dist/types/layout-wrappers/server.d.ts",
            "development": {
                "import": "./dist/development/esm/layout-wrappers/server.mjs",
                "require": "./dist/development/cjs/layout-wrappers/server.js"
            },
            "production": {
                "import": "./dist/production/esm/layout-wrappers/server.mjs",
                "require": "./dist/production/cjs/layout-wrappers/server.js"
            },
            "default": {
                "import": "./dist/production/esm/layout-wrappers/server.mjs",
                "require": "./dist/production/cjs/layout-wrappers/server.js"
            }
        }
    },
    "scripts": {
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "lint": "eslint . --fix --cache",
        "type-check": "tsc --noEmit",
        "build": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js",
        "dev": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --watch",
        "clean": "rimraf dist",
        "build:types": "bun --bun ../../../tooling/bin-pkg-build/dist/cjs/main.js --types"
    },
    "dependencies": {
        "@repo/type-guards": "*",
        "nuqs": "catalog:web",
        "query-string": "catalog:utils",
        "zod": "catalog:utils"
    },
    "peerDependencies": {
        "@repo/auth": "*",
        "@tanstack/react-query": ">=5.0.0",
        "next": ">=16.1.2",
        "nprogress": ">=0.2.0",
        "react": ">=19.2.8"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": true
        },
        "nprogress": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "catalog:build",
        "@repo/auth": "*",
        "@repo/use-safe-query-param-states-from-zod": "*",
        "@repo/config-eslint": "*",
        "@repo/config-prettier": "*",
        "@repo/config-typescript": "*",
        "@types/nprogress": "catalog:web",
        "@types/react": "catalog:react",
        "eslint": "catalog:linting",
        "server-only": "catalog:utils",
        "typescript": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "module": "./dist/production/esm/index.mjs"
}
