{
    "name": "@repo/config-vitest",
    "version": "1.0.0",
    "private": true,
    "description": "Shared Vitest configuration for the monorepo",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./src/index.ts",
    "type": "module",
    "pkgBuild": {
        "root": "src",
        "formats": [
            "esm",
            "cjs"
        ]
    },
    "exports": {
        ".": {
            "types": [
                "./src/index.ts",
                "./src/index.tsx"
            ],
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": [
                "./src/*.ts",
                "./src/*.tsx"
            ],
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "bun --bun ../../bin/pkg-build/index.ts",
        "compile": "bun --bun ../../bin/pkg-build/index.ts",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "clean": "rimraf dist",
        "type-check": "tsc --noEmit",
        "test": "echo 'vitest-config package ready'",
        "dev": "bun --bun ../../bin/pkg-build/index.ts --watch"
    },
    "keywords": [
        "vitest",
        "testing",
        "config"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "chokidar": "catalog:build",
        "@testing-library/jest-dom": "catalog:testing",
        "@testing-library/react": "catalog:testing",
        "@testing-library/user-event": "catalog:testing",
        "@types/node": "catalog:build",
        "@vitejs/plugin-react": "catalog:testing",
        "jsdom": "catalog:testing",
        "vitest": "catalog:testing",
        "typescript": "catalog:build",
        "rimraf": "catalog:build",
        "@repo/pkg-build": "*"
    },
    "dependencies": {}
}
