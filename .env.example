# Project Configuration
COMPOSE_PROJECT_NAME=nextjs-nestjs

# ========================================
# API-Centric Platform Deployment
# ========================================
# Hostname grammar prefix for the platform Traefik ingress:
#   empty  → api.deployer.localhost   / web.deployer.localhost
#   "acme" → api.acme.deployer.localhost / app.acme.deployer.localhost
DEPLOYER_PREFIX=
# Parent domain for the session cookie — shared between the api.* and web.*
# subdomains (traefik-first). Over HTTP the cookie is NOT Secure by default.
AUTH_BASE_DOMAIN=.deployer.localhost

# Image for the API-supervised platform Traefik container.
DEPLOYER_TRAEFIK_IMAGE=traefik:v3.3
# DEPLOYER_TRAEFIK_TLS_ENABLED=false   # adds websecure:443 + HTTP->HTTPS redirect (self-signed default cert)
# DEPLOYER_REDIS_URL=redis://deployer-redis:6379  # supervised by the API (RedisSupervisorService) — headless on the platform network
# DEPLOYER_REDIS_IMAGE=redis:7-alpine
# DEPLOYER_REDIS_PORT=6379    # optional host bind for debugging
# DEPLOYER_REDIS_PASSWORD=

# Managed web app (PROD tier only — the API spawns/supervises it).
# In dev and prod-like, the web is compose-managed and the API gets
# MANAGED_WEB_APP_EXTERNAL=true from those compose files instead.
MANAGED_WEB_APP_ENABLED=true
# Build once from the repo root (or point at a registry image):
#   docker build -f docker/builder/web/Dockerfile.web.runtime.prod \
#     -t deployer-web:latest .
MANAGED_WEB_APP_IMAGE=deployer-web:latest

# App-instance registration for BYO / compose-managed webs:
# credentials of ANY account on the target API; used once at boot, the minted
# token persists in a volume.
# DEPLOYER_INSTANCE_LABEL=my-web
# DEPLOYER_INSTANCE_EMAIL=admin@admin.com
# DEPLOYER_INSTANCE_PASSWORD=adminadmin

# API Configuration
NEXT_PUBLIC_API_URL=http://api.deployer.localhost
API_PORT=3001

# App Configuration
# Traefik-first: web is served by the platform ingress at web.<prefix>deployer.localhost.
NEXT_PUBLIC_APP_URL=http://web.deployer.localhost
NEXT_PUBLIC_APP_PORT=3000

# ========================================
# Database Configuration
# ========================================
# Database URL is NEVER read from the runtime environment.
# On first run, Phase 0 (SetupDevService) auto-provisions Postgres if
# SETUP_AUTO=true. To use an existing database, set
# SETUP_AUTO_DATABASE_URL (SETUP_DATABASE_URL kept as legacy alias).
#
# Set SETUP_AUTO=false to skip auto-provisioning and manually run setup:
#   bun --bun src/cli.ts setup-db --url="postgres://..."
#
# SETUP_AUTO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_api

# Setup auto-provisioning — when SETUP_AUTO=true:
#   - With SETUP_AUTO_DATABASE_URL: URL is PROBED; unreachable → boot FAILS
#     (no backoff, no local-only fallback — the global DB is mandatory)
#   - Without SETUP_AUTO_DATABASE_URL: auto-provisions Postgres via dockerode
# The app NEVER runs without a global Postgres database, even in dev.
# Default: false
#
# ⚠️ In the DEV COMPOSE profile the global Postgres is COMPOSE-MANAGED — the
#    orchestrator docker-compose.dev.yml sets MANAGED_GLOBAL_DB_ENABLED=true
#    and SETUP_AUTO=false; the API resolves the URL from MANAGED_GLOBAL_DB_*
#    and never spawns/supervises it. Only flip SETUP_AUTO=true when running the
#    API with API-owned database provisioning (dev-supervised / prod profiles).
SETUP_AUTO=false

# ========================================
# Compose-managed services (dev profile)
# ========================================
# When a platform service is owned by Docker Compose (dev profile), the API
# must NOT spawn or supervise it. The MANAGED_<SERVICE>_ENABLED flag tells the
# matching supervisor to SKIP entirely (no registration, no container). The
# MANAGED_<SERVICE>_<KEY> variables describe how to REACH the compose-managed
# service (host/port/credentials). They only take effect when the matching
# MANAGED_<SERVICE>_ENABLED is true. The zod check splits them into a nested
# `managed[service].key` shape via splitManagedEnv (in @repo/env).
#
# The ORCHESTRATOR compose file (docker-compose.dev.yml) declares all
# MANAGED_*_ENABLED=true + the shared network/volumes — you usually don't set
# these by hand; they are listed here for reference / manual overrides.
#
# Global Postgres (compose-managed `global-db` service):
#MANAGED_GLOBAL_DB_ENABLED=true
#MANAGED_GLOBAL_DB_URL=postgresql://deployer:deployer@global-db:5432/deployer
#MANAGED_GLOBAL_DB_HOST=global-db
#MANAGED_GLOBAL_DB_PORT=5432
#MANAGED_GLOBAL_DB_USER=deployer
#MANAGED_GLOBAL_DB_PASSWORD=deployer
#MANAGED_GLOBAL_DB_NAME=deployer
#MANAGED_GLOBAL_DB_IMAGE=postgres:16-alpine
#
# Redis (compose-managed `redis` service — dev only, never in prod compose):
#MANAGED_REDIS_ENABLED=true
#MANAGED_REDIS_URL=redis://redis:6379
#MANAGED_REDIS_HOST=redis
#MANAGED_REDIS_PORT=6379
#MANAGED_REDIS_PASSWORD=
#
# Local SQLite node db (compose-provisioned path/volume):
#MANAGED_LOCAL_DB_ENABLED=true
#MANAGED_LOCAL_DB_PATH=/app/data/local.db
#
# Traefik (externally-managed ingress):
#MANAGED_TRAEFIK_ENABLED=true
#MANAGED_TRAEFIK_HOST=traefik
#MANAGED_TRAEFIK_HTTP_PORT=80
#
# WireGuard sidecar (mesh private overlay — one sidecar per node):
# MANAGED_WIREGUARD_ENABLED=true means compose owns the sidecar; otherwise the
# supervisor creates one when an overlay IP is set.
#MANAGED_WIREGUARD_ENABLED=false
#MANAGED_WIREGUARD_IP=10.0.0.1
#MANAGED_WIREGUARD_NETWORK=10.0.0.0/24
#MANAGED_WIREGUARD_PRIVATE_KEY=
#MANAGED_WIREGUARD_PEERS=10.0.0.2|<pubkey>|mesh-node-2:51820
#MANAGED_WIREGUARD_PORT=51820
#MANAGED_WIREGUARD_IMAGE=linuxserver/wireguard:latest
#MANAGED_WIREGUARD_STATE_VOLUME=deployer-wireguard-state
#
# Database service primitive (scaled Postgres instances, reachable by alias):
#MANAGED_DATABASE_ENABLED=false
#MANAGED_DATABASE_INSTANCES=db-a,db-b
#MANAGED_DATABASE_HOST=database
#MANAGED_DATABASE_PORT=5432
#MANAGED_DATABASE_USER=deployer
#MANAGED_DATABASE_PASSWORD=deployer
#MANAGED_DATABASE_NAME=deployer
#MANAGED_DATABASE_IMAGE=postgres:16-alpine
#MANAGED_DATABASE_DATA_VOLUME_BASE=deployer-database-data

# Authentication
AUTH_SECRET=QgafJQw3O/k1gambz7YGKjtj5ZZe0dnL/WlSw4PtMDc=

# Default Admin User
# Created automatically on first startup if not exists
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=adminadmin

# Development specific
NODE_ENV=development

# Setup/bootstrap behavior in development
# true (default): after global migrations, the API ensures the default admin
# exists (DEFAULT_ADMIN_EMAIL / DEFAULT_ADMIN_PASSWORD). The compose-managed
# dev stack boots straight into the app (no setup wizard) and needs this to
# have credentials to sign in with.
# false: skips auto admin creation — complete setup via the wizard flow.
ENABLE_DEV_BOOTSTRAP=true

# Development Bearer Auth (DevTools / login-as)
# Keep these identical in development so client and API validate the same token.
DEV_AUTH_KEY=dev-secret-key-change-me
NEXT_PUBLIC_DEV_AUTH_KEY=dev-secret-key-change-me

# Optional: Development tools
MILLION_LINT=false
REACT_SCAN=false
NEXT_PUBLIC_SHOW_AUTH_LOGS=false

# Debug Configuration - Examples:
# Enable all middleware debugging:
# NEXT_PUBLIC_DEBUG=middleware/**

# Enable specific middleware:
# NEXT_PUBLIC_DEBUG=middleware/auth,middleware/env

# Enable with brace expansion:
# NEXT_PUBLIC_DEBUG=middleware/{auth,env,redirect}/**

# Enable only errors:
# NEXT_PUBLIC_DEBUG=middleware/*/error

# Debug specific patterns (uncomment to enable):
# NEXT_PUBLIC_DEBUG=middleware/**

# Context-filtered debug logs (single filter variable for API and shared loggers)
# Comma/space separated patterns (supports class:/method:/source:/target: + glob-like matching)
# Examples:
# APP_DEBUG_CONTEXT_FILTER=DockerRuntimeStreamOrchestratorService.stream
# APP_DEBUG_CONTEXT_FILTER=class:*Relay* method:observe
APP_DEBUG_CONTEXT_FILTER=
# Web containers map this to NEXT_PUBLIC_APP_DEBUG_CONTEXT_FILTER via docker-compose.

# Turbo Remote Cache Configuration (Optional)
# Obtain these from https://vercel.com/account/tokens
# TURBO_TOKEN=your-vercel-token-here
# TURBO_TEAM=your-team-name-or-username
# ========================================
# Cloudflare Tunnel (self-hosted deployer)
# ========================================
# Run token for the deployer platform's own Cloudflare tunnel ("global"
# tunnel). Get it from the Cloudflare app detail page → Tunnels tab → the
# global tunnel card → "Run token", or run once:
#   bun --bun run api -- tunnel:bootstrap
# which applies the ingress (hostname → web) and prints the token.
# Used by the `cloudflared` sidecar in docker/compose/deployer/
# docker-compose.deployer.yml.
CLOUDFLARE_TUNNEL_TOKEN=
# Ingress service target resolved by cloudflared for the tunnel hostname
# (default http://deployer-traefik:80 — the platform Traefik, which routes
# the configured domain → the API via dynamic-domain.yml. The node's global
# tunnel serves the API; the web app owns a separate surface).
CLOUDFLARE_TUNNEL_SERVICE_URL=

# ========================================
# Dev HMR origins (web app)
# ========================================
# Cross-site origins Next allows in dev mode (websockets/HMR). Set by the
# deployment — NEVER derived in next.config. Next rejects a bare '*' so use
# a hostname and/or a `*.{parent-domain}` wildcard:
#   - Compose-managed dev: docker/compose/web/docker-compose.web.dev.yml
#     defaults to web.deployer.localhost,*.deployer.localhost
#   - API-managed web: the supervisor injects the managed hostname + wildcard
#   - Override here to also allow a public/Tunnel origin, e.g.:
#     NEXT_ALLOWED_DEV_ORIGINS="deployer.sebille.net,*.sebille.net"
NEXT_ALLOWED_DEV_ORIGINS=
