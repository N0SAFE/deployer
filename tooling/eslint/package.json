{
    "name": "@deployer/config-eslint",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./library": {
            "types": "./dist/types/library.d.ts",
            "import": "./dist/library.mjs",
            "default": "./dist/library.mjs"
        },
        "./nextjs": {
            "types": "./dist/types/nextjs.d.ts",
            "import": "./dist/nextjs.mjs",
            "default": "./dist/nextjs.mjs"
        },
        "./nestjs": {
            "types": "./dist/types/nestjs.d.ts",
            "import": "./dist/nestjs.mjs",
            "default": "./dist/nestjs.mjs"
        },
        "./react": {
            "types": "./dist/types/react.d.ts",
            "import": "./dist/react.mjs",
            "default": "./dist/react.mjs"
        },
        "./architecture": {
            "types": "./dist/types/architecture.d.ts",
            "import": "./dist/architecture.mjs",
            "default": "./dist/architecture.mjs"
        },
        "./mdx": {
            "types": "./dist/types/mdx.d.ts",
            "import": "./dist/mdx.mjs",
            "default": "./dist/mdx.mjs"
        }
    },
    "scripts": {
        "build": "bun --bun pkg-build",
        "build:types": "bun --bun pkg-build --types",
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "type-check": "bun check --no-script",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "dev": "bun --bun pkg-build --watch",
        "clean": "rimraf dist"
    },
    "devDependencies": {
        "@darraghor/eslint-plugin-nestjs-typed": "^7.1.22",
        "@deployer/config-eslint-plugins-progress": "*",
        "@deployer/config-prettier": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "@eslint/compat": "^2.0.1",
        "@eslint/js": "catalog:linting",
        "@shadcn/lint": "catalog:linting",
        "@tanstack/eslint-plugin-query": "catalog:tanstack",
        "@types/node": "catalog:build",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vercel/style-guide": "^6.0.0",
        "babel-plugin-macros": "^3.1.0",
        "chokidar": "catalog:build",
        "eslint": "^10",
        "eslint-config-nestjs": "^0.8.0",
        "eslint-config-next": "catalog:next",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-turbo": "^2.10.11",
        "eslint-module-utils": "^2.14.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-mdx": "^3.6.2",
        "eslint-plugin-next": "^0.0.0",
        "eslint-plugin-only-warn": "^1.1.0",
        "eslint-plugin-react": "^7.34.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.0.0",
        "rimraf": "catalog:build",
        "tailwindcss": "catalog:styling",
        "typescript": "^6",
        "typescript-7-1": "npm:typescript@7.1.0-beta",
        "typescript-eslint": "^8.61.1",
        "vitest": "catalog:testing",
        "zod": "catalog:utils"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "dependencies": {}
}
