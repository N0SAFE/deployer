{
    "name": "@deployer/config-typescript",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "exports": {
        "./*": "./config/*.json",
        "./config/*": "./config/*"
    },
    "devDependencies": {
        "@deployer/config-prettier": "*",
        "@deployer/config-vitest": "*",
        "vitest": "catalog:testing",
        "typescript": "catalog:build"
    },
    "scripts": {
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "type-check": "bun check --no-script",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "test:coverage": "bun --bun vitest run --coverage"
    },
    "publishConfig": {
        "access": "public"
    }
}
