{
    "name": "@deployer/config-vitest",
    "version": "1.0.0",
    "private": true,
    "description": "Shared Vitest configuration for the monorepo",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/esm/*.mjs",
            "require": "./dist/cjs/*.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "bun --bun pkg-build",
        "compile": "bun --bun pkg-build",
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "clean": "rimraf dist",
        "type-check": "bun check --no-script",
        "test": "echo 'vitest-config package ready'",
        "dev": "bun --bun pkg-build --watch",
        "build:types": "bun --bun pkg-build --types"
    },
    "keywords": [
        "vitest",
        "testing",
        "config"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "chokidar": "catalog:build",
        "@testing-library/jest-dom": "catalog:testing",
        "@testing-library/react": "catalog:testing",
        "@testing-library/user-event": "catalog:testing",
        "@types/node": "catalog:build",
        "@vitejs/plugin-react": "catalog:testing",
        "jsdom": "catalog:testing",
        "vitest": "catalog:testing",
        "typescript": "catalog:build",
        "rimraf": "catalog:build",
        "@deployer/pkg-build": "*",
        "unplugin-swc": "^1.5.9"
    },
    "dependencies": {},
    "peerDependencies": {
        "unplugin-swc": "^1.5.9"
    }
}
