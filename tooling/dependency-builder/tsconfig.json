{
    "extends": "@deployer/config-typescript/nestjs",
    "compilerOptions": {
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "rootDir": ".",
        "outDir": "./dist",
        "types": ["node", "bun", "vitest/globals"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["pkg-build.config.ts", "src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
