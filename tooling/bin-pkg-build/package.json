{
    "name": "@deployer/pkg-build",
    "version": "1.0.0",
    "private": true,
    "description": "Shared configurable workspace package builder. Bundles package sources to ESM/CJS with bun (resolving tsconfig path aliases and emitting NestJS decorator metadata) and emits declarations to dist/types with tsc. Each package declares its build in a typed pkg-build.config.ts.",
    "type": "module",
    "bin": {
        "pkg-build": "./bin/pkg-build.mjs"
    },
    "exports": {
        "./config": {
            "types": "./dist/types/config.d.ts",
            "import": "./src/config.ts",
            "default": "./src/config.ts"
        }
    },
    "scripts": {
        "build": "bun --bun pkg-build.config.ts",
        "build:types": "bun --bun pkg-build.config.ts --types",
        "dev": "bun --bun pkg-build.config.ts --watch",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "type-check": "bun --check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@nestjs/core": "catalog:api:nest",
        "chokidar": "catalog:build",
        "nest-commander": "catalog:api:nest",
        "reflect-metadata": "catalog:api:nest",
        "zod": "catalog:utils"
    },
    "devDependencies": {
        "@types/bun": "catalog:build",
        "@types/node": "catalog:build",
        "prettier": "catalog:linting",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
