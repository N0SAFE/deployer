{
    "name": "@repo/pkg-build",
    "version": "1.0.0",
    "private": true,
    "description": "Shared configurable workspace package builder. Bundles package sources to ESM/CJS with bun (resolving tsconfig path aliases and emitting NestJS decorator metadata) and emits declarations to dist/types with tsc, driven by a `pkgBuild` block in each package.json.",
    "type": "module",
    "bin": {
        "pkg-build": "./dist/cjs/main.js"
    },
    "pkgBuild": {
        "root": "src",
        "entries": [
            "main.ts",
            "variant-child.ts"
        ],
        "formats": [
            "esm",
            "cjs"
        ],
        "target": "node",
        "splitting": false,
        "sourcemap": "external"
    },
    "scripts": {
        "build": "bun --bun src/main.ts",
        "build:types": "bun --bun src/main.ts --types",
        "dev": "bun --bun src/main.ts --watch",
        "start": "bun --bun dist/cjs/main.js",
        "prettify": "prettier . --write --no-error-on-unmatched-pattern",
        "format": "bun run prettify",
        "format:check": "prettier . --check --no-error-on-unmatched-pattern",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@nestjs/common": "catalog:api:nest",
        "@nestjs/core": "catalog:api:nest",
        "chokidar": "catalog:build",
        "nest-commander": "catalog:api:nest",
        "reflect-metadata": "catalog:api:nest"
    },
    "devDependencies": {
        "@types/bun": "catalog:build",
        "@types/node": "catalog:build",
        "prettier": "catalog:linting",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    }
}
