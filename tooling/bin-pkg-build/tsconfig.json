{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tooling/typescript/config/nestjs.json",
    "compilerOptions": {
        // Repeated from the shared config: bun resolves tsconfig `extends`
        // through package exports less completely than tsc, and a missing
        // `experimentalDecorators` makes every `@Option()` run through the
        // TC39 decorator path (descriptor undefined). Explicit here so both
        // the runtime (bun) and the compiler (tsc) agree.
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "./dist",
        "types": ["node", "bun"],
        // Self-reference so this package's own pkg-build.config.ts type-checks
        // without depending on its built `./config` export (which cannot exist
        // before the builder has been built once).
        //
        // No `rootDir`: `pkg-build.config.ts` sits beside `package.json`, and a
        // `rootDir: src` would reject it (TS6059). The declaration pass pins its
        // own `rootDir`, so nothing here needs one.
        "paths": {
            "@repo/pkg-build/config": ["./src/config.ts"]
        }
    },
    "include": ["src/**/*.ts", "pkg-build.config.ts"],
    "exclude": ["node_modules", "dist"]
}
