{
    "extends": "../typescript/config/base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "composite": false,
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "types": [
            "node",
            "vitest/globals"
        ],
        "paths": {
            "@deployer/runthenkill/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "__tests__/**/*.ts",
        "pkg-build.config.ts"
    ]
}
