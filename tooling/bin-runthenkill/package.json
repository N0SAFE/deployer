{
    "name": "@deployer/runthenkill",
    "version": "1.0.0",
    "description": "CLI tool to run a process and manage port state after termination",
    "main": "dist/index.js",
    "bin": {
        "runthenkill": "dist/index.js"
    },
    "scripts": {
        "build": "bun --bun pkg-build",
        "build:types": "bun --bun pkg-build --types",
        "dev": "bun --bun pkg-build --watch",
        "prettify": "bun fmt .",
        "format": "bun run prettify",
        "format:check": "bun fmt --check .",
        "type-check": "bun check --no-script",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [
        "cli",
        "port",
        "process",
        "kill"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@deployer/type-guards": "*",
        "commander": "catalog:utils"
    },
    "devDependencies": {
        "@deployer/config-prettier": "*",
        "@deployer/config-vitest": "*",
        "@deployer/pkg-build": "*",
        "vitest": "catalog:testing",
        "@types/node": "catalog:build",
        "typescript": "catalog:build"
    }
}
