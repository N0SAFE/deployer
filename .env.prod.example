# Production environment — EXAMPLE ONLY
#
# `.env.prod` is gitignored. This file is the committed template:
#
#   cp .env.prod.example .env.prod
#
# Every value below is a placeholder. Do not commit your filled-in `.env.prod`:
# it describes a real deployment (hostnames, compose project name, seeding).
#
# Seeding is OFF. Set ENABLE_SEEDING=true only for an environment you intend to
# populate with demo data — it creates users and sample projects.

# ====================================================================================
# PROJECT CONFIGURATION
# ====================================================================================
COMPOSE_PROJECT_NAME=deployer

# ====================================================================================
# DATABASE CONFIGURATION (External PostgreSQL)
# ====================================================================================
# DATABASE_URL is NEVER read at runtime. The URL flows through SQLite:
#   SETUP_DATABASE_URL → Phase 0 → SQLite node_config → GlobalDatabaseModule
# Set SETUP_AUTO=true and SETUP_DATABASE_URL to auto-configure on first start,
# or use the setup wizard manually (no env vars needed).
SETUP_DATABASE_URL=postgresql://user:password@host:port/database

# ====================================================================================
# API CONFIGURATION
# ====================================================================================
API_PORT=3001

# Public-facing API URL (accessible from the internet)
NEXT_PUBLIC_API_URL=https://api.example.com

# ====================================================================================
# WEB APP CONFIGURATION
# ====================================================================================
# Public-facing web app URL (accessible from the internet)
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_PORT=3000

# Note: APP_URL and API_URL are NOT needed in .env
# These are internal Docker network URLs automatically set in docker-compose files:
# - API_URL=http://${COMPOSE_PROJECT_NAME}-api-prod:${API_PORT}
# - APP_URL=http://${COMPOSE_PROJECT_NAME}-web-prod:${NEXT_PUBLIC_APP_PORT}

# ====================================================================================
# SECURITY & AUTHENTICATION
# ====================================================================================
# Auth secret for authentication (generate a strong random string)
# Use: openssl rand -base64 32
AUTH_SECRET=your-secure-auth-secret-here

# Encryption root for secrets stored in the database (GitHub/GitLab/DNS credentials,
# environment variables, ...). At least 32 random characters, e.g. `openssl rand -base64 48`.
# When unset, AUTH_SECRET is used. Production REFUSES to boot with a missing, short or
# placeholder value. Existing rows are re-encrypted with the reseal command (see
# docs/runbooks/secrets-encryption.md).
# DEPLOYER_ROOT_SECRET=

# Outbound probes (domain reachability, public-IP lookup, peer checks, post-deploy probe)
# refuse loopback, link-local and cloud-metadata targets, and refuse private ranges for
# user-supplied domains. Set to true to let user-supplied domains resolve to private ranges
# (LAN-only domains); loopback/link-local/metadata stay refused. Default: false in production,
# true elsewhere (so *.localhost domains work in development).
# DEPLOYER_ALLOW_PRIVATE_PROBES=false

# Better Auth secret (should match AUTH_SECRET)
BETTER_AUTH_SECRET=your-secure-auth-secret-here

# Optional: Development auth key (leave empty for production or set same as AUTH_SECRET)
DEV_AUTH_KEY=

# Trusted origins for CORS (comma-separated list)
# Should include your web app URL
TRUSTED_ORIGINS=https://the-gossip-club.sebille.net

# ====================================================================================
# ADMIN USER SEEDING
# ====================================================================================
# Default admin user credentials (used for initial setup)
DEFAULT_ADMIN_EMAIL=admin@sebille.net
DEFAULT_ADMIN_PASSWORD=change-this-strong-password

# Enable/disable seeding (set to false after initial setup)
ENABLE_SEEDING=false

# ====================================================================================
# DEPRECATED/UNUSED VARIABLES
# ====================================================================================
# These variables are present but may not be used in production
# JWT_SECRET - May be deprecated in favor of AUTH_SECRET
# API_ADMIN_TOKEN - Verify if this is still used in your API
