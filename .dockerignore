# Dependencies
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out
build
dist
**/dist
**/build
**/.next
**/out

# Turborepo cache (can be GBs of .tar.zst files — must never reach Docker)
.turbo
**/.turbo
*.tar.zst

# Graphify knowledge graph output (large JSON dumps)
graphify-out

# Local databases / storage
storage
*.db
*.db-wal
*.db-shm

# Build artifacts / reports (not needed in images)
*.tsbuildinfo
*.eslintcache
nestjs-doctor-report.html
dead-code-audit-report.md
ts-output.txt
test.txt

# Environment files
# The BARE `.env` too: it holds real secrets (AUTH_SECRET, DB credentials) and
# the build context is the repository root, so any `COPY . .` would bake it into
# an image layer. Only the `.local`/`.development.local` variants were ignored
# before, which left the actual `.env` readable inside every built image.
.env
.env.*
!.env.example

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.github

# Docker
.dockerignore
Dockerfile*
docker-compose*.yml

# Testing
coverage
.nyc_output
**/__tests__
vitest.config.*

# Docs & examples (not needed for production images)
docs
README.md
CHANGELOG.md

# Developer tooling / experiments (exclude from prod context)
_experiment
bun-preload-script
test-url.js

# Logs
# Log FILES only. A bare `logs` entry used to sit here and it matches ANY path
# component named `logs` — including real route directories such as
# apps/web/src/app/dashboard/**/logs/ and .../docker/logs/. Those pages were
# therefore excluded from the build context AND from `docker compose watch`
# sync, so edits to them silently never reached the dev container.
*.log

# Cache directories
.cache
.parcel-cache

# Temporary files
.tmp
.temp

# Project specific
analyze/