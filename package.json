    "scripts": {
        "dev": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml",
        "dev:filter": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml --require-profile",
        "dev:down": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml down",
        "dev:logs": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml logs -f",
        "dev:ps": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml ps",
        "dev:supervised": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml",
        "dev:supervised:filter": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml --require-profile",
        "dev:supervised:down": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml down",
        "dev:supervised:logs": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml logs -f",
        "dev:supervised:ps": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml ps",
        "dev:down:volumes": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml down --volumes",
        "dev:bff:logs": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev.yml logs -f bff",
        "dev:bff:run": "envcli docker exec -it ${COMPOSE_PROJECT_NAME:-nextjs-nestjs}-bff-dev /bin/sh",
        "dev:supervised:build": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.services.dev-supervised.yml build",
        "dev:supervised:reset": "bash scripts/reset-supervised.sh",
        "dev:dep-builder:run": "envcli docker exec -it ${COMPOSE_PROJECT_NAME:-nextjs-nestjs}-dependency-builder-dev /bin/sh",
        "dev:local": "turbo dev",
        "dev:web:run": "envcli docker exec -it ${COMPOSE_PROJECT_NAME:-nextjs-directus}-web-dev /bin/sh",
        "test:build": "bun packages/config/env/src/cli.ts mock --command 'bun run build'",
        "postinstall": "bun --bun run scripts/link-workspace-self-references.ts",
        "build": "turbo build",
        "build:types": "turbo run build:types",
        "watch:types": "turbo watch build:types",
        "compile": "bun packages/config/env/src/cli.ts mock --command 'turbo compile'",
        "local:build": "bun packages/config/env/src/cli.ts mock --command 'turbo build'",
        "check-env": "bun packages/config/env/src/cli.ts check",
        "check-env:api": "bun packages/config/env/src/cli.ts check api",
        "check-env:web": "bun packages/config/env/src/cli.ts check web",
        "check-env:doc": "bun packages/config/env/src/cli.ts check doc",
        "deploy:doc:s3": "bun --bun scripts/deploy-doc-s3.ts",
        "check:swarm:cli-lock": "bash scripts/check-swarm-cli-lock.sh",
        "start": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml down && dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml up --build",
        "start:local": "turbo start",
        "test": "turbo test",
        "test:watch": "turbo test:watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "coverage:report": "mkdir -p coverage && nyc report --temp-dir coverage --report-dir coverage/report --reporter=html --reporter=text --reporter=lcov && echo \"\\n\ud83d\udcca Merged coverage report generated at: coverage/report/index.html\"",
        "type-check": "turbo type-check",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "lint:fix+": "turbo lint:fix+",
        "format": "turbo prettify",
        "format:check": "turbo format:check",
        "clean": "turbo clean && rimraf --glob './**/.turbo'",
        "clear:cache": "rimraf --glob '**/.turbo' '.turbo'",
        "init": "bun --bun scripts/init.ts",
        "diagnose": "bun --bun scripts/diagnose-build.ts",
        "add:template": "bun --bun scripts/add-upstream.ts",
        "merge:template": "bun run add:template && git fetch template && git merge template/main --allow-unrelated-histories",
        "generate": "turbo generate",
        "generate:directus:types": "turbo run generate:directus:types",
        "docker:dev": "bun --bun run dev",
        "docker:prod": "bun --bun run start",
        "docker:build": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml build",
        "docker:build:web": "docker build -f infra/docker/builder/web/Dockerfile.web.build-time.prod --secret id=turbo_token,env=TURBO_TOKEN --secret id=turbo_team,env=TURBO_TEAM --secret id=turbo_api,env=TURBO_API . -t nextjs-directus-web:latest",
        "docker:build:bff": "docker build -f infra/docker/builder/api/Dockerfile.api.prod --build-arg PRUNE_SCOPE=@deployer/bff --build-arg APP_DIR=apps/api/bff --build-arg APP_PORT=3005 --secret id=turbo_token,env=TURBO_TOKEN --secret id=turbo_team,env=TURBO_TEAM --secret id=turbo_api,env=TURBO_API . -t deployer-bff:latest",
        "docker:build:scanner-runner": "docker build -t deployer-scanner-runner:latest -f infra/docker/scanner-runner/Dockerfile infra/docker/scanner-runner/",
        "docker:cleanup:cache": "docker builder prune -f",
        "docker:cleanup:all": "docker system prune -a -f",
        "docker:size": "docker system df",
        "docker:images": "docker images --format \"table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}\\t{{.CreatedAt}}\"",
        "prod": "dotenv -e .env -- bun scripts/compose.ts --file docker-compose.prod.yml up --build",
        "prod:new": "dotenv -e .env -- bun scripts/compose.ts --file docker-compose.prod.yml up --build --force-recreate",
        "prod:down": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml down",
        "prod:down:volumes": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml down --volumes",
        "prod:api": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml logs -f setup-prod",
        "prod:api:build": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml build build-svc-bff build-svc-health build-svc-identity build-svc-project build-svc-fleet build-svc-runtime",
        "prod:api:new": "dotenv -e .env -- bun scripts/compose.ts --file docker-compose.prod.yml up --build --force-recreate setup-prod",
        "prod:api:down": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml stop setup-prod",
        "prod:api:down:volumes": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml rm -f -v setup-prod",
        "prod:web": "dotenv -e .env -- bun scripts/compose.ts --file docker-compose.prod.yml up web-prod",
        "prod:web:build": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml build web-prod",
        "prod:web:new": "dotenv -e .env -- bun scripts/compose.ts --file docker-compose.prod.yml up --build web-prod",
        "prod:web:down": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml stop web-prod",
        "prod:web:down:volumes": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml rm -f -v web-prod",
        "prod:logs:api": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml logs -f setup-prod",
        "prod:logs:web": "dotenv -e .env -e .env.local -- bun scripts/compose.ts --file docker-compose.prod.yml logs -f web-prod",
        "prod:web:run": "envcli docker exec -it ${COMPOSE_PROJECT_NAME:-nextjs-directus}-web-prod /bin/sh",
        "kill:api": "trycli-options --command \"envcli kill-port $:{NEXT_PUBLIC_API_PORT} && envcli wait-on $:{NEXT_PUBLIC_API_URL} -r\" --silent",
        "@deployer/web": "dotenv -e .env -- bun --bun --cwd=./apps/web run --",
        "@deployer/setup": "dotenv -e .env -- bun --bun --cwd=./apps/setup run --",
        ".": "dotenv -e .env -- bun --bun --cwd=./ run --",
        "rm:node_modules": "bun --bun x rimraf --glob ./**/node_modules",
        "check": "bun x turbo run compile lint test type-check --continue",
        "knip": "knip",
        "knip:fix": "knip --fix",
        "knip:production": "knip --production",
        "knip:watch": "knip --watch",
        "knip:explain": "knip --include",
        " ": " ",
        "check:di-graph": "bun --bun scripts/check-di-graph.ts",
        "check:di-imports": "bun --bun scripts/check-di-imports.ts",
        "check:di-graph:cycles": "DI_GATE=cycles bun --bun scripts/check-di-graph.ts",
        "@deployer/ui": "dotenv -e .env -- bun --bun --cwd=./packages/ui/base run --",
        "@deployer/auth": "dotenv -e .env -- bun --bun --cwd=./packages/auth run --",
        "@deployer/config-typescript": "dotenv -e .env -- bun --bun --cwd=./tooling/typescript run --",
        "@deployer/config-tailwind": "dotenv -e .env -- bun --bun --cwd=./tooling/tailwind run --",
        "@deployer/config-eslint": "dotenv -e .env -- bun --bun --cwd=./tooling/eslint run --",
        "@deployer/cli-declarative-routing": "dotenv -e .env -- bun --bun --cwd=./tooling/bin-declarative-routing run --"
    },
    "devDependencies": {
        "@deployer/config-vitest": "*",
        "@deployer/env": "*",
        "@n0safe/envcli": "^1.0.2",
        "@n0safe/rununtil": "^1.0.5",
        "@n0safe/trycli": "^1.0.4",
        "@tsc-rs/linux-x64": "0.6.0",
        "@types/bun": "catalog:build",
        "@vitest/coverage-v8": "catalog:testing",
        "concurrently": "catalog:dev",
        "cross-env": "^10.1.0",
        "dotenv-cli": "catalog:dev",
        "knip": "^6.17.1",
        "nyc": "^18.0.0",
        "rimraf": "catalog:build",
        "turbo": "^2.11.3",
        "vite": "catalog:build",
        "vitest": "catalog:testing"
    },
    "engines": {
        "bun": ">=1.4.3"
    },
    "packageManager": "bun@1.4.3",
    "peerDependencies": {},
    "dependencies": {
        "detect-libc": "^2.1.2",
        "systeminformation": "^5.31.9"
    }
}
