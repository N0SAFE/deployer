# syntax=docker/dockerfile:1-labs
# Production Dockerfile for Doc App - BUILD-TIME COMPILATION
# This version builds the Next.js doc app during Docker build phase
# Recommended for: Render, Vercel, and platforms that scan for open ports during build
# Multi-stage build optimized for caching:
# base -> pruner-json -> pruner-full -> installer -> builder -> runner
#
# The pruner is split in two stages: pruner-json handles only manifests
# (super-stable cache) and pruner-full bind-mounts sources to produce out/full/.

# ===================================
# Stage 1: Base - Install global dependencies and set environment
# ===================================
FROM oven/bun:1.4.2-alpine AS base
ENV NODE_ENV=production

# Set build-time environment variables for Next.js
ARG API_URL=http://localhost:3001
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG API_PORT=3001
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_PORT=3000
ARG NEXT_PUBLIC_DOC_URL=http://localhost:3020
ARG NEXT_PUBLIC_DOC_PORT=3020
ARG AUTH_SECRET=QgafJQw3O/k1gambz7YGKjtj5ZZe0dnL/WlSw4PtMDc=

ENV API_URL=$API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_PORT=$API_PORT
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_PORT=$NEXT_PUBLIC_APP_PORT
ENV NEXT_PUBLIC_DOC_URL=$NEXT_PUBLIC_DOC_URL
ENV NEXT_PUBLIC_DOC_PORT=$NEXT_PUBLIC_DOC_PORT
ENV AUTH_SECRET=$AUTH_SECRET

# Install system dependencies
# jq is needed to parse package.json exports in runner stage
RUN apk add --no-cache libc6-compat dumb-init tar jq

# Install global tools with cache mount
RUN --mount=type=cache,target=/root/.bun/install/cache bun install -g turbo@^2 node-gyp
WORKDIR /app

# ===================================
# Stage 2a: pruner-json — manifests only (very stable cache)
# ===================================
FROM base AS pruner-json
WORKDIR /app

COPY turbo.json package.json ./
COPY bun.lock* ./
COPY --parents **/package.json ./

RUN --mount=type=cache,target=/root/.cache/turbo \
  turbo prune doc --docker

# Inject source.config.ts into out/json/ so the installer stage picks it
# up via `COPY --from=pruner-json /app/out/json/ .` without an extra
# build-context COPY. fumadocs-mdx postinstall needs this file to exist.
COPY apps/doc/source.config.ts /app/out/json/apps/doc/source.config.ts

# ===================================
# Stage 2b: pruner-full — sources via bind mount
# ===================================
FROM base AS pruner-full
WORKDIR /app

COPY --from=pruner-json /app/out/json/ ./

RUN --mount=type=bind,target=/src \
  --mount=type=cache,target=/root/.cache/turbo \
  cp /src/turbo.json . && \
  cp /src/bun.lock* . 2>/dev/null || true ; \
  tar -C /src -cf - apps packages 2>/dev/null | tar -xf - 2>/dev/null || true ; \
  turbo prune doc --docker

# ===================================
# Stage 3: Installer - Install dependencies from pruned lockfile
# ===================================
FROM base AS installer
WORKDIR /app

# Install build tools (python3/make/g++/musl-dev) required by bun ci to
# extract optional native dependencies like ssh2 -> cpu-features.
# Without these, optional deps are installed as empty stub directories
# (Bun does not run native postinstall scripts on Alpine without them).
# BuildKit cache mount keeps the apk package cache across builds.
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache python3 make g++ gcc musl-dev

# Install build tools needed for native dependencies
RUN apk add --no-cache python3 make g++ gcc musl-dev

COPY --from=pruner-json /app/out/json/ .
# out/json/ contains a consistent pruned bun.lock — use that one.

RUN --mount=type=cache,target=/root/.bun/install/cache \
  bun ci

# ===================================
# Stage 4: Builder - Build the application (generate + build)
# ===================================
FROM base AS builder
WORKDIR /app

# Install build tools needed for native dependencies
RUN apk add --no-cache python3 make g++ gcc musl-dev

# Pruned source from pruner-full (out/full/) — local image-to-image COPY
# out/full/ contains the pruned bun.lock at the root (consistent).
COPY --from=pruner-full /app/out/full/ .
# Copy the pruned bun.lock (from out/json/) so turbo can parse workspace
# info. out/full/ doesn't include a bun.lock at the root.
COPY --from=pruner-full /app/out/json/bun.lock ./bun.lock

# Copy node_modules from installer — single-tar pattern
# (one tar -cf + one tar -xf, no find/subshell loops, excludes *.map/.cache/.turbo)
#
# IMPORTANT: `cd /mnt/installer` MUST happen BEFORE the globs are expanded.
# The globs `apps/*/node_modules` etc. are expanded by the shell relative to
# the current working directory. If they run from /app (the runner's dir), they
# only match node_modules dirs that already exist in the pruned source — and
# apps/<app>/node_modules is NOT part of the source, so it would be silently
# skipped and never copied, breaking module resolution at runtime.
RUN --mount=type=bind,from=installer,source=/app,target=/mnt/installer \
    cd /mnt/installer && \
    PATHS="node_modules"; \
    for d in apps/*/node_modules packages/*/node_modules packages/*/*/node_modules; do \
        if [ -d "$d" ]; then PATHS="$PATHS $d"; fi; \
    done && \
    tar -cf - --exclude='*.map' --exclude='.cache' --exclude='.turbo' $PATHS | \
    tar -xf - -C /app --owner=root --group=root

# Copy turbo cache directories (workspace-level only; root /.turbo doesn't exist)
COPY --parents --chmod=a+w **/.turbo/ ./

# Run fumadocs-mdx postinstall to generate .source files
# (postinstall didn't run in installer stage because source.config.ts path was
#  outside out/json/ — now that we use out/full/ instead, this step is a safety net
#  for cases where the postinstall needs to be re-run after the source is updated.)
RUN cd apps/doc && bun run postinstall

# Generate routes
RUN --mount=type=cache,target=/root/.bun/install/cache \
    --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/tmp/turbo-restore,id=turbo-doc-prod-generate,sharing=locked \
    set -eux; \
    if [ -d /tmp/turbo-restore/wt ]; then \
      cp -an /tmp/turbo-restore/wt/. /app/ 2>/dev/null || true; \
    fi; \
    bunx turbo run generate --filter=doc... --remote-only; \
    rm -rf /tmp/turbo-restore/wt; \
    mkdir -p /tmp/turbo-restore/wt; \
    cd /app; \
    find . -path ./node_modules -prune -o -name .turbo -type d -print0 | \
      while IFS= read -r -d '' d; do \
        parent=$(dirname "$d"); \
        mkdir -p "/tmp/turbo-restore/wt/$parent"; \
        cp -r "$d" "/tmp/turbo-restore/wt/$parent/"; \
      done

# Build the doc app
RUN --mount=type=cache,target=/root/.bun/install/cache \
    --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/tmp/turbo-restore,id=turbo-doc-prod-build,sharing=locked \
    set -eux; \
    if [ -d /tmp/turbo-restore/wt ]; then \
      cp -an /tmp/turbo-restore/wt/. /app/ 2>/dev/null || true; \
    fi; \
    bunx turbo run build --filter=doc... --remote-only; \
    rm -rf /tmp/turbo-restore/wt; \
    mkdir -p /tmp/turbo-restore/wt; \
    cd /app; \
    find . -path ./node_modules -prune -o -name .turbo -type d -print0 | \
      while IFS= read -r -d '' d; do \
        parent=$(dirname "$d"); \
        mkdir -p "/tmp/turbo-restore/wt/$parent"; \
        cp -r "$d" "/tmp/turbo-restore/wt/$parent/"; \
      done

# ===================================
# Stage 6: Runner - Production runtime
# ===================================
FROM base AS runner

# Install Node.js and create user in single layer (no build tools in production)
RUN apk add --no-cache nodejs && \
    ln -sf $(which bun) /usr/local/bin/npm && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
ENV PATH="/usr/bin:${PATH}"

# Copy only what's needed to run Next.js:
# - Root workspace files
COPY --from=builder --chown=nextjs:nodejs /app/package.json /app/turbo.json ./
# - Built doc app (.next + public + package.json + config + generated content)
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/.next ./apps/doc/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/public ./apps/doc/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/package.json ./apps/doc/
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/next.config.ts ./apps/doc/
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/source.config.ts ./apps/doc/
# - Fumadocs generated source and content directories (required at runtime)
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/.source ./apps/doc/.source
COPY --from=builder --chown=nextjs:nodejs /app/apps/doc/content ./apps/doc/content
# - Built packages (directories determined by parsing package.json exports)
RUN --mount=type=bind,from=builder,source=/app,target=/mnt/builder \
    cd /mnt/builder && \
    for pkgDir in packages/* packages/*/*; do \
        pkgJson="$pkgDir/package.json"; \
        if [ -f "$pkgJson" ]; then \
            mkdir -p "/app/$pkgDir"; \
            cp "$pkgJson" "/app/$pkgDir/"; \
            exportDirs=$(jq -r '.exports // {} | if type == "string" then . elif type == "object" then [.. | strings] | .[] else empty end' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            mainDirs=$(jq -r '[.main, .module, .types] | .[] // empty' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            allDirs=$(echo -e "$exportDirs\n$mainDirs" | grep -v '^$' | sort -u); \
            for dir in $allDirs; do \
                if [ -d "$pkgDir/$dir" ]; then \
                    cp -r "$pkgDir/$dir" "/app/$pkgDir/"; \
                fi; \
            done; \
            if [ -f "$pkgDir/tsconfig.json" ]; then \
                cp "$pkgDir/tsconfig.json" "/app/$pkgDir/"; \
            fi; \
        fi; \
    done && \
    # Single-tar pattern for all node_modules (root + apps + packages)
    # Preserves symlinks via tar; excludes *.map/.cache/.turbo noise
    # Build the path list first so we use ONE tar -cf (concatenated multi-tar
    # streams lose per-package symlinks during extraction)
    # IMPORTANT: `cd /mnt/builder` MUST happen BEFORE the globs are expanded.
    # The globs `apps/*/node_modules` etc. are expanded by the shell relative to
    # the current working directory. If they run from /app (the runner's dir),
    # they only match node_modules dirs that already exist in the pruned source
    # — and apps/<app>/node_modules is NOT part of the source, so it would be
    # silently skipped and never copied, breaking module resolution at runtime.
    cd /mnt/builder && \
    PATHS="node_modules"; \
    for d in apps/*/node_modules packages/*/node_modules packages/*/*/node_modules; do \
        if [ -d "$d" ]; then PATHS="$PATHS $d"; fi; \
    done && \
    tar -cf - --exclude='*.map' --exclude='.cache' --exclude='.turbo' $PATHS | \
    tar -xf - -C /app --owner=root --group=root && \
    chown -R nextjs:nodejs /app/packages

# Prune devDependencies from node_modules for the final production image.
# We installed ALL deps (dev + prod) in the installer stage so the builder
# could compile TypeScript. Now that the build is done, remove devDeps
# (type defs, build tools, test runners, etc.) to keep the image minimal
# and reduce attack surface. `bun pm prune` reads each workspace's
# package.json devDependencies and removes them from node_modules.
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production

# Switch to nextjs user
USER nextjs

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${NEXT_PUBLIC_APP_PORT}

# Health check for deployment platforms
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider ${NEXT_PUBLIC_APP_URL} || exit 1

WORKDIR /app
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "bun run --cwd=apps/doc start"]
