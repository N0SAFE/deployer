# syntax=docker/dockerfile:1-labs
# Development Dockerfile for the SETUP app.
# Multi-stage build optimized for caching:
# base -> pruner-json -> pruner-full -> installer -> runner
#
# ── WHY THIS FILE EXISTS WHEN `Dockerfile.api.dev` COULD BE REUSED ──────────
# The two apps have DIFFERENT dependency graphs, and the image is built from a
# PRUNED workspace: `turbo prune <app>` rewrites the manifests to that app's
# closure, so `bun ci` installs only what that app needs.
#
# Reusing the API's image therefore installs the API's closure, and the setup app
# cannot resolve its own imports from it. Measured: `turbo prune api` puts
# `reflect-metadata` in `apps/api/node_modules` and does NOT include the
# `apps/setup` workspace at all, so `bun --bun --watch src/main.ts` dies with
#   error: Cannot find package 'reflect-metadata' from '/app/apps/setup/src/main.ts'
# The container then stays "Up" on turbo's dependency watchers while its own app
# is dead, and the healthcheck reports `Connection refused` forever — a state
# that looks like a hang rather than a crash.
#
# In dev, setup reuses the API's IMAGE (same monorepo, same toolchain) but not
# its PRUNE. Keeping this file separate is what makes that possible, and it
# mirrors `Dockerfile.setup.prod` so the two agree on what the app needs.
#
# The `--filter=setup...` commands below are the other half of the same point:
# the setup workspace is in scope here, so turbo can build the packages it
# depends on and then the app itself.

# ===================================
# Stage 1: Base - System dependencies
# ===================================
FROM oven/bun:1.4.2-alpine AS base

# Install system dependencies in single layer
RUN apk add --no-cache curl wget bash git python3 make g++ tar libc6-compat

# Copy Node.js 22 installation from the Node.js image (binaries + libraries)
COPY --from=node:22-alpine /usr/local /usr/local

# Create symbolic links for Node.js
RUN ln -sf /usr/local/bin/node /usr/bin/node && \
    ln -sf /usr/local/bin/npm /usr/bin/npm && \
    ln -sf /usr/local/bin/npx /usr/bin/npx

# Install global tools with cache mount
RUN --mount=type=cache,target=/root/.bun,sharing=locked bun install -g turbo@^2 @nestjs/cli node-gyp

WORKDIR /app

# ===================================
# Stage 2a: Pruner JSON — manifests only (very stable cache)
# Input  : turbo.json + root package.json + bun.lock + **/package.json
# Output : out/json/  (pruned package.json structure)
# Cache  : invalidates ONLY when a manifest or lockfile changes
# ===================================
FROM base AS pruner-json
WORKDIR /app

# Root manifests (rarely change)
COPY turbo.json package.json ./

# bun.lock may be text or binary; copy whatever exists
COPY bun.lock* ./

# All package.json files across the monorepo (preserves directory structure)
COPY --parents **/package.json ./

# Produce the pruned dependency graph from manifests only.
# `setup`, not `api`: see the header for why this is the load-bearing difference.
RUN --mount=type=cache,target=/root/.bun,sharing=locked \
    bun x turbo prune setup --docker

# ===================================
# Stage 2b: Pruner Full — sources via bind mount
# Input  : out/json/ from pruner-json + bind-mounted build context (sources)
# Output : out/full/  (pruned source files)
# Cache  : bind mount is not in the cache key → only pruner-json output matters
# ===================================
FROM base AS pruner-full
WORKDIR /app

# Take the pruned package.json structure (cache key: pruner-json output)
COPY --from=pruner-json /app/out/json/ ./

# Bind-mount the build context to access source files at build time.
# The bind mount does NOT participate in cache key calculation, so source
# changes in unrelated apps don't invalidate this stage.
# We copy the source files into the current directory so turbo prune can
# find them — turbo prune reads from the CWD, not from the bind-mount path.
# (turbo prune will then filter to only the workspaces needed for the target app)
RUN --mount=type=bind,target=/src \
    --mount=type=cache,target=/root/.bun,sharing=locked \
    cp /src/turbo.json . && \
    cp /src/bun.lock* . 2>/dev/null || true ; \
    tar -C /src -cf - apps packages 2>/dev/null | tar -xf - 2>/dev/null || true ; \
    bun x turbo prune setup --docker

# ===================================
# Stage 3: Installer - Install dependencies for pruned workspaces only
# ===================================
FROM base AS installer
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy ONLY the pruned package.json structure (not all workspaces)
# out/json/ ALSO contains a pruned bun.lock (consistent with the pruned manifests)
# — we use that one instead of the original. The original bun.lock includes
# resolutions for workspaces that aren't in the pruned package.json, so
# `bun ci` would fail with "lockfile had changed" if we copied it.
# out/bun.lock (at the root of out/) is corrupted — see turborepo#10783.
COPY --from=pruner-json /app/out/json/ .

RUN --mount=type=cache,target=/root/.bun,sharing=locked \
    --mount=type=cache,target=/root/.cache,sharing=locked \
    bun ci

# ===================================
# Stage 4: Runner - Development runtime
# ===================================
FROM base AS runner
WORKDIR /app

# Create npm symlink to avoid "npm not found" warnings
RUN ln -sf $(which bun) /usr/local/bin/npm

# Set development environment
ENV NODE_ENV=development
ENV LOG_LEVEL=debug

# Pruned source from pruner-full (out/full/) — local image-to-image COPY,
# no build context transfer. out/full/ contains the pruned bun.lock at the
# root (consistent with the pruned package.json) — we use that one.
COPY --from=pruner-full /app/out/full/ .
# Copy the pruned bun.lock (from out/json/) so turbo can parse workspace
# info. out/full/ doesn't include a bun.lock at the root.
COPY --from=pruner-full /app/out/json/bun.lock ./bun.lock

# Copy node_modules from installer — single-tar pattern
# (one tar -cf + one tar -xf, no find/subshell loops, excludes *.map/.cache/.turbo)
#
# IMPORTANT: `cd /mnt/installer` MUST happen BEFORE the globs are expanded.
# The globs `apps/*/node_modules` etc. are expanded by the shell relative to
# the current working directory. If they run from /app (the runner's dir), they
# only match node_modules dirs that already exist in the pruned source — and
# apps/<app>/node_modules is NOT part of the source, so it would be silently
# skipped and never copied, breaking module resolution at runtime.
RUN --mount=type=bind,from=installer,source=/app,target=/mnt/installer \
    cd /mnt/installer && \
    PATHS="node_modules"; \
    for d in apps/*/node_modules packages/*/node_modules packages/*/*/node_modules; do \
        [ -d "$d" ] && PATHS="$PATHS $d"; \
    done && \
    tar -cf - --exclude='*.map' --exclude='.cache' --exclude='.turbo' $PATHS | \
    tar -xf - -C /app --owner=root --group=root

# Build the setup app's dependencies (the workspace packages it imports) ONCE,
# in the image. This is what removes the startup race: `turbo run dev` starts the
# app in PARALLEL with the package watchers, and `@repo/ui`'s `dist/` is empty
# until its watcher finishes its first build — so the app would die on
#   Cannot find module '@repo/ui/components/setup/setup-wizard'
# Building here means `dist/` already exists when the app starts.
#
# The watchers still run at container start (so edits are picked up); they simply
# have nothing to do for the first pass.
#
# `--filter=setup...` selects setup AND what it depends on; `--filter=!setup`
# excludes the app itself, whose `dev` task is the long-running watcher below.
RUN --mount=type=cache,target=/app/.turbo,sharing=locked,id=turbo-setup-dev \
    --mount=type=cache,target=/app/apps/setup/.turbo,sharing=locked,id=turbo-setup-dev \
    --mount=type=cache,target=/root/.bun,sharing=locked \
    bun x turbo run build --filter=setup... --filter=!setup

# Start the setup dev server at container runtime.
#
# ── WHY THE WATCHERS AND THE APP ARE STARTED SEPARATELY ──────────────────────
# `turbo run dev --filter=setup...` starts EVERY task in parallel, so the app
# boots at the same moment as the package watchers. That is not safe here:
# `pkg-build --watch` begins by DELETING the package's `dist/`
# (`fs.rmSync(distDir)`) and only then rebuilds it, so the app resolves imports
# against a briefly EMPTY directory:
#
#   setup:dev: error: Cannot find module '@repo/ui/components/setup/setup-wizard'
#             from '/app/apps/setup/src/views/pages/setup.tsx'
#
# Building the packages in the image does NOT help on its own — the watcher wipes
# that output the moment it starts. So the two are sequenced:
#
#   1. the package watchers, in the BACKGROUND  (they own the packages' dist/)
#   2. wait until EVERY internal dependency resolves (see the script)
#   3. the app itself, which then resolves against a complete tree
#
# ── FOUR things must run, and the ORDER of two of them is load-bearing ────────
#
#   1. the package watchers, in the BACKGROUND  (they own the packages' dist/)
#   2. wait until every imported package resolves
#   3. the Vite dev server, in the BACKGROUND   (the wizard's client bundle)
#   4. the Nest server, in the FOREGROUND        (the container's exit code)
#
# ── WHY THE WAIT IS A SCRIPT AND NOT AN INLINE TEST ──────────────────────────
# Three inline attempts failed before it, each measuring something that was not
# the invariant:
#   1. `[ -f .../setup-wizard.mjs ]` tested FILE EXISTENCE — and the image had
#      already built that file, so it passed instantly and waited for nothing.
#   2. `Bun.resolveSync` on ONE package was real, but the packages rebuild in
#      PARALLEL and finish at different times, so `@repo/ui` being ready said
#      nothing about `@repo/orpc-utils` — the next import to be evaluated died.
#   3. Every `@repo/*` DEPENDENCY included config-only packages
#      (`@repo/config-typescript`) that have no `exports` and can never resolve,
#      so it would have timed out on something never meant to be imported.
#
# `wait-for-workspace-packages.ts` scans the app's SOURCE for the `@repo/*`
# specifiers it actually imports and requires all of them to resolve, twice in a
# row so no watcher can still be mid-wipe. Verified both ways in the built image:
# with a package's `dist/` hidden it blocks and names it; restored, it passes.
COPY --chmod=755 docker/builder/setup/wait-for-workspace-packages.ts /usr/local/bin/wait-for-workspace-packages

# ── WHY VITE IS A SECOND PROCESS ─────────────────────────────────────────────
# Steps 3 and 4 are separate, exactly as the API does it
# (`apps/api/scripts/entrypoint.dev.ts` spawns `dev:vite` then starts Nest). The
# setup app needs the same: its SSR wizard emits `/vite/@vite/client` and friends,
# and `@repo/vite-assets` proxies that prefix to a Vite dev server on 5174. With
# nothing listening there the page renders as inert HTML — every asset 404s —
# which is precisely what `connect ECONNREFUSED 127.0.0.1:5174` in the proxy log
# reported.
#
# `dev:vite` runs `vite` with no flags: the port and base live in vite.config.ts
# (5174, `/vite/`), which is where they belong — a second copy on this line could
# drift from the config the base is compiled into.
#
# Nest runs LAST and in the FOREGROUND, because the container's exit code is the
# health of the SERVER. Backgrounding Nest instead would make every crash look
# like a successful run.
CMD ["sh", "-c", "bun x turbo run dev --filter=setup... --filter=!setup & bun /usr/local/bin/wait-for-workspace-packages /app/apps/setup && cd /app/apps/setup && (bun x dotenv -e /app/.env -- bun run dev:vite &) && bun x dotenv -e /app/.env -- bun --bun --watch src/main.ts"]
