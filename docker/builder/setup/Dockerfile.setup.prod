# syntax=docker/dockerfile:1-labs
# Production Dockerfile for the SETUP app.
#
# WHY A SEPARATE IMAGE AND NOT THE API'S WITH A DIFFERENT CMD
# The setup app is PRE-AUTH: it runs before any user or session exists, and it is
# reachable on the platform's own hostname during onboarding. The API's runtime
# image carries the entire product surface (every feature module, the ORPC
# router, the SSR views, the drizzle migrations). Shipping all of that behind a
# pre-auth entry point is strictly more exposure than the job requires, and it
# also makes "what does setup actually need?" unanswerable by looking at the
# image.
#
# `turbo prune setup` is what makes the separation real: it resolves SETUP's
# dependency graph, so the pruned workspace genuinely differs from the API's.
#
# Structure mirrors docker/builder/api/Dockerfile.api.prod deliberately —
# same stages, same cache strategy, same node_modules handling — so the two
# images are reviewed and debugged the same way.

# ===================================
# Stage 1: Base
# ===================================
FROM oven/bun:1.4.2-alpine AS base
ENV NODE_ENV=production

# jq is needed to parse package.json exports in the runner stage; wget is the
# compose healthcheck's probe (Terminus returns a real status code, so a plain
# --spider is correct and no grep wrapper is needed).
RUN apk add --no-cache libc6-compat tar jq wget
RUN --mount=type=cache,target=/root/.bun/install/cache bun install -g turbo@^2
WORKDIR /app

# ===================================
# Stage 2a: pruner-json — manifests only (very stable cache)
# ===================================
FROM base AS pruner-json
WORKDIR /app

COPY turbo.json package.json ./
COPY bun.lock* ./
COPY --parents **/package.json ./

RUN --mount=type=cache,target=/root/.cache/turbo \
  turbo prune setup --docker

# ===================================
# Stage 2b: pruner-full — sources via bind mount
# ===================================
FROM base AS pruner-full
WORKDIR /app

COPY --from=pruner-json /app/out/json/ ./

RUN --mount=type=bind,target=/src \
  --mount=type=cache,target=/root/.cache/turbo \
  cp /src/turbo.json . && \
  cp /src/bun.lock* . 2>/dev/null || true ; \
  tar -C /src -cf - apps packages 2>/dev/null | tar -xf - 2>/dev/null || true ; \
  turbo prune setup --docker

# ===================================
# Stage 3: Installer
# ===================================
FROM base AS installer
WORKDIR /app

# Build tools for optional native dependencies (see the API's Dockerfile: bun
# does not run native postinstall scripts on Alpine without them, leaving empty
# stub directories behind).
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache python3 make g++ gcc musl-dev

COPY --from=pruner-json /app/out/json/ .

RUN --mount=type=cache,target=/root/.bun/install/cache \
  bun ci

# ===================================
# Stage 4: Builder
# ===================================
FROM base AS builder
WORKDIR /app

RUN apk add --no-cache python3 make g++ gcc musl-dev

COPY --from=pruner-full /app/out/full/ .
COPY --from=pruner-full /app/out/json/bun.lock ./bun.lock

# node_modules from the installer. `cd /mnt/installer` MUST happen before the
# globs expand — from /app they would only match directories already present in
# the pruned source, silently skipping `apps/setup/node_modules`.
RUN --mount=type=bind,from=installer,source=/app,target=/mnt/installer \
    cd /mnt/installer && \
    PATHS="node_modules"; \
    for d in apps/*/node_modules packages/*/node_modules packages/*/*/node_modules; do \
        if [ -d "$d" ]; then PATHS="$PATHS $d"; fi; \
    done && \
    tar -cf - --exclude='*.map' --exclude='.cache' --exclude='.turbo' $PATHS | \
    tar -xf - -C /app --owner=root --group=root

COPY --parents --chmod=a+w **/.turbo/ ./

# Build setup AND its workspace dependencies. `--filter=setup...` is required:
# the app imports workspace packages whose `dist/` must exist before Nest
# resolves them, and a bare `--filter=setup` would skip the packages it depends
# on. The build itself runs `scripts/build.ts`, which bundles the two entry
# points AND executes `dist/compile.js` — so a Nest graph that cannot assemble
# fails the IMAGE BUILD rather than the container start.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    --mount=type=cache,target=/root/.cache \
    bunx turbo run build --filter=setup...

# ===================================
# Stage 5: Runner
# ===================================
FROM base AS runner
WORKDIR /app

RUN apk add --no-cache curl wget bash coreutils

# Root is required, not a concession: setup drives the docker socket to found
# the swarm and schedule the API service, which needs daemon access. Granting
# that to a non-root user would mean adding it to the docker group — the same
# privilege by a different name. The container publishes NO host port, so this
# is not reachable from outside the platform network.
RUN --mount=type=bind,from=builder,source=/app,target=/mnt/builder \
    cp /mnt/builder/package.json /mnt/builder/turbo.json /app/ && \
    # The setup app: entry points (dist/main.js, dist/compile.js) + the Vite SSR
    # bundles. No drizzle migrations, no uploads — setup touches neither.
    mkdir -p /app/apps/setup && \
    cp -r /mnt/builder/apps/setup/dist /app/apps/setup/ && \
    cp /mnt/builder/apps/setup/package.json /app/apps/setup/ && \
    # Packages: copy only the directories each package.json actually exports.
    for pkgJson in /mnt/builder/packages/*/package.json /mnt/builder/packages/*/*/package.json /mnt/builder/packages/*/*/*/package.json /mnt/builder/packages/*/*/*/*/package.json; do \
        if [ -f "$pkgJson" ]; then \
            pkgDir=$(dirname "$pkgJson"); \
            relPkgDir=$(echo "$pkgDir" | sed 's|/mnt/builder/||'); \
            mkdir -p "/app/$relPkgDir"; \
            cp "$pkgJson" "/app/$relPkgDir/"; \
            exportDirs=$(jq -r '.exports // {} | if type == "string" then . elif type == "object" then [.. | strings] | .[] else empty end' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            mainDirs=$(jq -r '[.main, .module, .types] | .[] // empty' "$pkgJson" 2>/dev/null | grep -oE '^\./[^/]+' | sed 's|^\./||' | sort -u); \
            allDirs=$(printf '%s\n%s' "$exportDirs" "$mainDirs" | grep -v '^$' | sort -u); \
            for dir in $allDirs; do \
                if [ -d "$pkgDir/$dir" ]; then \
                    cp -r "$pkgDir/$dir" "/app/$relPkgDir/"; \
                elif [ -f "$pkgDir/$dir" ]; then \
                    cp "$pkgDir/$dir" "/app/$relPkgDir/"; \
                fi; \
            done; \
            [ -f "$pkgDir/tsconfig.json" ] && cp "$pkgDir/tsconfig.json" "/app/$relPkgDir/" || true; \
        fi; \
    done && \
    # node_modules: per-dir merge, not one tar. Nested workspaces can appear in
    # several PATHS entries and a plain tar extract aborts on such overlaps.
    cd /mnt/builder && \
    PATHS="node_modules"; \
    for d in apps/*/node_modules packages/*/node_modules packages/*/*/node_modules; do \
        if [ -d "$d" ]; then PATHS="$PATHS $d"; fi; \
    done && \
    for d in $PATHS; do \
        mkdir -p "/app/$d"; \
        cp -a "/mnt/builder/$d/." "/app/$d/" 2>/dev/null || { \
            rm -rf "/app/$d"; \
            mkdir -p "/app/$d"; \
            cp -a "/mnt/builder/$d/." "/app/$d/"; \
        }; \
    done

# Drop devDependencies now that the build is done.
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production

# /app/data holds the SHARED SQLite file (setup writes the swarm participation
# decision and the database URL; the API reads them), and /app/traefik-configs
# is the shared Traefik file-provider directory. Both are named volumes, and
# Docker seeds a fresh one with the IMAGE's ownership — so they must exist and
# be writable here, or the first `docker compose up` fails on a permission
# error that looks like a compose misconfiguration.
RUN mkdir -p /app/data /app/traefik-configs && chmod 777 /app/data /app/traefik-configs

# NO EXPOSE and NO published port, deliberately. Setup is reached exclusively
# through Traefik over the platform network; publishing the pre-auth wizard on
# every host interface would be an unnecessary attack surface for a service
# whose entire purpose is to be replaced.
#
# The healthcheck lives in compose (it is the GATE the profile depends on), not
# here: `docker inspect` on a swarm task would report the API's health, and the
# compose healthcheck is the one that carries the semantics.

CMD ["bun", "--bun", "--cwd=apps/setup", "run", "start:prod"]
