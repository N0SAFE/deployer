# System Configuration (not exported to .env)
SYSTEM_ENV_TEMPLATE_CONFIG={{json|skip_export=true|default={"groups":[{"id":"project","name":"Project","description":"Basic project configuration"},{"id":"api","name":"API","description":"Backend API configuration"},{"id":"web","name":"Web Application","description":"Frontend web app configuration"},{"id":"database","name":"Database","description":"Database connection and credentials"},{"id":"auth","name":"Authentication","description":"Authentication and security settings"},{"id":"traefik","name":"Traefik","description":"Reverse proxy and domain management"},{"id":"environment","name":"Environment","description":"Environment-specific settings"},{"id":"development","name":"Development","description":"Development tools and features"}]}}}

# Project Configuration
COMPOSE_PROJECT_NAME={{string|group=project|default=nextjs-nestjs|label=Project Name|description=Unique name for Docker containers to avoid conflicts}}

# API Configuration  
NEXT_PUBLIC_API_URL={{url|group=api|protocol=http,https|label=API URL|description=URL where the NestJS API will be accessible|default=http://localhost:${3001 + $index * 10}}}
API_PORT={{number|group=api|min=1000|max=65535|allow=80,443|label=API Port|description=Port for the NestJS API service (auto-extracted if explicit port in URL, otherwise prompts with default)|transformer=extract_port|source=NEXT_PUBLIC_API_URL}}
API_PING_PATH={{string|group=api|default=/health|label=API Health Check Path|description=Path for API health checking}}
API_ADMIN_TOKEN={{string|group=api|transformer=generate_secret|length=32|label=Admin Token|description=Secret token for API administration}}
UPLOADS_DIR={{string|group=api|default=/app/apps/api/uploads|label=Uploads Directory|description=Absolute path to uploads directory in container|optional=true}}

# Web App Configuration
NEXT_PUBLIC_APP_URL={{url|group=web|protocol=http,https|label=Web App URL|description=URL where the Next.js app will be accessible|default=http://localhost:${3000 + $index * 10}}}
NEXT_PUBLIC_APP_PORT={{number|group=web|min=1000|max=65535|allow=80,443|label=Web App Port|description=Port for the Next.js web application (auto-extracted if explicit port in URL, otherwise prompts with default)|transformer=extract_port|source=NEXT_PUBLIC_APP_URL}}
NEXT_PUBLIC_DOC_URL={{url|group=web|protocol=http,https|label=Docs URL|description=URL where the documentation site is accessible (shows a Docs link in navbar when set)|default=http://localhost:${3020 + $index * 10}|optional=true}}
NEXT_PUBLIC_DOC_PORT={{number|group=web|min=1000|max=65535|allow=80,443|label=Docs Port|description=Port for the docs site (auto-extracted if explicit port in URL)|transformer=extract_port|source=NEXT_PUBLIC_DOC_URL|optional=true}}

# ========================================
# Database Configuration (Development)
# ========================================
# Note: DATABASE_URL is NEVER read at runtime. The URL flows through SQLite:
#   SETUP_DATABASE_URL env → Phase 0 (SetupDevService) → SQLite node_config
#                                                         → GlobalDatabaseModule
# Phase 0 is opt-in via SETUP_AUTO=true. If unset/false, the app starts without
# a database and you run the setup wizard manually via the web UI.
#
# SETUP_DATABASE_URL={{string|group=database|label=Setup Database URL|description=PostgreSQL connection URL for initial setup. Only read by Phase 0 setup sub-app.|optional=true}}
# SETUP_AUTO={{boolean|group=database|default=false|label=Auto-setup|description=When true, Phase 0 auto-configures the database (provision Postgres or persist URL from SETUP_DATABASE_URL)}}
#
# DB_DATABASE={{string|group=database|default=nestjs_api|label=Database Name|description=Name of the PostgreSQL database}}

# ========================================
# Compose-managed services (dev tier)
# ========================================
# In the dev compose stack the platform services are owned by Docker Compose:
# the API must NOT spawn/supervise them. ENABLED_MANAGED_SERVICE_*_ENABLED
# skips the matching supervisor; the MANAGED_SERVICE_*_* vars describe how to
# REACH the compose-managed service.
#
#ENABLED_MANAGED_SERVICE_GLOBAL_DB={{boolean|group=database|default=true|label=Compose-managed Global DB|description=When true, Docker Compose owns Postgres and the API never spawns/supervises it}}
#MANAGED_SERVICE_GLOBAL_DB_URL={{string|group=database|default=postgresql://deployer:deployer@global-db:5432/deployer|label=Managed Global DB URL|description=Connection URL of the compose-managed global Postgres|optional=true}}
#MANAGED_SERVICE_GLOBAL_DB_HOST={{string|group=database|default=global-db|label=Managed Global DB Host|description=Compose service name / alias of the global Postgres}}
#MANAGED_SERVICE_GLOBAL_DB_PORT={{number|group=database|default=5432|label=Managed Global DB Port}}
#MANAGED_SERVICE_GLOBAL_DB_USER={{string|group=database|default=deployer|label=Managed Global DB User}}
#MANAGED_SERVICE_GLOBAL_DB_PASSWORD={{string|group=database|transformer=generate_secret|length=16|label=Managed Global DB Password|secure=true}}
#MANAGED_SERVICE_GLOBAL_DB_NAME={{string|group=database|default=deployer|label=Managed Global DB Name}}
#
#ENABLED_MANAGED_SERVICE_REDIS={{boolean|group=database|default=true|label=Compose-managed Redis|description=When true, Docker Compose owns Redis and the API never spawns/supervises it}}
#MANAGED_SERVICE_REDIS_URL={{string|group=database|default=redis://redis:6379|label=Managed Redis URL|optional=true}}
#MANAGED_SERVICE_REDIS_HOST={{string|group=database|default=redis|label=Managed Redis Host}}
#MANAGED_SERVICE_REDIS_PORT={{number|group=database|default=6379|label=Managed Redis Port}}
#
#ENABLED_MANAGED_SERVICE_TAILSCALE={{boolean|group=database|default=false|label=Compose-managed Tailscale|description=When true, Docker Compose owns the per-node Tailscale sidecar}}
#MANAGED_SERVICE_TAILSCALE_HOSTNAME={{string|group=database|default=mesh-node-1|label=Tailscale Hostname|description=Unique tailnet hostname for this node}}
#MANAGED_SERVICE_TAILSCALE_AUTHKEY={{string|group=database|label=Tailscale Auth Key|description=TS_AUTHKEY used to join the tailnet|secure=true}}

# Authentication
AUTH_SECRET={{string|group=auth|transformer=generate_secret|length=32|label=Auth Secret|description=Secret key for Better Auth authentication|secure=true}}

# Default Admin User
DEFAULT_ADMIN_EMAIL={{string|group=auth|default=admin@admin.com|label=Default Admin Email|description=Email address for the default admin user created on first startup}}
DEFAULT_ADMIN_PASSWORD={{string|group=auth|default=adminadmin|label=Default Admin Password|description=Password for the default admin user (change in production!)|secure=true}}

DEV_AUTH_KEY={{string|group=development|transformer=generate_secret|length=32|label=Dev Auth Key|description=Secret key for development Bearer token authentication (impersonates DEFAULT_ADMIN_EMAIL user)|secure=true}}
NEXT_PUBLIC_DEV_AUTH_KEY={{string|group=development|transformer=copy|source=DEV_AUTH_KEY|label=Dev Auth Key (Public)|description=Copy of DEV_AUTH_KEY for client-side access in development|secure=true}}

# Environment Settings
NODE_ENV=development

# Development Features
ENABLE_DEV_BOOTSTRAP={{boolean|group=development|labels=enable,disable|default=enable|label=Dev Bootstrap|description=Enable default admin creation + db seeding at API dev startup (disable to test first-run setup flow)}}
MILLION_LINT={{boolean|group=development|labels=enable,disable|default=disable|label=Million Lint|description=Enable Million.js linting for React optimization}}
REACT_SCAN={{boolean|group=development|labels=enable,disable|default=disable|label=React Scan|description=Enable React component scanning for debugging}}
NEXT_PUBLIC_SHOW_AUTH_LOGS={{boolean|group=development|labels=yes,no|default=no|label=Show Auth Logs|description=Display authentication logs in development}}

# Debug Configuration
NEXT_PUBLIC_DEBUG={{string|group=development|optional=true|label=Debug Scopes|description=Comma-separated debug scopes (e.g., 'middleware/**', 'middleware/auth,middleware/env', 'middleware/{auth,env}/**'). Supports wildcards and brace expansion|placeholder=middleware/**}}

# Context-filtered Debug Logs (single variable)
APP_DEBUG_CONTEXT_FILTER={{string|group=development|optional=true|label=Context Debug Filter|description=Pattern filter for context-aware debug logs across API/services (supports class:/method:/source:/target: prefixes and glob-like matching)|placeholder=class:*Relay* method:observe}}
