{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"types": ["bun", "node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
